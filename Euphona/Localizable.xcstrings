    "coach_recorded_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجّل هذه الخطوة صوتك وتحلله، مثل تحليل الصوت. يُرجى إغلاق النتيجة بعد الاطلاع عليها للمتابعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest pas enregistra i analitza la teva veu, igual que Analitzar la veu. Quan hagis vist el resultat, tanca’l per continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento krok nahrává a analyzuje váš hlas, stejně jako Analyzovat hlas. Až výsledek uvidíte, zavřete ho a pokračujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette trin optager og analyserer din stemme, ligesom Analysér stemmen. Luk resultatet, når du har set det, for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schritt nimmt deine Stimme auf und analysiert sie, genau wie „Stimme analysieren“. Schließe das Ergebnis, wenn du es gesehen hast, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το βήμα ηχογραφεί και αναλύει τη φωνή σας, όπως η Ανάλυση φωνής. Κλείστε το αποτέλεσμα όταν το δείτε για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This step records and analyzes your voice, the same as Analyze Voice. Close the result when you’ve seen it to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este paso graba y analiza tu voz, igual que Analizar voz. Cuando hayas visto el resultado, ciérralo para continuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vaihe äänittää ja analysoi äänesi samoin kuin Analysoi ääni. Sulje tulos nähtyäsi sen, niin pääset jatkamaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette étape enregistre et analyse votre voix, comme Analyser la voix. Fermez le résultat quand vous l’avez vu pour continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השלב הזה מקליט ומנתח את הקול שלך, כמו ניתוח קול. אחרי שרואים את התוצאה, סוגרים אותה כדי להמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह चरण आपकी आवाज़ रिकॉर्ड करके उसका विश्लेषण करता है, ठीक “आवाज़ का विश्लेषण” की तरह। नतीजा देखने के बाद उसे बंद करें और आगे बढ़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj korak snima i analizira vaš glas, isto kao Analiziraj glas. Kad pogledate rezultat, zatvorite ga i nastavite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a lépés rögzíti és elemzi a hangodat, ugyanúgy, mint a Hang elemzése. Ha láttad az eredményt, zárd be, és folytasd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah ini merekam dan menganalisis suara Anda, sama seperti Analisis Suara. Tutup hasilnya setelah melihatnya untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo passo registra e analizza la tua voce, come Analizza voce. Quando hai visto il risultato, chiudilo per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このステップでは、「声を分析」と同じように声を録音して分析します。結果を確認したら閉じて、続けましょう。"
