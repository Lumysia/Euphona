        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practise again tomorrow to keep it going. On a tired day, a rest lesson counts too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica de nuevo mañana para mantener la racha. En un día de cansancio, una lección de descanso también cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittele huomennakin pitääksesi putken yllä. Väsyneenä päivänä lepoharjoituskin lasketaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous de nouveau demain pour continuer. Un jour de fatigue, une leçon de repos compte aussi."
