    "coach_ex_lip_trill_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل القشّة، يُبقي ارتجاج الشفتين الصوت خفيفًا ومدعومًا جيدًا بينما تسخن العضلات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com la palleta, la vibració de llavis manté la veu lleugera i ben sostinguda mentre els músculs s’escalfen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejně jako brčko udržuje vibrování rty hlas lehký a dobře podepřený, zatímco se svaly zahřívají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligesom sugerøret holder en læbetrille stemmen let og velstøttet, mens musklerne varmer op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie der Strohhalm hält Lippenflattern die Stimme leicht und gut getragen, während sich die Muskeln aufwärmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όπως το καλαμάκι, το τρέμουλο χειλιών κρατά τη φωνή ελαφριά και καλά στηριγμένη ενώ οι μύες ζεσταίνονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like the straw, a lip trill keeps the voice light and well supported while the muscles warm up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igual que la pajita, la vibración de labios mantiene la voz ligera y bien apoyada mientras los músculos entran en calor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pillin tavoin huulitrilli pitää äänen kevyenä ja hyvin tuettuna, kun lihakset lämpenevät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme la paille, la vibration des lèvres garde la voix légère et bien soutenue pendant que les muscles s’échauffent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמו הקשית, רטט שפתיים שומר על קול קל ומתומך היטב בזמן שהשרירים מתחממים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्ट्रॉ की तरह, लिप ट्रिल मांसपेशियों के गर्म होने के दौरान आवाज़ को हल्का और साँस के सहारे टिकाए रखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kao i slamka, titranje usana održava glas laganim i dobro poduprtim dok se mišići zagrijavaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szívószálhoz hasonlóan az ajaktrilla könnyűnek és jól megtámasztottnak tartja a hangot, miközben az izmok bemelegednek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti sedotan, getar bibir menjaga suara tetap ringan dan didukung napas dengan baik selagi otot menghangat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come la cannuccia, la vibrazione delle labbra mantiene la voce leggera e ben sostenuta mentre i muscoli si scaldano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストローと同じく、リップトリルは筋肉が温まるまで、声を軽く、しっかり支えられた状態に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨대와 마찬가지로, 입술 떨기는 근육이 풀리는 동안 목소리를 가볍고 안정적으로 지탱해 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti penyedut minuman, getaran bibir memastikan suara kekal ringan dan disokong nafas dengan baik semasa otot dipanaskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som sugerøret holder en leppetrill stemmen lett og godt støttet mens musklene varmes opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net als het rietje houdt een lippentrilling de stem licht en goed ondersteund terwijl de spieren warm worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak jak słomka, wibrowanie ustami utrzymuje głos lekkim i dobrze podpartym, gdy mięśnie się rozgrzewają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o canudo, a vibração de lábios mantém a voz leve e bem apoiada enquanto os músculos aquecem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca paiul, vibrația buzelor ține vocea ușoară și bine susținută în timp ce mușchii se încălzesc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как и трубочка, трель губами сохраняет голос лёгким и хорошо поддержанным, пока мышцы разогреваются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rovnako ako slamka, aj chvenie pier udržuje hlas ľahký a dobre podopretý, kým sa svaly zahrievajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tako kot slamica tudi trepetanje ustnic ohranja glas lahkoten in dobro podprt, medtem ko se mišice ogrevajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precis som sugröret håller en läpptrill rösten lätt och väl buren medan musklerna värms upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช่นเดียวกับหลอด การสั่นริมฝีปากช่วยให้เสียงเบาและมีลมรองรับดีขณะที่กล้ามเนื้อกำลังวอร์มอัป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipet gibi, dudak titreşimi kaslar ısınırken sesi hafif ve iyi desteklenmiş tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як і трубочка, трель губами зберігає голос легким і добре підтриманим, поки м’язи розігріваються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống như ống hút, rung môi giữ cho giọng nhẹ và được nâng đỡ tốt trong lúc các cơ khởi động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和吸管一样，唇颤音能让声音在肌肉热身时保持轻松、气息稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和吸管一樣，唇顫音能讓聲音在肌肉熱身時保持輕鬆、氣息穩定。"
          }
        }
      }
    },
    "coach_ex_pitch_count_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. العدّ ببطء من واحد إلى عشرين.\n2. إبقاء كل رقم داخل النطاق.\n3. ربط الأرقام قليلًا ببعضها كما في الكلام لا في الغناء.\n4. التنفّس بين كل مجموعة من خمسة أرقام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Compta lentament de l’u al vint.\n2. Mantén cada número dins de la franja.\n3. Uneix una mica els números, com quan parles, sense cantar.\n4. Respira entre grups de cinc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pomalu počítejte od jedné do dvaceti.\n2. Udržujte každé číslo uvnitř pásma.\n3. Čísla lehce propojujte jako v řeči, ne ve zpěvu.\n4. Mezi pětičlennými skupinami se nadechněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tæl langsomt fra en til tyve.\n2. Hold hvert tal inden for båndet.\n3. Bind tallene lidt sammen, som i tale og ikke som i sang.\n4. Træk vejret mellem grupper af fem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zähle langsam von eins bis zwanzig.\n2. Halte jede Zahl innerhalb des Bandes.\n3. Verbinde die Zahlen ein wenig, wie beim Sprechen, nicht wie beim Singen.\n4. Atme zwischen den Fünfergruppen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Μετρήστε αργά από το ένα ως το είκοσι.\n2. Κρατήστε κάθε αριθμό μέσα στη ζώνη.\n3. Συνδέστε λίγο τους αριθμούς, σαν ομιλία και όχι σαν τραγούδι.\n4. Αναπνεύστε ανάμεσα σε ομάδες των πέντε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Count slowly from one to twenty.\n2. Keep each number inside the band.\n3. Connect the numbers a little, like speech, not singing.\n4. Breathe between groups of five."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Cuenta despacio del uno al veinte.\n2. Mantén cada número dentro de la banda.\n3. Une un poco los números, como al hablar, sin cantar.\n4. Respira entre grupos de cinco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Laske hitaasti yhdestä kahteenkymmeneen.\n2. Pidä jokainen luku alueen sisällä.\n3. Liitä luvut hieman yhteen kuin puheessa, ei laulussa.\n4. Hengitä viiden luvun ryhmien välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Comptez lentement de un à vingt.\n2. Gardez chaque nombre dans la bande.\n3. Reliez un peu les nombres, comme à l’oral, sans chanter.\n4. Respirez entre les groupes de cinq."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לספור לאט מאחד עד עשרים.\n2. לשמור כל מספר בתוך הטווח.\n3. לחבר מעט בין המספרים, כמו בדיבור ולא כמו בשירה.\n4. לנשום בין קבוצות של חמישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. एक से बीस तक धीरे-धीरे गिनें।\n2. हर संख्या को दायरे के अंदर रखें।\n3. संख्याओं को थोड़ा जोड़ते हुए बोलें, बातचीत की तरह, गाने की तरह नहीं।\n4. पाँच-पाँच की टोली के बीच साँस लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Polako brojite od jedan do dvadeset.\n2. Svaki broj držite unutar pojasa.\n3. Brojeve malo povežite, kao u govoru, ne kao u pjevanju.\n4. Udahnite nakon svake skupine od pet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Számolj lassan egytől húszig.\n2. Minden számot tarts a sávon belül.\n3. Kösd össze kicsit a számokat, mint a beszédben, nem mint az éneklésben.\n4. Minden öt szám után végy levegőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hitung pelan dari satu sampai dua puluh.\n2. Jaga setiap angka tetap di dalam rentang.\n3. Sambungkan angka-angka sedikit, seperti berbicara, bukan bernyanyi.\n4. Tarik napas di antara kelompok lima angka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Conta lentamente da uno a venti.\n2. Tieni ogni numero dentro la fascia.\n3. Unisci un poco i numeri, come nel parlato, senza cantare.\n4. Respira tra un gruppo di cinque e l’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 1 から 20 までゆっくり数えます。\n2. 数字をそれぞれ範囲内に収めます。\n3. 歌わず、話すときのように、数字を少しつなげます。\n4. 5 つごとに息を吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 하나부터 스물까지 천천히 세어 보세요.\n2. 숫자마다 범위 안에 머물러 보세요.\n3. 노래가 아니라 말하듯이 숫자를 조금씩 이어 주세요.\n4. 다섯 개씩 묶어 그 사이에 숨을 쉬세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kira perlahan dari satu hingga dua puluh.\n2. Pastikan setiap nombor kekal dalam julat.\n3. Sambung nombor sedikit, seperti bercakap, bukan menyanyi.\n4. Tarik nafas di antara kumpulan lima nombor."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tell sakte fra én til tjue.\n2. Hold hvert tall innenfor båndet.\n3. Bind tallene litt sammen, som i tale og ikke som i sang.\n4. Pust mellom hver gruppe på fem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tel langzaam van een tot twintig.\n2. Houd elk getal binnen de band.\n3. Verbind de getallen een beetje, zoals in spraak, niet zoals zingen.\n4. Adem tussen groepjes van vijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Policz powoli od jednego do dwudziestu.\n2. Trzymaj każdą liczbę w pasmie.\n3. Lekko łącz liczby, jak w mowie, a nie w śpiewie.\n4. Oddychaj między grupami po pięć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Conte devagar de um a vinte.\n2. Mantenha cada número dentro da faixa.\n3. Una um pouco os números, como na fala, sem cantar.\n4. Respire entre grupos de cinco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Numără rar de la unu la douăzeci.\n2. Ține fiecare număr în interiorul benzii.\n3. Leagă puțin numerele, ca în vorbire, nu ca în cântat.\n4. Respiră între grupurile de cinci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Медленно посчитайте от одного до двадцати.\n2. Держите каждое число внутри полосы.\n3. Немного соединяйте числа, как в речи, а не в пении.\n4. Делайте вдох после каждой пятёрки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pomaly počítajte od jednej do dvadsiatich.\n2. Každé číslo držte v pásme.\n3. Čísla trochu prepájajte, ako v reči, nie ako v speve.\n4. Po každých piatich číslach sa nadýchnite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Počasi štejte od ena do dvajset.\n2. Vsako število držite v pasu.\n3. Števila nekoliko povežite, kot v govoru, ne kot v petju.\n4. Vdihnite po vsaki skupini petih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Räkna långsamt från ett till tjugo.\n2. Håll varje tal inom bandet.\n3. Bind ihop talen lite, som i tal och inte som i sång.\n4. Andas mellan varje grupp om fem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. นับช้าๆ ตั้งแต่หนึ่งถึงยี่สิบ\n2. ให้ตัวเลขแต่ละตัวอยู่ในแถบ\n3. เชื่อมตัวเลขเข้าด้วยกันเล็กน้อยเหมือนพูด ไม่ใช่ร้องเพลง\n4. หายใจระหว่างทุกห้าตัวเลข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Birden yirmiye kadar yavaşça sayın.\n2. Her sayıyı bandın içinde tutun.\n3. Sayıları şarkı söylemeden, konuşur gibi biraz birbirine bağlayın.\n4. Beşerli gruplar arasında nefes alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Повільно порахуйте від одного до двадцяти.\n2. Тримайте кожне число всередині смуги.\n3. Трохи поєднуйте числа, як у мовленні, а не в співі.\n4. Робіть вдих після кожної п’ятірки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Đếm chậm từ một đến hai mươi.\n2. Giữ mỗi con số trong dải.\n3. Nối các số lại một chút, như khi nói, không phải khi hát.\n4. Hít thở giữa mỗi nhóm năm số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 慢慢从一数到二十。\n2. 每个数字都保持在范围内。\n3. 数字之间稍微连起来，像说话，不像唱歌。\n4. 每五个数换一次气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 慢慢從一數到二十。\n2. 每個數字都保持在範圍內。\n3. 數字之間稍微連起來，像說話，不像唱歌。\n4. 每五個數換一次氣。"
          }
        }
      }
    },
