    "settings_icloud_sync_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ تحاليلك وتسجيلاتك في iCloud الخاص بك، متزامنة على جميع أجهزتك. وعند إيقافها تبقى على هذا الجهاز فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva les anàlisis i els enregistraments al teu iCloud privat, sincronitzats a tots els dispositius. Si la desactives, només es conserven en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovává vaše analýzy a nahrávky v soukromém iCloudu, synchronizované na všech zařízeních. Po vypnutí zůstanou jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmer dine analyser og optagelser i din private iCloud, synkroniseret på alle dine enheder. Hvis du slår det fra, findes de kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deine Analysen und Aufnahmen in deiner privaten iCloud und auf allen deinen Geräten synchron. Wenn du sie ausschaltest, bleiben sie nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατά τις αναλύσεις και τις ηχογραφήσεις σας στο ιδιωτικό σας iCloud, συγχρονισμένες σε όλες τις συσκευές σας. Αν το απενεργοποιήσετε, μένουν μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your analyses and recordings in your private iCloud, in sync on all your devices. Turning it off keeps them on this device only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus análisis y grabaciones en tu iCloud privado, sincronizados en todos tus dispositivos. Si lo desactivas, solo se quedan en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa analyysisi ja äänityksesi yksityiseen iCloudiisi ja pitää ne synkronoituina kaikilla laitteillasi. Jos kytket sen pois, ne säilyvät vain tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde vos analyses et vos enregistrements dans votre iCloud privé, synchronisés sur tous vos appareils. Si vous la désactivez, ils restent uniquement sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר את הניתוחים וההקלטות שלך ב-iCloud הפרטי שלך, מסונכרנים בכל המכשירים. כיבוי משאיר אותם במכשיר הזה בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके विश्लेषण और रिकॉर्डिंग आपके निजी iCloud में रखता है और सभी डिवाइस पर सिंक करता है। बंद करने पर ये सिर्फ़ इसी डिवाइस पर रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuva vaše analize i snimke u vašem privatnom iCloudu, sinkronizirane na svim vašim uređajima. Ako isključite, ostaju samo na ovom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elemzéseidet és felvételeidet a privát iCloudodban tartja, minden eszközödön szinkronban. Kikapcsolva csak ezen az eszközön maradnak meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan analisis dan rekaman Anda di iCloud pribadi, tersinkron di semua perangkat Anda. Jika dimatikan, semuanya hanya tersimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva analisi e registrazioni nel tuo iCloud privato, sincronizzate su tutti i dispositivi. Se disattivi, restano solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析結果と録音をあなた専用の iCloud に保存し、すべてのデバイスで同期します。オフにすると、このデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분석 결과와 녹음을 비공개 iCloud에 저장하고 모든 기기에서 동기화합니다. 끄면 이 기기에만 저장됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan analisis dan rakaman anda dalam iCloud peribadi anda, disegerakkan pada semua peranti anda. Jika dimatikan, ia disimpan pada peranti ini sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrer analysene og opptakene dine i din private iCloud, synkronisert på alle enhetene dine. Hvis du slår det av, finnes de bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt je analyses en opnamen in je privé-iCloud, gesynchroniseerd op al je apparaten. Als je dit uitzet, blijven ze alleen op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuje analizy i nagrania w Twoim prywatnym iCloud i synchronizuje je na wszystkich urządzeniach. Po wyłączeniu zostają tylko na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda suas análises e gravações no seu iCloud privado, sincronizadas em todos os dispositivos. Desativado, elas ficam só neste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează analizele și înregistrările în iCloudul tău privat, sincronizate pe toate dispozitivele. Dacă o dezactivezi, ele rămân doar pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранит анализы и записи в вашем личном iCloud и синхронизирует их на всех устройствах. Если выключить, они останутся только на этом устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchováva vaše analýzy a nahrávky vo vašom súkromnom iCloude, synchronizované vo všetkých zariadeniach. Po vypnutí zostanú len v tomto zariadení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrani vaše analize in posnetke v vašem zasebnem iCloudu, sinhronizirane v vseh vaših napravah. Če izklopite, ostanejo samo v tej napravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar dina analyser och inspelningar i din privata iCloud, synkade på alla dina enheter. Om du stänger av det finns de bara på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บการวิเคราะห์และการบันทึกเสียงของคุณใน iCloud ส่วนตัว และซิงค์ในอุปกรณ์ทุกเครื่อง หากปิด ข้อมูลจะอยู่เฉพาะบนอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizlerinizi ve kayıtlarınızı özel iCloud’unuzda tutar, tüm cihazlarınızda eşitler. Kapatırsanız yalnızca bu cihazda kalırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає аналізи й записи у вашому особистому iCloud і синхронізує їх на всіх пристроях. Якщо вимкнути, вони залишаться лише на цьому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu kết quả phân tích và bản ghi trong iCloud riêng của bạn, đồng bộ trên mọi thiết bị. Khi tắt, chúng chỉ ở trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把测评结果和录音保存在你的私人 iCloud 中，并在所有设备间同步。关闭后只保存在这台设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將分析結果與錄音儲存在你的私人 iCloud 中，並在所有裝置間同步。關閉後只儲存在這部裝置上。"
          }
        }
      }
    },
