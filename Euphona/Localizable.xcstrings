          "stringUnit" : {
            "state" : "translated",
            "value" : "Λειτουργούν καλύτερα λίγες προτάσεις καθημερινού λόγου. Διαβάστε με τον συνηθισμένο σας ρυθμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few sentences of everyday speech work best. Read at your usual pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas pocas frases cotidianas funcionan mejor. Lee a tu ritmo habitual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutama arkinen lause toimii parhaiten. Lue tavallisella tahdillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques phrases de langage courant fonctionnent le mieux. Lisez à votre rythme habituel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה משפטים מדיבור יומיומי עובדים הכי טוב. כדאי לקרוא בקצב הרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़मर्रा की बोलचाल के कुछ वाक्य सबसे अच्छे रहते हैं। अपनी सामान्य गति से पढ़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje funkcionira nekoliko rečenica iz svakodnevnog govora. Čitajte svojim uobičajenim tempom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány mindennapi beszédből vett mondat működik a legjobban. Olvass a szokásos tempódban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa kalimat percakapan sehari-hari paling cocok. Bacalah dengan kecepatan biasa Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poche frasi di uso quotidiano funzionano meglio. Leggi al tuo ritmo abituale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常会話のような数文が最適です。いつものペースで読んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일상 대화 같은 몇 문장이 가장 좋아요. 평소 속도로 읽으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa ayat pertuturan harian paling sesuai. Baca pada kadar biasa anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen få hverdagssetninger fungerer best. Les i ditt vanlige tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar zinnen alledaagse taal werken het best. Lees in je gebruikelijke tempo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepiej sprawdzi się kilka codziennych zdań. Czytaj w swoim zwykłym tempie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas frases do dia a dia funcionam melhor. Leia no seu ritmo habitual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câteva propoziții de vorbire de zi cu zi merg cel mai bine. Citește în ritmul tău obișnuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучше всего подойдут несколько обычных фраз. Читайте в привычном темпе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepšie fungujú vety z bežnej reči. Čítajte svojím obvyklým tempom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje deluje nekaj stavkov iz vsakdanjega govora. Berite v svojem običajnem tempu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några vardagliga meningar fungerar bäst. Läs i din vanliga takt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประโยคจากการพูดในชีวิตประจำวันสองสามประโยคเหมาะที่สุด อ่านด้วยจังหวะปกติของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük konuşmadan birkaç cümle en iyi sonucu verir. Olağan hızınızda okuyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкраще підійде кілька звичайних фраз. Читайте у звичному темпі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vài câu nói thường ngày là phù hợp nhất. Hãy đọc với tốc độ quen thuộc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几句日常口语就很合适，用平时的语速朗读即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾句日常口語就很合適，用平時的語速朗讀即可。"
          }
        }
      }
