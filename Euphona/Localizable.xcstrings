    "coach_chat_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إخبار المدرّب بما تشعر به أثناء التمرين، أو السؤال عن تمرين، أو طلب شيء مختلف اليوم. يغيّر المدرّب خطتك عندما تطلب ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica al coach com va la pràctica, pregunta per un exercici o demana una cosa diferent per avui. El coach canvia el teu pla quan li ho demanes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte trenérovi, jak cvičení probíhá, zeptejte se na cvičení nebo požádejte dnes o něco jiného. Trenér změní váš plán, když o to požádáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl coachen, hvordan træningen føles, spørg om en øvelse, eller bed om noget andet i dag. Coachen ændrer din plan, når du beder om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag dem Coach, wie sich das Üben anfühlt, frag nach einer Übung oder bitte um etwas anderes für heute. Der Coach ändert deinen Plan, wenn du ihn darum bittest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε στον Coach πώς πάει η εξάσκηση, ρωτήστε για μια άσκηση ή ζητήστε κάτι διαφορετικό για σήμερα. Ο Coach αλλάζει το πλάνο σας όταν το ζητήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the coach how practice feels, ask about an exercise, or ask for something different today. The coach changes your plan when you ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale al coach cómo va la práctica, pregunta por un ejercicio o pide algo distinto para hoy. El coach cambia tu plan cuando se lo pides."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro valmentajalle, miltä harjoittelu tuntuu, kysy harjoituksesta tai pyydä tänään jotain muuta. Valmentaja muuttaa suunnitelmaasi pyynnöstäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites au coach comment se passe l’entraînement, posez une question sur un exercice ou demandez autre chose pour aujourd’hui. Le coach adapte votre programme quand vous le demandez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לספר למאמן איך התרגול מרגיש, לשאול על תרגיל או לבקש משהו שונה להיום. המאמן משנה את התוכנית שלך כשמבקשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोच को बताइए कि अभ्यास कैसा लग रहा है, किसी अभ्यास के बारे में पूछिए, या आज कुछ अलग माँगिए। आपके कहने पर योजना बदल जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite treneru kako vam ide vježbanje, pitajte o vježbi ili zatražite nešto drugo za danas. Trener mijenja vaš plan kad to zatražite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd el az edzőnek, milyen a gyakorlás, kérdezz egy gyakorlatról, vagy kérj ma mást. Az edző megváltoztatja a terved, ha kéred."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceritakan kepada pelatih bagaimana rasanya berlatih, tanyakan soal latihan, atau minta sesuatu yang berbeda hari ini. Pelatih mengubah rencana Anda saat diminta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconta al coach come va l’allenamento, chiedi di un esercizio o proponi qualcosa di diverso per oggi. Il coach cambia il tuo piano quando glielo chiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習の感触を伝えたり、エクササイズについて質問したり、今日は別のことをしたいとリクエストしたりできます。リクエストに応じて、コーチがプランを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습할 때의 느낌을 코치에게 알려 주거나, 연습에 관해 물어보거나, 오늘은 다르게 해 보고 싶다고 요청해 보세요. 요청하면 코치가 계획을 바꿔 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beritahu jurulatih bagaimana rasa berlatih, tanya tentang latihan, atau minta sesuatu yang berbeza hari ini. Jurulatih mengubah pelan anda apabila diminta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell coachen hvordan treningen føles, spør om en øvelse, eller be om noe annet i dag. Coachen endrer planen din når du ber om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel de coach hoe het oefenen voelt, vraag naar een oefening of vraag om iets anders voor vandaag. De coach past je plan aan als je erom vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz trenerowi, jak idzie ćwiczenie, zapytaj o jakieś zadanie albo poproś dziś o coś innego. Trener zmienia plan, gdy o to poprosisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte ao coach como está indo a prática, pergunte sobre um exercício ou peça algo diferente para hoje. O coach muda seu plano quando você pede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune-i antrenorului cum se simte exersarea, întreabă despre un exercițiu sau cere altceva pentru azi. Antrenorul îți schimbă planul când ceri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите тренеру, как проходит практика, спросите об упражнении или попросите сегодня что-то другое. Когда вы просите, тренер меняет ваш план."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napíšte trénerovi, ako sa vám cvičí, opýtajte sa na cvičenie alebo požiadajte o niečo iné na dnes. Tréner zmení váš plán, keď o to požiadate."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenerju povejte, kako vam gre vadba, vprašajte o vaji ali prosite za kaj drugega danes. Trener spremeni vaš načrt, ko ga prosite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta för coachen hur träningen känns, fråga om en övning eller be om något annat i dag. Coachen ändrar din plan när du ber om det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกโค้ชว่าการฝึกรู้สึกอย่างไร ถามเรื่องแบบฝึกหัด หรือขอสิ่งที่ต่างออกไปในวันนี้ โค้ชจะปรับแผนของคุณเมื่อคุณขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koça çalışmanın nasıl geçtiğini söyleyin, bir egzersizi sorun veya bugün için farklı bir şey isteyin. Koç, siz istediğinizde planınızı değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розкажіть тренеру, як минає практика, запитайте про вправу або попросіть сьогодні чогось іншого. Коли ви просите, тренер змінює ваш план."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho huấn luyện viên biết bạn thấy buổi tập thế nào, hỏi về một bài tập, hoặc nhờ đổi bài khác hôm nay. Huấn luyện viên sẽ điều chỉnh kế hoạch của bạn khi bạn yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉教练练习的感觉、问问某个练习，或者要求今天换个练法。你提出来，教练就会调整计划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴教練練習的感覺、問問某個練習，或是要求今天換個練法。你提出來，教練就會調整計畫。"
          }
        }
      }
    },
    "coach_chat_empty_written" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استخدام الردود السريعة لإخبار المدرّب بما تشعر به أثناء التمرين. يغيّر المدرّب خطتك فورًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir les respostes ràpides per explicar al coach com va la pràctica. El coach canvia el teu pla a l’instant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocí rychlých odpovědí řekněte trenérovi, jak cvičení probíhá. Trenér okamžitě změní váš plán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug de hurtige svar til at fortælle coachen, hvordan træningen føles. Coachen ændrer din plan med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die Schnellantworten, um dem Coach zu sagen, wie sich das Üben anfühlt. Der Coach ändert deinen Plan sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τις γρήγορες απαντήσεις για να πείτε στον Coach πώς πάει η εξάσκηση. Ο Coach αλλάζει το πλάνο σας αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the quick replies to tell the coach how practice feels. The coach changes your plan right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las respuestas rápidas para contarle al coach cómo va la práctica. El coach cambia tu plan al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro valmentajalle pikavastauksilla, miltä harjoittelu tuntuu. Valmentaja muuttaa suunnitelmaasi heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les réponses rapides pour dire au coach comment se passe l’entraînement. Le coach adapte votre programme immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להשתמש בתשובות המהירות כדי לספר למאמן איך התרגול מרגיש. המאמן משנה את התוכנית שלך מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोच को यह बताने के लिए कि अभ्यास कैसा लग रहा है, त्वरित जवाब इस्तेमाल करें। योजना तुरंत बदल जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brzim odgovorima recite treneru kako vam ide vježbanje. Trener odmah mijenja vaš plan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyors válaszokkal mondd el az edzőnek, milyen a gyakorlás. Az edző azonnal módosítja a terved."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan balasan cepat untuk memberi tahu pelatih bagaimana rasanya berlatih. Rencana langsung diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le risposte rapide per dire al coach come va l’allenamento. Il coach cambia subito il tuo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイック返信を使って、練習の感触をコーチに伝えましょう。コーチがすぐにプランを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 답장으로 연습할 때의 느낌을 코치에게 알려 주세요. 코치가 바로 계획을 바꿔 줘요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan balasan pantas untuk memberitahu jurulatih bagaimana rasa berlatih. Pelan terus diubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk hurtigsvarene for å fortelle coachen hvordan treningen føles. Coachen endrer planen din med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de snelle antwoorden om de coach te vertellen hoe het oefenen voelt. De coach past je plan meteen aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skorzystaj z szybkich odpowiedzi, aby powiedzieć trenerowi, jak idzie ćwiczenie. Trener od razu zmienia plan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use as respostas rápidas para contar ao coach como está indo a prática. O coach muda seu plano na hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește răspunsurile rapide ca să-i spui antrenorului cum se simte exersarea. Antrenorul îți schimbă planul imediat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрые ответы помогут рассказать тренеру, как проходит практика. Тренер сразу меняет ваш план."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocou rýchlych odpovedí dajte trénerovi vedieť, ako sa vám cvičí. Tréner váš plán zmení okamžite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S hitrimi odgovori trenerju povejte, kako vam gre vadba. Trener takoj spremeni vaš načrt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd snabbsvaren för att berätta för coachen hur träningen känns. Coachen ändrar din plan direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การตอบกลับด่วนเพื่อบอกโค้ชว่าการฝึกรู้สึกอย่างไร โค้ชจะปรับแผนให้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koça çalışmanın nasıl geçtiğini söylemek için hızlı yanıtları kullanın. Koç planınızı hemen değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкі відповіді допоможуть розповісти тренеру, як минає практика. Тренер одразу змінює ваш план."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng các câu trả lời nhanh để cho huấn luyện viên biết buổi tập thế nào. Huấn luyện viên điều chỉnh kế hoạch của bạn ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用下面的快捷回复告诉教练练习的感觉，教练会马上调整计划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
