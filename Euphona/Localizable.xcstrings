    "coach_review_unmeasured" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمع ما يكفي لقياس ذلك. يُرجى تشغيل الأداة والاستمرار حتى ينتهي الوقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No he sentit prou per mesurar-ho. Inicia l’eina i continua fins que s’acabi el temps."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slyšet bylo příliš málo na to, aby se to dalo změřit. Spusťte nástroj a pokračujte, dokud neuplyne čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kunne ikke høre nok til at måle det. Start værktøjet, og bliv ved, til tiden er gået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe zu wenig gehört, um das zu messen. Starte das Werkzeug und mach weiter, bis die Zeit um ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν άκουσα αρκετά για να το μετρήσω. Ξεκινήστε το εργαλείο και συνεχίστε μέχρι να τελειώσει ο χρόνος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I couldn’t hear enough to measure that. Start the tool and keep going until the time is up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No oí lo suficiente para medirlo. Inicia la herramienta y sigue hasta que se acabe el tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kuullut tarpeeksi mittaamiseen. Käynnistä työkalu ja jatka, kunnes aika päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai pas assez entendu pour mesurer cela. Lancez l’outil et continuez jusqu’à la fin du temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא שמעתי מספיק כדי למדוד את זה. יש להפעיל את הכלי ולהמשיך עד שהזמן נגמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे मापने लायक़ पर्याप्त सुनाई नहीं दिया। टूल शुरू करें और समय पूरा होने तक जारी रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije se čulo dovoljno za mjerenje. Pokrenite alat i nastavite dok vrijeme ne istekne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem hallatszott elég a méréshez. Indítsd el az eszközt, és folytasd, amíg le nem jár az idő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya tidak mendengar cukup untuk mengukurnya. Mulai alatnya dan teruskan sampai waktu habis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ho sentito abbastanza per misurare. Avvia lo strumento e continua finché il tempo non scade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定するのに十分な声を聞き取れませんでした。ツールを開始して、時間が終わるまで続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "측정할 만큼 충분히 듣지 못했어요. 도구를 시작하고 시간이 끝날 때까지 계속해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya tidak mendengar cukup untuk mengukurnya. Mulakan alat dan teruskan sehingga masa tamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg hørte ikke nok til å kunne måle det. Start verktøyet og fortsett til tiden er ute."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik hoorde te weinig om dat te meten. Start het hulpmiddel en ga door tot de tijd om is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słyszalne było za mało, by to zmierzyć. Uruchom narzędzie i mów dalej, aż skończy się czas."
