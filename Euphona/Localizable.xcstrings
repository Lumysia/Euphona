    "coach_starting_point_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أحدث تحاليلك. تحدد المستوى الذي تبدأ منه كل مهارة وتستهدف ما بعد موضعك الحالي بقليل؛ وكل تحليل جديد يحدّث الاثنين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segons les teves últimes anàlisis. Fixen el nivell en què comença cada habilitat i apunten una mica més enllà d’on ets; cada anàlisi nova actualitza tots dos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z vašich posledních analýz. Určují úroveň, na které každá dovednost začíná, a cíl těsně nad vaším stavem; každá nová analýza aktualizuje obojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra dine seneste analyser. De afgør, hvilket niveau hver færdighed starter på, og sigter lidt over der, hvor du er. Hver ny analyse opdaterer begge dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus deinen letzten Analysen. Sie legen fest, auf welcher Stufe jede Fähigkeit beginnt, und zielen knapp über deinen aktuellen Stand; jede neue Analyse aktualisiert beides."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από τις τελευταίες αναλύσεις σας. Ορίζουν το επίπεδο από το οποίο ξεκινά κάθε δεξιότητα και στοχεύουν λίγο πιο πέρα από το σημείο όπου βρίσκεστε· κάθε νέα ανάλυση ενημερώνει και τα δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From your latest analyses. They set the level each skill starts at and targets just past where you are; every new analysis updates both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según tus últimos análisis. Fijan el nivel en el que empieza cada habilidad y apuntan un poco más allá de donde estás; cada análisis nuevo actualiza ambos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisimmistä analyyseistasi. Ne määräävät, miltä tasolta kukin taito alkaa, ja tähtäävät hieman nykytasosi yläpuolelle. Jokainen uusi analyysi päivittää molemmat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’après vos dernières analyses. Elles fixent le niveau de départ de chaque compétence et visent juste au-delà de votre situation ; chaque nouvelle analyse met les deux à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתוך הניתוחים האחרונים שלך. הם קובעים את הרמה שבה כל מיומנות מתחילה ומכוונים מעט מעבר לנקודה הנוכחית; כל ניתוח חדש מעדכן את שניהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हाल के विश्लेषणों से। इन्हीं से तय होता है कि हर कौशल किस स्तर से शुरू हो और लक्ष्य आपकी मौजूदा स्थिति से थोड़ा आगे रहे; हर नया विश्लेषण दोनों को अपडेट करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz vaših posljednjih analiza. One određuju razinu na kojoj svaka vještina počinje i ciljeve tik iznad vašeg trenutnog stanja; svaka nova analiza ažurira oboje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbbi elemzéseidből. Ezek határozzák meg, hogy az egyes készségek melyik szinten indulnak, és a célt közvetlenül a jelenlegi állapotod fölé teszik; minden új elemzés mindkettőt frissíti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari analisis terbaru Anda. Analisis itu menentukan level awal setiap keterampilan dan menargetkan sedikit di atas posisi Anda; setiap analisis baru memperbarui keduanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalle tue analisi più recenti. Stabiliscono il livello da cui parte ogni abilità e puntano poco oltre il punto in cui sei; ogni nuova analisi aggiorna entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の分析をもとにしています。各スキルを始めるレベルと、今より少し先の目標が決まり、新しい分析のたびに両方が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 분석 결과를 바탕으로 해요. 각 기술이 시작하는 단계와, 지금보다 조금 앞선 목표가 정해지고, 새 분석을 할 때마다 둘 다 업데이트돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daripada analisis terbaharu anda. Ia menentukan tahap permulaan setiap kemahiran dan mensasarkan sedikit di atas kedudukan anda; setiap analisis baharu mengemas kini kedua-duanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra de siste analysene dine. De bestemmer hvilket nivå hver ferdighet starter på, og sikter litt over der du er. Hver ny analyse oppdaterer begge deler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebaseerd op je laatste analyses. Ze bepalen op welk niveau elke vaardigheid begint en mikken net voorbij waar je nu staat; elke nieuwe analyse past beide aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie Twoich ostatnich analiz. Wyznaczają poziom, od którego zaczyna się każda umiejętność, i cel tuż ponad Twoim obecnym wynikiem; każda nowa analiza aktualizuje jedno i drugie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com base nas suas análises mais recentes. Elas definem o nível em que cada habilidade começa e miram um pouco além de onde você está; cada nova análise atualiza os dois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din analizele tale recente. Ele stabilesc nivelul de la care pornește fiecare abilitate și țintesc puțin peste locul în care ești; fiecare analiză nouă le actualizează pe amândouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По вашим последним анализам. Они задают уровень, с которого начинается каждый навык, и цель чуть выше текущего результата; каждый новый анализ обновляет и то, и другое."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podľa vašich posledných analýz. Určujú úroveň, od ktorej každá zručnosť začína, a ciele tesne za vaším súčasným stavom; každá nová analýza obe aktualizuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz vaših zadnjih analiz. Določajo raven, na kateri se posamezna veščina začne, in cilje tik nad vašim trenutnim stanjem; vsaka nova analiza posodobi oboje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från dina senaste analyser. De bestämmer vilken nivå varje färdighet börjar på och siktar strax över där du är. Varje ny analys uppdaterar båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากการวิเคราะห์ล่าสุดของคุณ ใช้กำหนดระดับที่แต่ละทักษะเริ่มต้นและตั้งเป้าหมายให้เหนือจุดที่คุณอยู่เล็กน้อย ทุกการวิเคราะห์ใหม่จะอัปเดตทั้งสองอย่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son analizlerinizden. Her becerinin hangi seviyeden başlayacağını belirler ve bulunduğunuz yerin biraz ötesini hedefler; her yeni analiz ikisini de günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За вашими останніми аналізами. Вони задають рівень, з якого починається кожна навичка, і ціль трохи вище за поточний результат; кожен новий аналіз оновлює і те, і інше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dựa trên các lần phân tích gần nhất. Chúng đặt cấp bắt đầu của từng kỹ năng và mục tiêu nhỉnh hơn mức hiện tại một chút; mỗi lần phân tích mới sẽ cập nhật cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自你最近的分析。它们决定每项技能从第几级开始，并把目标定在比现在稍好一点的地方；每次新的分析都会同时更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自你最近的分析。它們決定每項技能從第幾級開始，並把目標定在比現在稍好一點的地方；每次新的分析都會同時更新。"
          }
        }
      }
    },
