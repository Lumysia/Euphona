    "score_focus_timbre" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن العمل على الرنين: فهو ينتج عن شكل الفم والحلق، لا عن درجة الصوت. وتدرّب هذا الجانب أداتا الرنين وجرس الصوت ودروس الرنين لدى المدرّب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treballa la ressonància: ve de la forma de la boca i la gola, no del to. Les eines Ressonància i Timbre i les lliçons de ressonància del Coach l’entrenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujte na rezonanci: vychází z tvaru úst a hrdla, ne z výšky hlasu. Trénují ji nástroje Rezonance a Barva a lekce rezonance u trenéra."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejd med resonansen: Den kommer fra formen på mund og hals, ikke fra tonehøjden. Værktøjerne Resonans og Klangfarve samt coachens resonanslektioner træner den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeite an der Resonanz: Sie kommt von der Form von Mund und Rachen, nicht von der Tonhöhe. Die Werkzeuge „Resonanz“ und „Klangfarbe“ sowie die Resonanzlektionen des Coachs trainieren sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δουλέψτε την αντήχηση: προέρχεται από το σχήμα του στόματος και του λαιμού, όχι από το τονικό ύψος. Τα εργαλεία Αντήχηση και Χροιά και τα μαθήματα αντήχησης του Coach την εξασκούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work on resonance: it comes from the shape of your mouth and throat, not from pitch. The Resonance and Timbre tools and the Coach’s resonance lessons train it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabaja la resonancia: viene de la forma de la boca y la garganta, no del tono. Las herramientas Resonancia y Timbre y las lecciones de resonancia del Coach la entrenan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työstä resonanssia: se syntyy suun ja kurkun muodosta, ei äänenkorkeudesta. Resonanssi- ja Äänenväri-työkalut sekä valmentajan resonanssioppitunnit harjoittavat sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez la résonance : elle vient de la forme de la bouche et de la gorge, pas de la hauteur. Les outils Résonance et Timbre et les leçons de résonance du coach l’entraînent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לעבוד על תהודה: היא נובעת מצורת הפה והגרון, לא מגובה הקול. הכלים תהודה וגוון ושיעורי התהודה של המאמן מתרגלים אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुनाद पर काम करें: यह पिच से नहीं, मुँह और गले के आकार से आता है। अनुनाद और स्वर-रंग टूल और कोच के अनुनाद पाठ इसका अभ्यास कराते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radite na rezonanciji: ona dolazi iz oblika usta i grla, a ne iz visine glasa. Alati Rezonancija i Boja glasa te trenerove lekcije rezonancije vježbaju je."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolgozz a rezonancián: a száj és a torok alakjából ered, nem a hangmagasságból. A Rezonancia és a Hangszín eszköz, valamint az edző rezonancialeckéi gyakoroltatják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latih resonansi: berasal dari bentuk mulut dan tenggorokan, bukan dari nada. Alat Resonansi dan Timbre serta pelajaran resonansi Pelatih melatihnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavora sulla risonanza: viene dalla forma di bocca e gola, non dal tono. Gli strumenti Risonanza e Timbro e le lezioni di risonanza del Coach la allenano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共鳴に取り組みましょう。共鳴はピッチではなく、口と喉の形から生まれます。共鳴ツール、音色ツール、コーチの共鳴レッスンで鍛えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공명을 연습해 보세요. 공명은 음높이가 아니라 입과 목의 모양에서 나와요. 공명 도구, 음색 도구, 코치의 공명 레슨으로 연습할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latih resonans: ia datang daripada bentuk mulut dan tekak, bukan daripada nada. Alat Resonans dan Timbre serta pelajaran resonans Jurulatih melatihnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobb med resonansen: Den kommer fra formen på munn og hals, ikke fra tonehøyden. Verktøyene Resonans og Klangfarge og coachens resonansleksjoner trener den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk aan resonantie: die komt van de vorm van je mond en keel, niet van toonhoogte. De hulpmiddelen Resonantie en Klankkleur en de resonantielessen van de coach trainen dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj nad rezonansem: bierze się z kształtu ust i gardła, a nie z wysokości głosu. Trenują go narzędzia Rezonans i Barwa oraz lekcje rezonansu u trenera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhe a ressonância: ela vem do formato da boca e da garganta, não do tom. As ferramentas Ressonância e Timbre e as lições de ressonância do Coach a treinam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucrează la rezonanță: ea vine din forma gurii și a gâtului, nu din înălțime. Instrumentele Rezonanță și Timbru și lecțiile de rezonanță ale antrenorului o exersează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поработайте над резонансом: он зависит от формы рта и горла, а не от высоты тона. Его тренируют инструменты «Резонанс» и «Тембр» и уроки резонанса у тренера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujte na rezonancii: vychádza z tvaru úst a hrdla, nie z výšky hlasu. Nástroje Rezonancia a Farba hlasu a lekcie rezonancie od trénera ju trénujú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delajte na resonanci: izhaja iz oblike ust in grla, ne iz višine glasu. Orodji Resonanca in Barva glasu ter trenerjeve lekcije resonance jo vadijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeta med resonansen: den kommer från formen på mun och hals, inte från tonhöjden. Verktygen Resonans och Klangfärg och coachens resonanslektioner tränar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฝึกเรโซแนนซ์: มาจากรูปร่างของปากและลำคอ ไม่ใช่ระดับเสียง เครื่องมือเรโซแนนซ์ สีเสียง และบทเรียนเรโซแนนซ์ของโค้ชช่วยฝึกส่วนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezonans üzerinde çalışın: perdeden değil, ağzınızın ve boğazınızın şeklinden gelir. Rezonans ve Tını araçları ile Koç’un rezonans dersleri bunu çalıştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попрацюйте над резонансом: він залежить від форми рота й горла, а не від висоти тону. Його тренують інструменти «Резонанс» і «Тембр» та уроки резонансу в тренера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy luyện cộng hưởng: nó đến từ hình dạng của miệng và họng, không phải từ cao độ. Các công cụ Cộng hưởng và Âm sắc cùng các bài học cộng hưởng của huấn luyện viên sẽ rèn luyện nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练习共鸣：它来自口腔和喉咙的形状，而不是音高。“共鸣”“音色”工具和教练的共鸣课程都能练它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習共鳴：它來自口腔和喉嚨的形狀，而不是音高。「共鳴」「音色」工具和教練的共鳴課程都能練它。"
          }
        }
      }
    },
    "score_focus_timbre_no_pitch" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُرصد درجة صوت ثابتة، لذا يحمل جرس الصوت درجة الصوت وحده. التحدث لمدة أطول وبثبات أكبر قليلًا يُدخل درجة الصوت في الحساب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha trobat un to estable, així que el timbre sosté la puntuació de veu. Parla una mica més i amb més constància per incloure el to."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebyla nalezena stálá výška hlasu, takže skóre hlasu nese barva. Mluvte trochu déle a vyrovnaněji, aby se započítala i výška."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet nogen stabil tonehøjde, så klangfarven bærer stemmescoren. Tal lidt længere og mere jævnt for at få tonehøjden med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde keine stabile Tonhöhe gefunden, deshalb trägt die Klangfarbe den Stimmwert. Sprich etwas länger und gleichmäßiger, damit die Tonhöhe einfließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε σταθερό τονικό ύψος, γι' αυτό η χροιά καθορίζει τη βαθμολογία φωνής. Μιλήστε λίγο περισσότερο και πιο σταθερά για να συμπεριληφθεί το τονικό ύψος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No steady pitch was found, so timbre carries the voice score. Speak a little longer and more steadily to include pitch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró un tono estable, así que el timbre sostiene la puntuación de voz. Habla un poco más y con más constancia para incluir el tono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakaata äänenkorkeutta ei löytynyt, joten äänenväri kantaa ääni-pisteitä. Puhu hieman pidempään ja tasaisemmin, niin äänenkorkeus tulee mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune hauteur stable n’a été trouvée, le timbre porte donc le score vocal. Parlez un peu plus longtemps et plus régulièrement pour inclure la hauteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נמצא גובה קול יציב, ולכן הגוון נושא את ציון הקול. כדאי לדבר מעט יותר זמן וביציבות כדי לכלול גובה קול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई स्थिर पिच नहीं मिली, इसलिए आवाज़ का स्कोर स्वर-रंग पर टिका है। पिच जोड़ने के लिए थोड़ा लंबा और ज़्यादा स्थिर बोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije pronađena stalna visina glasa pa rezultat glasa nosi boja glasa. Govorite malo dulje i ravnomjernije kako bi se uključila i visina glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem találtunk stabil hangmagasságot, ezért a hangpontszámot a hangszín viszi. Beszélj egy kicsit hosszabban és egyenletesebben, hogy a hangmagasság is beleszámítson."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ditemukan nada yang stabil, jadi timbre menopang skor suara. Bicaralah sedikit lebih lama dan lebih stabil agar nada ikut dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato trovato un tono stabile, quindi il punteggio vocale dipende dal timbro. Parla un po’ più a lungo e con più costanza per includere il tono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定したピッチが見つからなかったため、声のスコアは音色だけで決まります。もう少し長く、安定して話すと、ピッチも反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정적인 음높이를 찾지 못해서 음성 점수는 음색만으로 정해졌어요. 조금 더 길고 안정적으로 말하면 음높이도 반영돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada nada yang stabil ditemui, jadi timbre menanggung skor suara. Bertutur sedikit lebih lama dan lebih mantap untuk memasukkan nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ble ikke funnet noen stabil tonehøyde, så klangfargen bærer stemmepoengsummen. Snakk litt lenger og jevnere for å få med tonehøyden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen stabiele toonhoogte gevonden, dus de klankkleur draagt de stemscore. Spreek iets langer en gelijkmatiger om toonhoogte mee te laten tellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono stałej wysokości głosu, więc wynik głosu opiera się na barwie. Mów trochę dłużej i spokojniej, aby uwzględnić wysokość."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi encontrado um tom estável, então o timbre sustenta a pontuação de voz. Fale um pouco mais e com mais constância para incluir o tom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a găsit nicio înălțime stabilă, așa că timbrul poartă scorul vocii. Vorbește puțin mai mult și mai constant ca să fie inclusă și înălțimea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устойчивая высота тона не найдена, поэтому оценка голоса опирается на тембр. Говорите чуть дольше и ровнее, чтобы учесть высоту тона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenašla sa stabilná výška hlasu, takže skóre hlasu nesie farba hlasu. Hovorte o niečo dlhšie a plynulejšie, aby sa zahrnula aj výška hlasu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stalne višine glasu ni bilo mogoče najti, zato rezultat glasu nosi barva glasu. Govorite nekoliko dlje in bolj enakomerno, da se vključi tudi višina glasu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen stadig tonhöjd hittades, så klangfärgen bär röstpoängen. Tala lite längre och jämnare för att ta med tonhöjden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบระดับเสียงที่คงที่ คะแนนเสียงจึงมาจากสีเสียงล้วนๆ พูดให้นานและนิ่งขึ้นอีกหน่อยเพื่อรวมระดับเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabit bir perde bulunamadı, bu yüzden ses puanını tını belirliyor. Perdenin dahil edilmesi için biraz daha uzun ve daha düzenli konuşun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сталу висоту тону не знайдено, тож оцінка голосу спирається на тембр. Говоріть трохи довше й рівніше, щоб урахувати висоту тону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy cao độ ổn định, nên âm sắc quyết định điểm giọng. Hãy nói lâu hơn và đều hơn một chút để tính cả cao độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有检测到稳定的音高，所以声音分只看音色。说得再长一些、稳一些，就能把音高也算进去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有偵測到穩定的音高，所以聲音分只看音色。說得再長一些、穩一些，就能把音高也算進去。"
          }
        }
      }
    },
