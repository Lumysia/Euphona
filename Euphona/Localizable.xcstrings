        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rallenta un poco; la fretta fa sfuggire la risonanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少しゆっくり話しましょう。速いと共鳴が崩れやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조금 천천히 하세요. 빨라지면 공명이 흐트러져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlahankan sedikit; kelajuan membuat resonans tergelincir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snakk litt saktere. Høy fart får resonansen til å gli."
