    "listen_back_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل هذا التسجيل والتسجيل السابق لنفس الهدف، الواحد تلو الآخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix aquest enregistrament i l’anterior cap al mateix objectiu, un darrere l’altre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrajte tuto nahrávku a předchozí ke stejnému cíli, jednu po druhé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil denne optagelse og den forrige mod samme mål, efter hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele diese Aufnahme und die letzte zum selben Ziel nacheinander ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή αυτής της ηχογράφησης και της προηγούμενης για τον ίδιο στόχο, τη μία μετά την άλλη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play this recording and the last one toward the same goal, one after the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce esta grabación y la anterior hacia el mismo objetivo, una tras otra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista tämä äänitys ja edellinen samaa tavoitetta kohti peräkkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez cet enregistrement et le précédent, vers le même objectif, l’un après l’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניגון ההקלטה הזו ושל הקודמת לאותו יעד, זו אחר זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस रिकॉर्डिंग और पिछली रिकॉर्डिंग को, एक ही लक्ष्य की ओर, एक के बाद एक चलाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducirajte ovu snimku i posljednju prema istom cilju, jednu za drugom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Játszd le ezt a felvételt és az utolsót ugyanahhoz a célhoz, egymás után."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar rekaman ini dan rekaman sebelumnya untuk tujuan yang sama, satu per satu."
