    "coach_ex_timbre_sentences_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحفاظ على جرس الصوت في الكلام المتصل هو ما يجعل الصوت الجديد يبدو كصوتك لا كتمرين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenir el timbre en la parla contínua és el que fa que la veu nova soni com tu, i no com un exercici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržet barvu v souvislé řeči je to, co způsobí, že nový hlas zní jako váš, ne jako cvičení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når klangfarven holder gennem sammenhængende tale, lyder den nye stemme som dig og ikke som en øvelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Klangfarbe im zusammenhängenden Sprechen zu halten sorgt dafür, dass die neue Stimme nach dir klingt und nicht nach einer Übung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διατήρηση της χροιάς στον συνεχή λόγο κάνει τη νέα φωνή να ακούγεται σαν εσάς και όχι σαν άσκηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holding timbre through connected speech is what makes the new voice sound like you, not like an exercise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener el timbre en el habla continua es lo que hace que la nueva voz suene a ti, y no a un ejercicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun äänenväri pysyy yhtenäisessä puheessa, uusi ääni kuulostaa sinulta eikä harjoitukselta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder le timbre dans la parole enchaînée, c’est ce qui fait que la nouvelle voix sonne comme vous et non comme un exercice."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמירה על הגוון בדיבור רציף היא מה שגורם לקול החדש להישמע כמו שלך ולא כמו תרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुड़ी हुई बोलचाल में स्वर-रंग बनाए रखना ही नई आवाज़ को आपकी अपनी आवाज़ जैसा बनाता है, किसी अभ्यास जैसा नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržavanje boje glasa u povezanom govoru ono je zbog čega novi glas zvuči kao vaš, a ne kao vježba."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangszín megtartása az összefüggő beszédben teszi azt, hogy az új hang te vagy, nem egy gyakorlat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaga timbre sepanjang ucapan bersambung membuat suara baru terdengar seperti Anda, bukan seperti latihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenere il timbro nel parlato continuo è ciò che fa suonare la nuova voce come te, non come un esercizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つながった話し言葉の中で音色を保てると、新しい声が練習ではなく、あなたらしい声として聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이어지는 말 속에서도 음색을 유지해야 새 목소리가 연습이 아니라 나다운 목소리로 들려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan timbre sepanjang pertuturan berterusan menjadikan suara baharu kedengaran seperti anda, bukan seperti latihan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å holde på klangfargen gjennom sammenhengende tale er det som får den nye stemmen til å høres ut som deg, ikke som en øvelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De klankkleur vasthouden in doorlopende spraak zorgt ervoor dat de nieuwe stem als jij klinkt, niet als een oefening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymanie barwy w mowie ciągłej sprawia, że nowy głos brzmi jak Twój, a nie jak ćwiczenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter o timbre na fala contínua é o que faz a nova voz soar como você, e não como um exercício."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrarea timbrului în vorbirea legată face ca noua voce să sune ca tine, nu ca un exercițiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда тембр держится в связной речи, новый голос звучит как ваш собственный, а не как упражнение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržanie farby hlasu v súvislej reči je to, vďaka čomu nový hlas znie ako váš, nie ako cvičenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranjanje barve glasu v povezanem govoru je tisto, zaradi česar novi glas zveni kot vaš, ne kot vaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att hålla klangfärgen genom sammanhängande tal gör att den nya rösten låter som du, inte som en övning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรักษาสีเสียงไว้ตลอดการพูดต่อเนื่องคือสิ่งที่ทำให้เสียงใหม่ฟังเป็นตัวคุณ ไม่ใช่แค่แบบฝึกหัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tınıyı bağlı konuşma boyunca korumak, yeni sesin bir egzersiz gibi değil, sizin sesiniz gibi duyulmasını sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли тембр тримається у зв’язному мовленні, новий голос звучить як ваш власний, а не як вправа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ được âm sắc trong lời nói liền mạch là điều khiến giọng mới nghe giống bạn, chứ không giống một bài tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在连贯的说话里保持音色，新的声音才会像你自己，而不像在练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在連貫的說話裡保持音色，新的聲音才會像你自己，而不像在練習。"
          }
        }
      }
    },
    "coach_ex_timbre_words_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. الحفاظ على الرنين الذي عُثر عليه وقول كلمات مفردة: أسماء الأيام، الألوان، الفواكه.\n2. مراقبة المقياس بعد كل بضع كلمات.\n3. إذا انخفض، فالعودة لحظة إلى تمرين الحروف المتحركة ثم المحاولة مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mantén la ressonància que has trobat i digues paraules soltes: dies de la setmana, colors, fruites.\n2. Mira el mesurador cada poques paraules.\n3. Si baixa, torna un moment a l’exercici de vocals i prova-ho de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zachovejte nalezenou rezonanci a říkejte jednotlivá slova: názvy dnů, barev, ovoce.\n2. Po několika slovech se podívejte na ukazatel.\n3. Pokud klesne, vraťte se na chvíli k cvičení se samohláskami a pak to zkuste znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Bevar den resonans, du fandt, og sig enkelte ord: ugedage, farver, frugter.\n2. Se på måleren efter hver få ord.\n3. Hvis den falder, så gå et øjeblik tilbage til vokaløvelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Behalte die gefundene Resonanz bei und sprich einzelne Wörter: Wochentage, Farben, Obstsorten.\n2. Beobachte die Anzeige nach jeweils ein paar Wörtern.\n3. Wenn sie sinkt, geh kurz zur Vokalübung zurück und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Κρατήστε την αντήχηση που βρήκατε και πείτε μεμονωμένες λέξεις: ονόματα ημερών, χρώματα, φρούτα.\n2. Παρακολουθήστε τον μετρητή κάθε λίγες λέξεις.\n3. Αν πέσει, γυρίστε για λίγο στην άσκηση φωνηέντων και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Keep the resonance you found and say single words: names of days, colours, fruits.\n2. Watch the meter after each few words.\n3. If it drops, go back to the vowel exercise for a moment, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mantén la resonancia que encontraste y di palabras sueltas: días de la semana, colores, frutas.\n2. Mira el medidor cada pocas palabras.\n3. Si baja, vuelve un momento al ejercicio de vocales y prueba de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Säilytä löytämäsi resonanssi ja sano yksittäisiä sanoja: viikonpäiviä, värejä, hedelmiä.\n2. Katso mittaria muutaman sanan välein.\n3. Jos se laskee, palaa hetkeksi vokaaliharjoitukseen ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Gardez la résonance trouvée et dites des mots isolés : jours de la semaine, couleurs, fruits.\n2. Regardez l’indicateur après quelques mots.\n3. S’il baisse, revenez un instant à l’exercice des voyelles, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לשמור על התהודה שנמצאה ולומר מילים בודדות: שמות ימים, צבעים, פירות.\n2. להסתכל במד אחרי כל כמה מילים.\n3. אם הוא יורד, לחזור לרגע לתרגיל התנועות ואז לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. जो अनुनाद आपने पाया है उसे बनाए रखें और अलग-अलग शब्द बोलें: दिनों, रंगों, फलों के नाम।\n2. हर कुछ शब्दों के बाद मीटर देखें।\n3. अगर वह गिर जाए, तो एक पल के लिए स्वर वाले अभ्यास पर लौटें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zadržite rezonanciju koju ste pronašli i izgovarajte pojedinačne riječi: imena dana, boja, voća.\n2. Nakon svakih nekoliko riječi pogledajte mjerač.\n3. Ako padne, nakratko se vratite vježbi sa samoglasnicima, pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tartsd meg a megtalált rezonanciát, és mondj egyes szavakat: napok, színek, gyümölcsök nevét.\n2. Néhány szó után nézd meg a mérőt.\n3. Ha leesik, térj vissza egy pillanatra a magánhangzós gyakorlathoz, aztán próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pertahankan resonansi yang Anda temukan dan ucapkan kata tunggal: nama hari, warna, buah.\n2. Perhatikan pengukur setiap beberapa kata.\n3. Jika turun, kembali sebentar ke latihan vokal, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mantieni la risonanza che hai trovato e di’ parole singole: giorni della settimana, colori, frutta.\n2. Guarda il misuratore ogni poche parole.\n3. Se scende, torna per un momento all’esercizio sulle vocali, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 見つけた共鳴を保ったまま、曜日、色、果物の名前など、単語を 1 つずつ言います。\n2. 数語ごとにメーターを確認します。\n3. 下がったら、いったん母音のエクササイズに戻り、もう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 찾아낸 공명을 유지한 채 요일, 색깔, 과일 이름처럼 단어를 하나씩 말하세요.\n2. 몇 단어마다 미터를 확인하세요.\n3. 떨어지면 잠시 모음 연습으로 돌아갔다가 다시 해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kekalkan resonans yang anda temui dan sebut perkataan tunggal: nama hari, warna, buah-buahan.\n2. Lihat meter selepas setiap beberapa perkataan.\n3. Jika ia jatuh, kembali seketika kepada latihan vokal, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Behold resonansen du fant, og si enkeltord: ukedager, farger, frukter.\n2. Se på måleren etter noen få ord.\n3. Hvis den synker, gå et øyeblikk tilbake til vokaløvelsen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Houd de resonantie vast die je hebt gevonden en zeg losse woorden: dagen van de week, kleuren, fruit.\n2. Kijk na elke paar woorden naar de meter.\n3. Als hij zakt, ga dan even terug naar de klinkeroefening en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zachowując znaleziony rezonans, mów pojedyncze słowa: nazwy dni, kolorów, owoców.\n2. Po kilku słowach patrz na wskaźnik.\n3. Jeśli spadnie, wróć na chwilę do ćwiczenia z samogłoskami, a potem spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mantenha a ressonância que encontrou e diga palavras soltas: dias da semana, cores, frutas.\n2. Olhe o medidor a cada poucas palavras.\n3. Se cair, volte um momento ao exercício de vogais e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Păstrează rezonanța pe care ai găsit-o și spune cuvinte izolate: zilele săptămânii, culori, fructe.\n2. Urmărește indicatorul după fiecare câteva cuvinte.\n3. Dacă scade, revino o clipă la exercițiul cu vocale, apoi încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Сохраняя найденный резонанс, произносите отдельные слова: названия дней, цветов, фруктов.\n2. После каждых нескольких слов смотрите на индикатор.\n3. Если он упал, вернитесь ненадолго к упражнению с гласными, затем попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zachovajte rezonanciu, ktorú ste našli, a hovorte jednotlivé slová: názvy dní, farieb, druhov ovocia.\n2. Po niekoľkých slovách sledujte ukazovateľ.\n3. Ak klesne, na chvíľu sa vráťte k cvičeniu so samohláskou a potom to skúste znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ohranite resonanco, ki ste jo našli, in izgovarjajte posamezne besede: imena dni, barv, sadja.\n2. Po vsakih nekaj besedah poglejte merilnik.\n3. Če pade, se za trenutek vrnite k vaji s samoglasniki in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Behåll resonansen du hittade och säg enstaka ord: veckodagar, färger, frukter.\n2. Titta på mätaren efter några ord.\n3. Om den sjunker, gå tillbaka till vokalövningen en stund och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. รักษาเรโซแนนซ์ที่หาเจอ แล้วพูดทีละคำ: ชื่อวัน สี ผลไม้\n2. ดูมาตรวัดหลังพูดทุกไม่กี่คำ\n3. ถ้าตกลง ให้กลับไปทำแบบฝึกหัดสระสักครู่ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Bulduğunuz rezonansı koruyun ve tek tek sözcükler söyleyin: gün adları, renkler, meyveler.\n2. Birkaç sözcükte bir göstergeye bakın.\n3. Düşerse bir süreliğine ünlü egzersizine dönün, sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Зберігаючи знайдений резонанс, вимовляйте окремі слова: назви днів, кольорів, фруктів.\n2. Після кожних кількох слів дивіться на індикатор.\n3. Якщо він упав, ненадовго поверніться до вправи з голосними, потім спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Giữ cộng hưởng bạn đã tìm được và nói từng từ riêng lẻ: tên các ngày trong tuần, màu sắc, trái cây.\n2. Nhìn đồng hồ đo sau mỗi vài từ.\n3. Nếu nó tụt xuống, hãy quay lại bài nguyên âm một lúc rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 保持刚才找到的共鸣，说单个词语：星期、颜色、水果的名字。\n2. 每说几个词看一下读数。\n3. 如果掉下来，先回到元音练习找一下感觉，再继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 保持剛才找到的共鳴，說單個詞語：星期、顏色、水果的名字。\n2. 每說幾個詞看一下讀數。\n3. 如果掉下來，先回到母音練習找一下感覺，再繼續。"
          }
        }
      }
    },
    "coach_ex_timbre_words_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات القصيرة التي فيها «إي» و«إيه» هي أسهل مكان للبدء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paraules curtes amb «i» i «e» són el millor punt de partida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejsnazší je začít krátkými slovy s „í“ a „é“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte ord med »i« og »e« er det letteste sted at begynde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Wörter mit „i“ und „e“ sind der leichteste Einstieg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σύντομες λέξεις με «ι» και «ε» είναι το πιο εύκολο σημείο για να ξεκινήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short words with “ee” and “ay” are the easiest place to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras cortas con «i» y «e» son el mejor punto de partida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhyet sanat, joissa on ”ii” ja ”ee”, ovat helpoin paikka aloittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots courts avec « i » et « é » sont le plus facile pour commencer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מילים קצרות עם “אי” ו“אֵי” הן המקום הקל ביותר להתחיל בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ई” और “ए” वाले छोटे शब्दों से शुरू करना सबसे आसान है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kratke riječi s „i“ i „e“ najlakši su početak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „í” és „é” hangot tartalmazó rövid szavak a legkönnyebb kezdés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata pendek dengan “ii” dan “ei” adalah tempat termudah untuk memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole brevi con «i» ed «e» sono il punto di partenza più facile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イー」や「エー」を含む短い単語から始めるのが一番簡単です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“이”나 “에이” 소리가 들어간 짧은 단어로 시작하는 것이 가장 쉬워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkataan pendek dengan “ii” dan “ei” ialah tempat paling mudah untuk bermula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte ord med «i» og «e» er det enkleste stedet å begynne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte woorden met “ie” en “ee” zijn de makkelijkste plek om te beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najłatwiej zacząć od krótkich słów z „i” oraz „e”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palavras curtas com “i” e “ê” são o melhor ponto de partida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuvintele scurte cu „i” și „e” sunt cel mai ușor punct de plecare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проще всего начать с коротких слов с «и» и «э»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krátke slová s „í“ a „é“ sú najľahší začiatok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kratke besede z „i“ in „e“ so najlažje izhodišče."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korta ord med ”ii” och ”ee” är det lättaste stället att börja."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำสั้นๆ ที่มีเสียง “อี” และ “เอ” เป็นจุดเริ่มต้นที่ง่ายที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“i” ve “e” içeren kısa sözcükler başlamak için en kolay yerdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найпростіше почати з коротких слів із «і» та «е»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các từ ngắn có âm “i” và “ê” là chỗ dễ bắt đầu nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带“衣”“诶”音的短词最容易开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帶「衣」「誒」音的短詞最容易開始。"
          }
        }
      }
    },
