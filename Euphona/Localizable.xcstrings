    "voice_quality_rest_advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح صوتك يومًا هادئًا: ماء وراحة ودندنة لطيفة. وإذا استمر الألم أو البحّة أكثر من أسبوعين فيُستحسن مراجعة طبيب أو أخصائي نطق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dona un dia tranquil a la teva veu: aigua, descans i taral·leig suau. Si el dolor o la ronquera duren més de dues setmanes, consulta un metge o un logopeda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopřejte hlasu klidný den: voda, odpočinek a jemné broukání. Pokud bolest nebo chrapot trvají déle než dva týdny, navštivte lékaře nebo logopeda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv stemmen en stille dag: vand, hvile og blid nynnen. Hvis smerter eller hæshed varer mere end to uger, så kontakt en læge eller en logopæd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönn deiner Stimme einen ruhigen Tag: Wasser, Ruhe und sanftes Summen. Wenn Schmerzen oder Heiserkeit länger als zwei Wochen anhalten, such ärztlichen oder logopädischen Rat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώστε στη φωνή σας μια ήσυχη μέρα: νερό, ξεκούραση και απαλό μουρμούρισμα. Αν ο πόνος ή η βραχνάδα διαρκούν περισσότερο από δύο εβδομάδες, απευθυνθείτε σε γιατρό ή λογοθεραπευτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your voice a quiet day: water, rest and gentle humming. If pain or hoarseness lasts more than two weeks, see a doctor or speech therapist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a tu voz un día tranquilo: agua, descanso y tarareo suave. Si el dolor o la ronquera duran más de dos semanas, consulta a un médico o a un logopeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna äänelle hiljainen päivä: vettä, lepoa ja pehmeää huminaa. Jos kipu tai käheys jatkuu yli kaksi viikkoa, hakeudu lääkärille tai puheterapeutille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offrez à votre voix une journée calme : eau, repos et bourdonnements doux. Si une douleur ou un enrouement dure plus de deux semaines, consultez un médecin ou un orthophoniste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לתת לקול יום שקט: מים, מנוחה וזמזום עדין. אם כאב או צרידות נמשכים יותר משבועיים, יש לפנות לרופא או לקלינאי תקשורת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज आवाज़ को शांत दिन दें: पानी, आराम और हल्की गुनगुनाहट। अगर दर्द या भर्रायापन दो हफ़्ते से ज़्यादा रहे, तो डॉक्टर या स्पीच थेरेपिस्ट को दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priuštite glasu miran dan: voda, odmor i nježno brujanje. Ako bol ili promuklost traje dulje od dva tjedna, posjetite liječnika ili logopeda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj a hangodnak egy csendes napot: víz, pihenés és halk dúdolás. Ha a fájdalom vagy a rekedtség két hétnél tovább tart, fordulj orvoshoz vagy logopédushoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri suara Anda hari yang tenang: air, istirahat, dan senandung lembut. Jika sakit atau serak berlangsung lebih dari dua minggu, temui dokter atau terapis wicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi alla tua voce una giornata tranquilla: acqua, riposo e canticchio dolce. Se dolore o raucedine durano più di due settimane, rivolgiti a un medico o a un logopedista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は声を静かに過ごしましょう。水分、休息、やさしいハミング。痛みやかすれが 2 週間以上続く場合は、医師または言語聴覚士に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 목소리를 조용히 쉬게 해 주세요. 물, 휴식, 부드러운 허밍이 도움이 돼요. 통증이나 목쉼이 2주 넘게 이어지면 의사나 언어치료사를 찾아가 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri suara anda hari yang tenang: air, rehat dan senandung lembut. Jika sakit atau serak berlarutan lebih daripada dua minggu, jumpa doktor atau ahli terapi pertuturan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi stemmen en stille dag: vann, hvile og myk nynning. Hvis smerte eller heshet varer i mer enn to uker, ta kontakt med lege eller logoped."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef je stem een rustige dag: water, rust en zacht neuriën. Als pijn of heesheid langer dan twee weken duurt, ga dan naar een arts of logopedist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj głosowi spokojny dzień: woda, odpoczynek i łagodne nucenie. Jeśli ból lub chrypka trwają dłużej niż dwa tygodnie, zgłoś się do lekarza lub logopedy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um dia tranquilo à sua voz: água, descanso e cantarolar suave. Se dor ou rouquidão durarem mais de duas semanas, procure um médico ou fonoaudiólogo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă-i vocii o zi liniștită: apă, odihnă și fredonat ușor. Dacă durerea sau răgușeala durează mai mult de două săptămâni, mergi la un medic sau la un logoped."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте голосу спокойный день: вода, отдых и мягкое гудение. Если боль или хрипота длятся больше двух недель, обратитесь к врачу или логопеду."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajte hlasu pokojný deň: voda, oddych a jemné bzučanie. Ak bolesť alebo chrapot trvá dlhšie ako dva týždne, navštívte lekára alebo logopéda."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privoščite glasu miren dan: voda, počitek in nežno brenčanje. Če bolečina ali hripavost traja več kot dva tedna, obiščite zdravnika ali logopeda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge rösten en lugn dag: vatten, vila och lugnt nynnande. Om smärta eller heshet varar i mer än två veckor, kontakta läkare eller logoped."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เสียงได้พักเงียบๆ สักวัน: ดื่มน้ำ พัก และฮัมเบาๆ หากเจ็บหรือเสียงแหบนานกว่าสองสัปดาห์ ควรพบแพทย์หรือนักแก้ไขการพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinize sakin bir gün verin: su, dinlenme ve hafif mırıldanma. Ağrı veya kısıklık iki haftadan uzun sürerse bir doktora ya da konuşma terapistine görünün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте голосу спокійний день: вода, відпочинок і м’яке гудіння. Якщо біль або захриплість тривають понад два тижні, зверніться до лікаря чи логопеда."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho giọng một ngày yên tĩnh: uống nước, nghỉ ngơi và ngân nga nhẹ nhàng. Nếu đau hoặc khàn giọng kéo dài hơn hai tuần, hãy đi khám bác sĩ hoặc chuyên gia trị liệu ngôn ngữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让嗓子安静一天：多喝水、休息、轻轻哼鸣。如果疼痛或沙哑持续超过两周，请看医生或言语治疗师。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓嗓子安靜一天：多喝水、休息、輕輕哼鳴。如果疼痛或沙啞持續超過兩週，請看醫師或語言治療師。"
          }
        }
      }
    },
    "voice_quality_result_clear" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو صوتك صافيًا وسهلًا"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La teva veu sona clara i solta"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš hlas zní čistě a snadno"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmen lyder klar og ubesværet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Stimme klingt klar und mühelos"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φωνή σας ακούγεται καθαρή και άνετη"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your voice sounds clear and easy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu voz suena clara y suelta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänesi kuulostaa kirkkaalta ja vaivattomalta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix sonne claire et aisée"
          }
