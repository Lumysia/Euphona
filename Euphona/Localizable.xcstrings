        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי להתחיל כל מספר בגובה של זה שלפניו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर संख्या उसी ऊँचाई से शुरू करें जिस पर पिछली थी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki broj započnite na istoj visini kao prethodni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden számot ugyanabban a magasságban kezdj, mint az előzőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai setiap angka pada ketinggian yang sama dengan angka sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia ogni numero alla stessa altezza del precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各数字を、直前の数字と同じ高さから始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 숫자를 바로 앞 숫자와 같은 높이에서 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan setiap nombor pada ketinggian yang sama dengan nombor sebelumnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start hvert tall i samme høyde som det forrige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin elk getal op dezelfde hoogte als het vorige."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczynaj każdą liczbę na tej samej wysokości co poprzednia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece cada número na mesma altura do anterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începe fiecare număr la aceeași înălțime ca precedentul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинайте каждое число на той же высоте, что и предыдущее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé číslo začnite v rovnakej výške ako predchádzajúce."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsako število začnite na isti višini kot prejšnje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja varje tal på samma höjd som det förra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มตัวเลขแต่ละตัวที่ความสูงเดียวกับตัวก่อนหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sayıya bir öncekiyle aynı yükseklikte başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Починайте кожне число на тій самій висоті, що й попереднє."
          }
