    "coach_model_off_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مراجعات Euphona المكتوبة الخاصة بها. التمارين والقياسات هي نفسها مع كل خيار."
