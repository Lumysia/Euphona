    "coach_ex_vowel_dark_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجرى الصوتي الأطول يخفض الفورمانتات، فيسمعها المستمعون صوتًا أكثر عمقًا وذكورية، بصرف النظر عن درجة الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tracte vocal més llarg baixa els formants, que es perceben com una veu més fosca i masculina, sigui quin sigui el to."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delší hlasový trakt snižuje formanty, což posluchači vnímají jako tmavší, mužnější hlas bez ohledu na výšku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et længere ansatsrør sænker formanterne, hvilket lyttere hører som en mørkere, mere maskulin stemme, uafhængigt af tonehøjde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein längerer Vokaltrakt senkt die Formanten. Hörende nehmen das als dunklere, männlicher klingende Stimme wahr, unabhängig von der Tonhöhe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας μακρύτερος φωνητικός σωλήνας χαμηλώνει τους συντονισμούς (formants), που οι ακροατές αντιλαμβάνονται ως πιο σκούρα, πιο αρσενική φωνή, ανεξάρτητα από το τονικό ύψος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A longer vocal tract lowers the formants, which listeners hear as a darker, more masculine voice, independent of pitch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tracto vocal más largo baja los formantes, que se perciben como una voz más oscura y masculina, sea cual sea el tono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidempi äänitorvi laskee formantteja, minkä kuulija kuulee tummempana, maskuliinisempana äänenä äänenkorkeudesta riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conduit vocal plus long abaisse les formants, ce que les auditeurs perçoivent comme une voix plus sombre, plus masculine, indépendamment de la hauteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרכי קול ארוכות יותר מנמיכות את הפורמנטים, ושומעים בכך קול כהה וגברי יותר, ללא קשר לגובה הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबी स्वर-नलिका फ़ॉर्मेंट को नीचे करती है, जिसे सुनने वाले पिच से अलग, ज़्यादा गहरी और ज़्यादा पुरुषोचित आवाज़ की तरह सुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dulji glasovni trakt snižava formante, koje slušatelji čuju kao tamniji, muževniji glas, neovisno o visini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hosszabb hangtraktus csökkenti a formánsokat, amit a hallgatók sötétebb, férfiasabb hangként hallanak, a hangmagasságtól függetlenül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran suara yang lebih panjang menurunkan formant, yang didengar pendengar sebagai suara yang lebih gelap dan terdengar lebih maskulin, terlepas dari nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tratto vocale più lungo abbassa i formanti, che chi ascolta percepisce come una voce più scura e maschile, a prescindere dal tono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声道が長いとフォルマントが下がり、聞き手には、ピッチとは関係なく、より深みのある男性的な声として聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성도가 더 길면 포먼트가 내려가고, 듣는 사람은 음높이와 상관없이 더 어둡고 남성적인 목소리로 들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran suara yang lebih panjang merendahkan formant, yang didengar pendengar sebagai suara yang lebih gelap dan kedengaran lebih maskulin, tanpa mengira nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et lengre ansatsrør senker formantene, noe lyttere hører som en mørkere, mer maskulin stemme, uavhengig av tonehøyde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een langer spraakkanaal verlaagt de formanten, wat luisteraars horen als een donkerdere, mannelijkere stem, los van toonhoogte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dłuższy przewód głosowy obniża formanty, co słuchacze odbierają jako ciemniejszy, bardziej męski głos, niezależnie od wysokości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um trato vocal mais longo abaixa os formantes, que são percebidos como uma voz mais escura e masculina, independentemente do tom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tract vocal mai lung coboară formanții, pe care ascultătorii îi aud ca o voce mai întunecată, mai masculină, independent de înălțime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более длинный голосовой тракт понижает форманты, и слушатели воспринимают это как более тёмный, более мужской голос независимо от высоты тона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlhší hlasový trakt znižuje formanty, čo poslucháči vnímajú ako tmavší, mužnejší hlas, nezávisle od výšky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daljši glasovni trakt zniža formante, ki jih poslušalci slišijo kot temnejši, bolj moški glas, neodvisno od višine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett längre ansatsrör sänker formanterna, vilket lyssnare hör som en mörkare, mer maskulin röst, oberoende av tonhöjd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่องเสียงที่ยาวขึ้นทำให้ฟอร์มันต์ต่ำลง ผู้ฟังได้ยินเป็นเสียงที่ทุ้มกว่า ฟังดูเป็นชายมากกว่า โดยไม่เกี่ยวกับระดับเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha uzun bir ses yolu formantları alçaltır; dinleyenler bunu perdeden bağımsız olarak daha koyu, daha eril bir ses olarak duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довший голосовий тракт знижує форманти, і слухачі сприймають це як темніший, чоловічніший голос незалежно від висоти тону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường phát âm dài hơn làm các formant thấp xuống; người nghe cảm nhận đó là giọng trầm hơn, nam tính hơn, bất kể cao độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更长的声道会降低共振峰，听者会觉得声音更深、更男性化，这和音高无关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更長的聲道會降低共振峰，聽者會覺得聲音更深、更男性化，這和音高無關。"
          }
        }
      }
    },
