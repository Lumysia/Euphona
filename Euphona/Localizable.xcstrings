    "coach_ex_dog_bright_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع الحنجرة يقصّر المجرى الصوتي. واللهاث يجد هذا الوضع دون إجبار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pujar la laringe escurça el tracte vocal. Panteixar troba aquesta posició sense forçar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvednutý hrtan zkracuje hlasový trakt. Takové dýchání tuto polohu najde bez násilí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når strubehovedet løftes, bliver ansatsrøret kortere. Hundepusten finder den position uden at tvinge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein höherer Kehlkopf verkürzt den Vokaltrakt. Beim Hecheln findest du diese Position, ohne sie zu erzwingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανύψωση του λάρυγγα μικραίνει τον φωνητικό σωλήνα. Το λαχάνιασμα βρίσκει αυτή τη θέση χωρίς πίεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raising the larynx shortens the vocal tract. Panting finds that position without forcing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subir la laringe acorta el tracto vocal. Jadear encuentra esa posición sin forzarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kurkunpää nousee, äänitorvi lyhenee. Läähätys löytää tämän asennon pakottamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monter le larynx raccourcit le conduit vocal. Haleter permet de trouver cette position sans la forcer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגבהת הגרון מקצרת את דרכי הקול. התנשפות מוצאת את המיקום הזה בלי כפייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वरयंत्र ऊपर उठाने से स्वर-नलिका छोटी हो जाती है। हाँफने से यह स्थिति बिना ज़ोर लगाए मिल जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podizanje grkljana skraćuje glasovni trakt. Dahtanje pronalazi taj položaj bez prisile."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gégefő emelése megrövidíti a hangtraktust. A lihegés erőlködés nélkül megtalálja ezt a helyzetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengangkat laring memperpendek saluran suara. Terengah-engah menemukan posisi itu tanpa memaksa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzare la laringe accorcia il tratto vocale. Ansimare trova quella posizione senza forzarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喉頭を上げると声道が短くなります。息を弾ませると、無理なくその位置が見つかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후두를 올리면 성도가 짧아져요. 헥헥거리면 억지로 하지 않고도 그 위치를 찾을 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengangkat laring memendekkan saluran suara. Mengah menemui kedudukan itu tanpa memaksa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når strupehodet løftes, blir ansatsrøret kortere. Hundepusting finner den posisjonen uten å tvinge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het strottenhoofd omhoog gaat, wordt het spraakkanaal korter. Door te hijgen vind je die stand zonder te forceren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniesiona krtań skraca przewód głosowy. Taki oddech pozwala znaleźć to ustawienie bez wymuszania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subir a laringe encurta o trato vocal. Ofegar encontra essa posição sem forçar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridicarea laringelui scurtează tractul vocal. Gâfâitul găsește această poziție fără a o forța."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда гортань поднимается, голосовой тракт становится короче. Так дыхание помогает найти это положение без усилия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdvihnutie hrtana skracuje hlasový trakt. Zadychčané dýchanie túto polohu nájde bez násilia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvig grtanca skrajša glasovni trakt. Sopihanje najde ta položaj brez prisile."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När struphuvudet höjs blir ansatsröret kortare. Flåsandet hittar det läget utan att tvinga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การยกกล่องเสียงให้สูงขึ้นทำให้ช่องเสียงสั้นลง การหอบช่วยหาตำแหน่งนั้นได้โดยไม่ต้องฝืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gırtlağı yükseltmek ses yolunu kısaltır. Soluma, bu konumu zorlamadan bulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли гортань піднімається, голосовий тракт стає коротшим. Таке дихання допомагає знайти це положення без зусилля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nâng thanh quản lên làm đường phát âm ngắn lại. Thở dốc giúp tìm ra vị trí đó mà không cần gắng sức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抬高喉头能缩短声道。喘气能自然找到这个位置，而不用硬推。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抬高喉頭能縮短聲道。喘氣能自然找到這個位置，而不用硬推。"
          }
        }
      }
    },
    "coach_ex_dog_dark_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. التنفّس ببطء وعمق مثل كلب كبير، مع الإحساس بهبوط الحنجرة إلى أسفل.\n2. الحفاظ على هذا الإحساس الرحب وقول «آ».\n3. ثم تجربة «أو» و«أوو» و«آو» بالطريقة نفسها.\n4. الاسترخاء إذا شعر الصوت بأي ضغط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Panteixa lentament i fons, com un gos gran; nota com la laringe baixa i s’assenta.\n2. Mantén aquesta sensació espaiosa i digues «a».\n3. Prova després «o», «u» i «o» oberta de la mateixa manera.\n4. Deixa-ho anar si alguna cosa se sent oprimida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Dýchejte pomalu a zhluboka jako velký pes; ucítíte, jak hrtan klesá.\n2. Zachovejte ten prostorný pocit a řekněte „á“.\n3. Pak stejně zkuste „ó“, „ú“ a otevřené „o“.\n4. Uvolněte se, jestli se něco stahuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pust langsomt og dybt som en stor hund, og mærk strubehovedet sænke sig.\n2. Bevar den rummelige fornemmelse og sig »a«.\n3. Prøv derefter »o«, »u« og »å« på samme måde.\n4. Slip, hvis noget føles presset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hechle langsam und tief wie ein großer Hund; spüre, wie sich der Kehlkopf senkt.\n2. Behalte dieses geräumige Gefühl und sage „a“.\n3. Probiere dann auf dieselbe Weise „o“, „u“ und „au“.\n4. Lass los, wenn sich etwas gedrückt anfühlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ασθμάνετε αργά και βαθιά σαν μεγάλος σκύλος· νιώστε τον λάρυγγα να κατεβαίνει χαμηλά.\n2. Κρατήστε αυτό το ευρύχωρο αίσθημα και πείτε «α».\n3. Έπειτα δοκιμάστε με τον ίδιο τρόπο «ο», «ου» και «ω».\n4. Χαλαρώστε αν κάτι νιώθετε πιεσμένο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pant slowly and deeply like a big dog; feel the larynx settle low.\n2. Keep that roomy feeling and say “ah”.\n3. Then try “oh”, “oo” and “aw” the same way.\n4. Release if anything feels pressed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Jadea lento y hondo, como un perro grande; nota cómo la laringe baja y se asienta.\n2. Mantén esa sensación amplia y di «a».\n3. Prueba después con «o», «u» y «o» abierta del mismo modo.\n4. Suelta si algo se siente oprimido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Läähätä hitaasti ja syvään kuin iso koira ja tunne, kuinka kurkunpää laskeutuu.\n2. Pidä tuo tilava tunne ja sano ”aa”.\n3. Kokeile sitten ”oo”, ”uu” ja ”å” samalla tavalla.\n4. Päästä irti, jos jokin tuntuu painetulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Haletez lentement et profondément comme un gros chien ; sentez le larynx descendre.\n2. Gardez cette sensation d’espace et dites « a ».\n3. Essayez ensuite « o », « ou » et « au » de la même façon.\n4. Relâchez si quelque chose se comprime."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. להתנשף לאט ובעומק כמו כלב גדול; להרגיש את הגרון שוקע נמוך.\n2. לשמור על התחושה המרווחת הזו ולומר “אה”.\n3. אחר כך לנסות באותו אופן “או”, “אוּ” ו“אוֹ”.\n4. להרפות אם משהו מרגיש לחוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. बड़े कुत्ते की तरह धीरे और गहरा हाँफें; महसूस करें कि स्वरयंत्र नीचे बैठ रहा है।\n2. वही खुलापन बनाए रखकर “आ” कहें।\n3. फिर इसी तरह “ओ”, “ऊ” और “ऑ” आज़माएँ।\n4. कुछ भी दबा हुआ लगे तो ढीला छोड़ दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Polako i duboko dahćite kao veliki pas; osjetite kako se grkljan nisko spušta.\n2. Zadržite taj prostrani osjećaj i recite „a“.\n3. Zatim na isti način pokušajte „o“, „u“ i otvoreno „o“.\n4. Popustite ako se išta stišće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lihegj lassan és mélyen, mint egy nagy kutya; érezd, ahogy a gégefő mélyre ereszkedik.\n2. Tartsd meg ezt a tágas érzést, és mondd: „á”.\n3. Aztán ugyanígy próbáld a „ó”, „ú” és a nyílt „o” hangot.\n4. Engedd el, ha bármi nyomódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Terengah-engah pelan dan dalam seperti anjing besar; rasakan laring turun rendah.\n2. Pertahankan rasa lega itu, lalu ucapkan “ah”.\n3. Lalu coba “oh”, “uu”, dan “aw” dengan cara yang sama.\n4. Lepaskan jika ada yang terasa tertekan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ansima lentamente e in profondità, come un cane grande; senti la laringe che scende e si assesta.\n2. Mantieni quella sensazione spaziosa e di’ «a».\n3. Poi prova «o», «u» e «o» aperta allo stesso modo.\n4. Lascia andare se senti oppressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 大型犬のように、ゆっくり深く息を弾ませます。喉頭が低く落ち着くのを感じましょう。\n2. そのゆったりした感覚を保ったまま「アー」と言います。\n3. 同じ要領で「オー」「ウー」「口を大きく開けたオー」も試します。\n4. どこかに圧迫感があれば、力を抜きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 큰 강아지처럼 느리고 깊게 헥헥거려 보세요. 후두가 낮게 내려앉는 느낌을 느껴 보세요.\n2. 넉넉한 그 느낌을 유지한 채 “아”라고 말하세요.\n3. 같은 방법으로 “오”, “우”, “어”도 해 보세요.\n4. 어딘가 눌리는 느낌이 들면 힘을 빼세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mengah perlahan dan dalam seperti anjing besar; rasai laring turun rendah.\n2. Kekalkan rasa lapang itu, kemudian sebut “ah”.\n3. Kemudian cuba “oh”, “uu” dan “aw” dengan cara yang sama.\n4. Lepaskan jika ada yang terasa tertekan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pust sakte og dypt som en stor hund, og kjenn at strupehodet senker seg.\n2. Behold den romslige følelsen og si «a».\n3. Prøv deretter «o», «u» og «å» på samme måte.\n4. Slipp opp hvis noe kjennes presset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hijg langzaam en diep als een grote hond; voel hoe het strottenhoofd laag zakt.\n2. Houd dat ruime gevoel vast en zeg “aa”.\n3. Probeer daarna op dezelfde manier “oo”, “oe” en “au”.\n4. Laat los als iets ingedrukt voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Oddychaj wolno i głęboko jak duży pies; poczuj, jak krtań osiada nisko.\n2. Zachowaj to przestronne uczucie i powiedz „a”.\n3. Potem w ten sam sposób spróbuj „o”, „u” i otwartego „o”.\n4. Rozluźnij się, jeśli coś jest ściśnięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ofegue devagar e fundo, como um cachorro grande; sinta a laringe descer e assentar.\n2. Mantenha essa sensação espaçosa e diga “a”.\n3. Depois tente “ô”, “u” e “ó” do mesmo jeito.\n4. Solte se algo parecer comprimido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Gâfâie rar și adânc ca un câine mare; simte cum coboară laringele.\n2. Păstrează senzația aceea de spațiu și spune „a”.\n3. Apoi încearcă la fel „o”, „u” și „oa”.\n4. Relaxează-te dacă ceva se simte apăsat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Дышите медленно и глубоко, как большая собака; почувствуйте, как гортань опускается.\n2. Сохраните это просторное ощущение и произнесите «а».\n3. Затем так же попробуйте «о», «у» и открытое «о».\n4. Расслабьтесь, если что-то пережато."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pomaly a zhlboka dýchajte ako veľký pes; pocíťte, ako sa hrtan usadzuje nízko.\n2. Zachovajte ten priestranný pocit a povedzte „á“.\n3. Rovnako skúste „ó“, „ú“ a „o“.\n4. Ak niečo tlačí, uvoľnite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Počasi in globoko dihajte kot velik pes; začutite, kako se grtanec nizko spusti.\n2. Ohranite ta prostorni občutek in recite „a“.\n3. Nato na enak način poskusite „o“, „u“ in odprti „o“.\n4. Popustite, če se karkoli stiska."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Flåsa långsamt och djupt som en stor hund och känn hur struphuvudet sjunker.\n2. Behåll den rymliga känslan och säg ”aa”.\n3. Prova sedan ”oo”, ”uu” och ”å” på samma sätt.\n4. Släpp taget om något känns pressat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. หอบช้าๆ ลึกๆ เหมือนสุนัขตัวใหญ่ สังเกตว่ากล่องเสียงลดต่ำลง\n2. คงความรู้สึกโปร่งนั้นไว้ แล้วออกเสียง “อา”\n3. จากนั้นลอง “โอ” “อู” และ “ออ” ด้วยวิธีเดียวกัน\n4. ถ้ารู้สึกอึดอัดตรงไหน ให้ผ่อนออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Büyük bir köpek gibi yavaş ve derin soluyun; gırtlağın aşağı yerleştiğini hissedin.\n2. Bu geniş hissi koruyun ve “a” deyin.\n3. Sonra aynı şekilde “o”, “u” ve “ö” deneyin.\n4. Bir yer bastırılmış hissederse bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Дихайте повільно й глибоко, як великий собака; відчуйте, як гортань опускається.\n2. Збережіть це просторе відчуття й вимовте «а».\n3. Потім так само спробуйте «о», «у» та відкрите «о».\n4. Розслабтеся, якщо щось затиснуто."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Thở dốc chậm và sâu như một chú chó lớn; cảm nhận thanh quản hạ thấp xuống.\n2. Giữ cảm giác rộng rãi đó rồi nói “a”.\n3. Sau đó thử “ô”, “u” và “o” theo cách tương tự.\n4. Thả lỏng nếu có chỗ nào thấy bị ép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 像大狗一样慢而深地喘气，感觉喉头往下沉。\n2. 保持这种宽敞的感觉，说“啊”。\n3. 再用同样的方式试“哦”“乌”“奥”。\n4. 觉得压着就放松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 像大狗一樣慢而深地喘氣，感覺喉頭往下沉。\n2. 保持這種寬敞的感覺，說「啊」。\n3. 再用同樣的方式試「喔」「烏」「奧」。\n4. 覺得壓著就放鬆。"
          }
        }
      }
    },
    "coach_ex_dog_dark_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رحب لا مضغوط: ينبغي أن يبدو الحلق مفتوحًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaiós, no oprimit: la gola ha de sentir-se oberta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostorně, ne stlačeně: hrdlo má zůstat otevřené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rummeligt, ikke presset: Halsen skal føles åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräumig, nicht gedrückt: Der Hals sollte sich offen anfühlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευρύχωρα, όχι πιεσμένα: ο λαιμός πρέπει να νιώθει ανοιχτός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roomy, not pressed: the throat should feel open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplio, no oprimido: la garganta debe sentirse abierta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilava, ei painettu: kurkun pitää tuntua avoimelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l’espace, sans pression : la gorge doit rester ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרווח, לא לחוץ: הגרון צריך להרגיש פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुला हुआ, दबा हुआ नहीं: गला खुला महसूस होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostrano, ne stisnuto: grlo neka bude otvoreno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tágasan, nem nyomva: a torkod legyen nyitott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lega, bukan tertekan: tenggorokan harus terasa terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazioso, non compresso: la gola deve sentirsi aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆったりと、押しつけずに。喉が開いている感覚が目安です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눌리지 않고 넉넉하게. 목이 열려 있는 느낌이어야 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lapang, bukan tertekan: tekak harus terasa terbuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romslig, ikke presset: Halsen skal føles åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruim, niet ingedrukt: je keel moet open voelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestronnie, a nie ciasno: gardło ma pozostać otwarte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaçoso, não comprimido: a garganta deve parecer aberta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațios, nu apăsat: gâtul trebuie să se simtă deschis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просторно, а не пережато: горло должно оставаться открытым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priestranne, nie stlačene: hrdlo má byť otvorené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostorno, ne stisnjeno: grlo naj bo odprto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rymligt, inte pressat: halsen ska kännas öppen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปร่ง ไม่อัด: คอควรรู้สึกเปิดโล่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geniş, bastırılmış değil: boğaz açık hissetmeli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просторо, а не затиснуто: горло має залишатися відкритим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rộng rãi, không bị ép: cổ họng phải có cảm giác mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要宽敞而不是压着，喉咙应该是打开的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要寬敞而不是壓著，喉嚨應該是打開的。"
          }
        }
      }
    },
