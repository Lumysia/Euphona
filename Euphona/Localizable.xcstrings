    "coach_ex_question_rise_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركة في درجة الصوت تحمل المعنى والحيوية. والتدرّب عليها يُبقي الصوت معبّرًا بدل أن يكون مسطّحًا عند نغمة واحدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El moviment del to transmet significat i vida. Practicar-lo evita que la veu soni plana, sempre en una sola nota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb ve výšce hlasu nese význam a živost. Jeho nácvik udržuje hlas výrazný místo plochého na jednom tónu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelse i tonehøjden bærer mening og liv. Når du øver den, bliver stemmen udtryksfuld i stedet for flad på én tone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung in der Tonhöhe trägt Bedeutung und Lebendigkeit. Sie zu üben hält die Stimme ausdrucksvoll statt flach auf einem Ton."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση στο τονικό ύψος μεταφέρει νόημα και ζωντάνια. Η εξάσκηση κρατά τη φωνή εκφραστική αντί για επίπεδη σε μία νότα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movement in pitch carries meaning and liveliness. Practising it keeps the voice expressive instead of flat at one note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento del tono transmite significado y vida. Practicarlo evita que la voz suene plana, siempre en una sola nota."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenkorkeuden liike kantaa merkitystä ja eloa. Sen harjoittelu pitää äänen ilmaisuvoimaisena eikä yhdelle sävelelle litistyneenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mouvement de la hauteur porte du sens et de la vivacité. S’y exercer garde la voix expressive plutôt que plate sur une seule note."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועה בגובה הקול נושאת משמעות וחיות. תרגול שלה שומר על קול ססגוני במקום שטוח על צליל אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिच की चाल से अर्थ और जीवंतता आती है। इसका अभ्यास आवाज़ को एक सुर पर सपाट होने से बचाकर भावपूर्ण रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kretanje visine glasa nosi značenje i živost. Vježbanje održava glas izražajnim umjesto jednoličnim na jednom tonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangmagasság mozgása jelentést és élénkséget hordoz. A gyakorlása kifejezőn tartja a hangot, nem laposan egyetlen hangon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerak nada membawa makna dan kehidupan. Melatihnya menjaga suara tetap ekspresif, tidak datar di satu nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il movimento del tono porta significato e vivacità. Esercitarlo evita che la voce suoni piatta, su una sola nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピッチの動きは意味や活気を伝えます。練習すると、声が 1 つの音で平坦にならず、表情豊かになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음높이의 움직임은 뜻과 생기를 전해요. 연습하면 목소리가 한 음에 머물지 않고 표현이 풍부해져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergerakan nada membawa makna dan kehidupan. Melatihnya memastikan suara ekspresif, tidak mendatar pada satu nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevegelse i tonehøyden bærer mening og liv. Når du øver på den, blir stemmen uttrykksfull i stedet for flat på én tone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging in toonhoogte draagt betekenis en levendigheid. Dat oefenen houdt de stem expressief in plaats van vlak op één toon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch wysokości głosu niesie znaczenie i życie. Ćwiczenie go sprawia, że głos pozostaje wyrazisty zamiast płaski na jednym dźwięku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O movimento do tom carrega significado e vida. Praticá-lo evita que a voz fique plana, numa nota só."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcarea înălțimii poartă sens și vioiciune. Exersarea ei păstrează vocea expresivă în loc să fie plată pe o singură notă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движение высоты тона несёт смысл и живость. Практика помогает голосу оставаться выразительным, а не монотонным на одной ноте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohyb výšky hlasu nesie význam a živosť. Jeho nácvik udržuje hlas výrazný, nie plochý na jednom tóne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibanje višine glasu nosi pomen in živahnost. Vadba ohranja glas izrazen, ne ravno enoličen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rörelse i tonhöjden bär mening och liv. När du övar på den blir rösten uttrycksfull i stället för platt på en ton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเคลื่อนของระดับเสียงสื่อความหมายและความมีชีวิตชีวา การฝึกช่วยให้เสียงมีอารมณ์ ไม่แบนอยู่ที่โน้ตเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdedeki hareket anlam ve canlılık taşır. Bunu çalışmak sesi tek bir notada düz kalmaktan kurtarıp anlatımlı tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рух висоти тону несе зміст і жвавість. Практика допомагає голосу лишатися виразним, а не одноманітним на одній ноті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển động của cao độ mang ý nghĩa và sự sống động. Luyện nó giúp giọng giàu biểu cảm thay vì phẳng ở một nốt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高的起伏能传达意思和活力。练习它能让声音有表情，而不是停在一个音上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高的起伏能傳達意思和活力。練習它能讓聲音有表情，而不是停在一個音上。"
          }
        }
      }
    },
    "coach_ex_reading_flow_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. قراءة المقطع بصوت عالٍ بإيقاع سهل ومتساوٍ.\n2. التوقف عند الفواصل والنقاط، والتنفّس هناك.\n3. الحفاظ على صوت خفيف دون إجهاد من البداية إلى النهاية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Llegeix el passatge en veu alta a un ritme fàcil i uniforme.\n2. Fes una pausa a les comes i als punts, i respira allà.\n3. Mantén la veu lleugera i sense forçar de principi a fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Čtěte úryvek nahlas v klidném, vyrovnaném tempu.\n2. U čárek a teček udělejte pauzu a nadechněte se.\n3. Udržujte hlas lehký a nenucený od začátku do konce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Læs teksten højt i et roligt, jævnt tempo.\n2. Hold pause ved kommaer og punktummer, og træk vejret der.\n3. Hold stemmen let og ubesværet fra start til slut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lies den Text in leichtem, gleichmäßigem Tempo laut vor.\n2. Mach bei Kommas und Punkten eine Pause und atme dort.\n3. Halte deine Stimme von Anfang bis Ende leicht und unangestrengt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Διαβάστε το κείμενο φωναχτά με εύκολο, ομοιόμορφο ρυθμό.\n2. Κάντε παύση στα κόμματα και στις τελείες και αναπνεύστε εκεί.\n3. Κρατήστε τη φωνή ελαφριά και χωρίς πίεση από την αρχή ως το τέλος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Read the passage aloud at an easy, even pace.\n2. Pause at commas and full stops, and breathe there.\n3. Keep your voice light and unforced from start to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lee el pasaje en voz alta a un ritmo fácil y parejo.\n2. Haz una pausa en las comas y los puntos, y respira ahí.\n3. Mantén la voz ligera y sin forzar de principio a fin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lue teksti ääneen rauhallisella, tasaisella tahdilla.\n2. Tauota pilkuissa ja pisteissä ja hengitä niissä.\n3. Pidä äänesi kevyenä ja pakottamattomana alusta loppuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lisez le texte à voix haute à un rythme facile et régulier.\n2. Marquez une pause aux virgules et aux points, et respirez à ces moments.\n3. Gardez une voix légère et naturelle du début à la fin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לקרוא את הקטע בקול בקצב קל ואחיד.\n2. לעצור בפסיקים ובנקודות, ולנשום שם.\n3. לשמור על קול קליל וללא מאמץ מההתחלה ועד הסוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. अनुच्छेद को आराम की, एक-सी गति से ज़ोर से पढ़ें।\n2. अल्पविराम और पूर्णविराम पर रुकें और वहीं साँस लें।\n3. शुरू से अंत तक आवाज़ हल्की और बिना ज़ोर की रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pročitajte tekst naglas lakim, ujednačenim tempom.\n2. Zastanite kod zareza i točaka te se tamo udahnite.\n3. Glas neka bude lagan i neusiljen od početka do kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Olvasd fel a szöveget könnyed, egyenletes tempóban.\n2. Állj meg a vesszőknél és a pontoknál, és ott végy levegőt.\n3. Tartsd a hangod könnyűnek és erőltetés nélkülinek az elejétől a végéig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Bacakan teks dengan lantang pada kecepatan santai dan merata.\n2. Berhenti di koma dan titik, lalu tarik napas di sana.\n3. Jaga suara tetap ringan dan tidak dipaksa dari awal sampai akhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Leggi il brano ad alta voce con un ritmo facile e regolare.\n2. Fai una pausa alle virgole e ai punti, e respira lì.\n3. Tieni la voce leggera e senza forzare dall’inizio alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 楽で一定のペースで、文章を音読します。\n2. 読点や句点で止まり、そこで息を吸います。\n3. 最初から最後まで、声を軽く、無理なく保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 편하고 고른 속도로 글을 소리 내어 읽으세요.\n2. 쉼표와 마침표에서 멈추고, 거기서 숨을 쉬세요.\n3. 처음부터 끝까지 목소리를 가볍고 힘 빼고 유지하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Baca petikan dengan kuat pada kadar yang santai dan sekata.\n2. Berhenti pada koma dan noktah, dan tarik nafas di situ.\n3. Pastikan suara ringan dan tidak dipaksa dari awal hingga akhir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Les teksten høyt i et rolig, jevnt tempo.\n2. Ta pause ved komma og punktum, og pust der.\n3. Hold stemmen lett og uanstrengt fra start til slutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lees de tekst hardop voor in een makkelijk, gelijkmatig tempo.\n2. Pauzeer bij komma’s en punten en adem daar.\n3. Houd je stem van begin tot eind licht en ongedwongen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Czytaj fragment na głos w spokojnym, równym tempie.\n2. Rób przerwy przy przecinkach i kropkach i oddychaj w nich.\n3. Utrzymuj głos lekki i niewymuszony od początku do końca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Leia o trecho em voz alta num ritmo fácil e constante.\n2. Pause nas vírgulas e nos pontos finais, e respire ali.\n3. Mantenha a voz leve e sem forçar do começo ao fim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Citește textul cu voce tare într-un ritm ușor și egal.\n2. Fă pauză la virgule și la puncte și respiră acolo.\n3. Păstrează vocea ușoară și firească de la început până la sfârșit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Читайте отрывок вслух в спокойном, ровном темпе.\n2. Делайте паузы на запятых и точках и дышите в них.\n3. Держите голос лёгким и свободным от начала до конца."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Prečítajte text nahlas ľahkým, rovnomerným tempom.\n2. Zastavte sa pri čiarkach a bodkách a tam sa nadýchnite.\n3. Hlas majte od začiatku do konca ľahký a nenútený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Besedilo preberite na glas v lahkem, enakomernem tempu.\n2. Ustavite se pri vejicah in pikah ter tam vdihnite.\n3. Glas naj bo od začetka do konca lahkoten in neprisiljen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Läs texten högt i lugn och jämn takt.\n2. Gör paus vid kommatecken och punkter, och andas där.\n3. Håll rösten lätt och ledig från början till slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. อ่านข้อความออกเสียงด้วยจังหวะสบายๆ สม่ำเสมอ\n2. หยุดที่เครื่องหมายจุลภาคและจุด แล้วหายใจตรงนั้น\n3. รักษาเสียงให้เบาและไม่ฝืนตั้งแต่ต้นจนจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Metni kolay ve düzenli bir hızla yüksek sesle okuyun.\n2. Virgüllerde ve noktalarda durun, orada nefes alın.\n3. Sesinizi baştan sona hafif ve zorlamasız tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Читайте уривок уголос у спокійному, рівному темпі.\n2. Робіть паузи на комах і крапках та дихайте в них.\n3. Тримайте голос легким і вільним від початку до кінця."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Đọc to đoạn văn với tốc độ dễ chịu, đều đặn.\n2. Dừng ở dấu phẩy và dấu chấm, và hít thở ở đó.\n3. Giữ giọng nhẹ nhàng, không gượng ép từ đầu đến cuối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 用轻松、均匀的语速朗读这段文字。\n2. 在逗号和句号处停顿、换气。\n3. 从头到尾保持声音轻松、不用力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 用輕鬆、均勻的語速朗讀這段文字。\n2. 在逗號和句號處停頓、換氣。\n3. 從頭到尾保持聲音輕鬆、不用力。"
          }
        }
      }
    },
    "coach_ex_reading_flow_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا حدث دفع أو استعجال فيُستحسن التباطؤ والتنفّس عند الفواصل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si forces o t’acceleres, ves més a poc a poc i respira a les comes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud tlačíte nebo spěcháte, zpomalte a nadechujte se u čárek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du presser eller haster, så sæt farten ned, og træk vejret ved kommaerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du drückst oder hetzt, werde langsamer und atme bei den Kommas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν πιέζετε ή βιάζεστε, επιβραδύνετε και αναπνεύστε στα κόμματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you push or rush, slow down and breathe at the commas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuerzas o te aceleras, ve más despacio y respira en las comas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos painat tai kiirehdit, hidasta ja hengitä pilkuissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous forcez ou vous précipitez, ralentissez et respirez aux virgules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם דוחפים או ממהרים, כדאי להאט ולנשום בפסיקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर ज़ोर लग रहा हो या जल्दी हो रही हो, तो धीमे हों और अल्पविराम पर साँस लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako gurate ili žurite, usporite i udahnite kod zareza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nyomod vagy sietsz, lassíts, és a vesszőknél vegyél levegőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika memaksa atau terburu-buru, pelankan dan tarik napas di koma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se forzi o ti affretti, rallenta e respira alle virgole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力んだり急いだりしているときは、ペースを落として読点で息を吸いましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힘이 들어가거나 서두르게 되면 속도를 늦추고 쉼표에서 숨을 쉬세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika memaksa atau tergesa-gesa, perlahankan dan tarik nafas pada koma."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du presser eller haster, sakk farten og pust ved kommaene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je duwt of haast maakt, ga dan langzamer en adem bij de komma’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli głos się napina albo się spieszysz, zwolnij i oddychaj przy przecinkach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver forçando ou apressando, desacelere e respire nas vírgulas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă forțezi sau te grăbești, încetinește și respiră la virgule."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если голос зажимается или вы торопитесь, замедлитесь и дышите на запятых."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak tlačíte alebo sa ponáhľate, spomaľte a nadýchnite sa pri čiarkach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če potiskate ali hitite, upočasnite in vdihnite pri vejicah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du pressar eller skyndar, sakta ner och andas vid kommatecknen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าฝืนหรือรีบ ให้ช้าลงและหายใจตรงเครื่องหมายจุลภาค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorluyor veya acele ediyorsanız yavaşlayın ve virgüllerde nefes alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо голос затискається або ви поспішаєте, сповільніться й дихайте на комах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đang gắng sức hoặc đọc vội, hãy chậm lại và hít thở ở các dấu phẩy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在用力或赶，就放慢，在逗号处换气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果覺得在用力或趕，就放慢，在逗號處換氣。"
          }
        }
      }
    },
    "coach_ex_reading_flow_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة منسابة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lectura fluida"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plynulé čtení"
          }
        },
        "da" : {
