    "about_models_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دُرّبت نماذج Euphona الخاصة بجرس الصوت والارتياح وجودة الصوت على هذه التسجيلات العامة. كل شيء يعمل على جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els models propis d’Euphona de timbre, soltesa i qualitat de veu es van entrenar amb aquests enregistraments públics. Tot s’executa al teu dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní modely Euphony pro barvu, uvolněnost a kvalitu hlasu byly natrénovány na těchto veřejných nahrávkách. Vše běží přímo ve vašem zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonas egne modeller for klangfarve, lethed og stemmekvalitet er trænet på disse offentlige optagelser. Alt kører på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen Modelle von Euphona für Klangfarbe, Leichtigkeit und Stimmqualität wurden mit diesen öffentlichen Aufnahmen trainiert. Alles läuft auf deinem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δικά του μοντέλα του Euphona για χροιά, άνεση και ποιότητα φωνής εκπαιδεύτηκαν με αυτές τις δημόσιες ηχογραφήσεις. Όλα εκτελούνται στη συσκευή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona’s own timbre, ease and voice quality models were trained on these public recordings. Everything runs on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos propios de Euphona para timbre, soltura y calidad de voz se entrenaron con estas grabaciones públicas. Todo se ejecuta en tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonan omat äänenvärin, vaivattomuuden ja äänenlaadun mallit on opetettu näillä julkisilla äänityksillä. Kaikki toimii laitteellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles de timbre, d’aisance et de qualité vocale d’Euphona ont été entraînés sur ces enregistrements publics. Tout fonctionne sur votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המודלים של Euphona לגוון, לנינוחות ולאיכות הקול אומנו על ההקלטות הציבוריות האלה. הכול פועל במכשיר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona के अपने स्वर-रंग, सहजता और आवाज़ की गुणवत्ता वाले मॉडल इन सार्वजनिक रिकॉर्डिंग पर प्रशिक्षित किए गए हैं। सब कुछ आपके डिवाइस पर चलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonini vlastiti modeli za boju glasa, opuštenost i kvalitetu glasa trenirani su na ovim javnim snimkama. Sve se odvija na vašem uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Euphona saját hangszín-, könnyedség- és hangminőség-modelljeit ezeken a nyilvános felvételeken tanították be. Minden az eszközödön fut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model timbre, kemudahan, dan kualitas suara milik Euphona dilatih dengan rekaman publik ini. Semuanya berjalan di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli di Euphona per timbro, scioltezza e qualità della voce sono stati addestrati con queste registrazioni pubbliche. Tutto funziona sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona 独自の音色・楽さ・声質のモデルは、これらの公開録音で学習されました。すべてお使いのデバイス上で動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona의 음색, 편안함, 음성 품질 모델은 이 공개 녹음들로 학습했어요. 모든 처리는 기기에서 이루어집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model timbre, kemudahan dan kualiti suara Euphona sendiri dilatih menggunakan rakaman awam ini. Semuanya berjalan pada peranti anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonas egne modeller for klangfarge, letthet og stemmekvalitet er trent på disse offentlige opptakene. Alt kjører på enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigen modellen van Euphona voor klankkleur, gemak en stemkwaliteit zijn getraind met deze openbare opnamen. Alles draait op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własne modele Euphony do barwy, swobody i jakości głosu zostały wytrenowane na tych publicznych nagraniach. Wszystko działa na Twoim urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos próprios do Euphona para timbre, leveza e qualidade da voz foram treinados com estas gravações públicas. Tudo roda no seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelele proprii Euphona pentru timbru, ușurință și calitatea vocii au fost antrenate pe aceste înregistrări publice. Totul rulează pe dispozitivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственные модели Euphona для тембра, лёгкости и качества голоса обучены на этих открытых записях. Всё работает на вашем устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastné modely Euphony pre farbu hlasu, uvoľnenosť a kvalitu hlasu boli natrénované na týchto verejných nahrávkach. Všetko prebieha vo vašom zariadení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonini lastni modeli za barvo glasu, sproščenost in kakovost glasu so bili naučeni na teh javnih posnetkih. Vse poteka v vaši napravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonas egna modeller för klangfärg, lätthet och röstkvalitet har tränats på de här offentliga inspelningarna. Allt körs på din enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลสีเสียง ความผ่อนคลาย และคุณภาพเสียงของ Euphona ฝึกจากการบันทึกเสียงสาธารณะเหล่านี้ ทุกอย่างทำงานบนอุปกรณ์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona’nın kendi tını, rahatlık ve ses kalitesi modelleri bu herkese açık kayıtlarla eğitildi. Her şey cihazınızda çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власні моделі Euphona для тембру, легкості й якості голосу навчено на цих відкритих записах. Усе працює на вашому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mô hình âm sắc, độ thoải mái và chất lượng giọng của riêng Euphona được huấn luyện trên những bản ghi âm công khai này. Mọi thứ đều chạy trên thiết bị của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona 自己的音色、轻松度和嗓音质量模型用这些公开录音训练而成，全部在你的设备上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona 自己的音色、輕鬆度和嗓音品質模型是用這些公開錄音訓練而成，全部在你的裝置上執行。"
          }
        }
      }
    },
    "about_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى تسجيلاتك ونتائجك على أجهزتك وفي iCloud الخاص بك."
