    "coach_ex_reading_score_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحليل الكامل يجمع كل المهارات معًا، بالمقياس نفسه الذي يستخدمه تحليل الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una anàlisi completa reuneix totes les habilitats; és la mateixa mesura que Analitzar la veu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úplná analýza spojuje všechny dovednosti; je to stejná míra jako u funkce Analyzovat hlas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fuld analyse samler alle færdigheder, samme mål som Analysér stemmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vollständige Analyse vereint alle Fähigkeiten; sie misst genauso wie „Stimme analysieren“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πλήρης ανάλυση συνδυάζει όλες τις δεξιότητες, με το ίδιο μέτρο της Ανάλυσης φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full analysis brings every skill together, the same measure as Analyze Voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un análisis completo reúne todas las habilidades; es la misma medida que Analizar voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysi analyysi kokoaa kaikki taidot yhteen, samalla mittarilla kuin Analysoi ääni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une analyse complète réunit toutes les compétences, avec la même mesure que Analyser la voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתוח מלא מאחד את כל המיומנויות, באותו מדד של ניתוח קול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा विश्लेषण सारी क्षमताओं को एक साथ लाता है; यह आवाज़ का विश्लेषण वाला ही पैमाना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuna analiza povezuje sve vještine, ista mjera kao Analiziraj glas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
