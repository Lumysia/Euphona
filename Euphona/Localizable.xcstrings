    "dashboard_metric_composite_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجمع الدرجة الإجمالية جرس الصوت ودرجته والانسيابية والارتياح في رقم واحد لهدفك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuació global reuneix timbre, to, ritme i soltesa en un sol número per al teu objectiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celkové skóre spojuje barvu, výšku hlasu, plynulost a uvolněnost do jednoho čísla pro váš cíl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den samlede score samler klangfarve, tonehøjde, flow og lethed i ét tal for dit mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesamtwert fasst Klangfarbe, Tonhöhe, Sprechfluss und Leichtigkeit in einer Zahl für dein Ziel zusammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνολική βαθμολογία συνδυάζει χροιά, τονικό ύψος, ροή και άνεση σε έναν αριθμό για τον στόχο σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The overall score brings timbre, pitch, flow and ease together into one number for your goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuación global reúne timbre, tono, ritmo y soltura en un solo número para tu objetivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokonaispisteet yhdistävät äänenvärin, äänenkorkeuden, rytmin ja vaivattomuuden yhdeksi luvuksi tavoitettasi varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le score global réunit timbre, hauteur, fluidité et aisance en un seul nombre pour votre objectif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הציון הכולל מאחד גוון, גובה קול, שטף ונינוחות למספר אחד עבור היעד שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुल स्कोर स्वर-रंग, पिच, प्रवाह और सहजता को आपके लक्ष्य के लिए एक संख्या में जोड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukupni rezultat povezuje boju glasa, visinu glasa, tijek govora i opuštenost u jedan broj za vaš cilj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összpontszám a hangszínt, a hangmagasságot, a beszédfolyamot és a könnyedséget egyetlen számba foglalja a célodhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skor keseluruhan menyatukan timbre, nada, kelancaran, dan kemudahan menjadi satu angka untuk tujuan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il punteggio complessivo riunisce timbro, tono, ritmo e scioltezza in un solo numero per il tuo obiettivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "総合スコアは、音色、ピッチ、流れ、楽さを、あなたの目標に向けた 1 つの数値にまとめたものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종합 점수는 음색, 음높이, 흐름, 편안함을 내 목표에 맞춰 하나의 숫자로 합친 값이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skor keseluruhan menggabungkan timbre, nada, kelancaran dan kemudahan menjadi satu nombor untuk matlamat anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den samlede poengsummen setter sammen klangfarge, tonehøyde, flyt og letthet til ett tall for målet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De totaalscore brengt klankkleur, toonhoogte, vloeiendheid en gemak samen in één getal voor je doel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocena ogólna łączy barwę, wysokość głosu, płynność i swobodę w jedną liczbę dla Twojego celu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pontuação geral reúne timbre, tom, ritmo e leveza em um só número para a sua meta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorul general reunește timbrul, înălțimea tonului, fluiditatea și ușurința într-un singur număr pentru obiectivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общая оценка объединяет тембр, высоту тона, плавность и лёгкость в одно число для вашей цели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celkové skóre spája farbu hlasu, výšku hlasu, tok reči a uvoľnenosť do jedného čísla pre váš cieľ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupni rezultat združi barvo glasu, višino glasu, tok govora in sproščenost v eno številko za vaš cilj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalpoängen sammanför klangfärg, tonhöjd, flyt och lätthet till ett enda tal för ditt mål."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คะแนนรวมนำสีเสียง ระดับเสียง ความลื่นไหล และความผ่อนคลายมารวมเป็นตัวเลขเดียวสำหรับเป้าหมายของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel puan; tını, perde, akış ve rahatlığı hedefiniz için tek bir sayıda toplar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загальна оцінка поєднує тембр, висоту тону, плавність і легкість в одне число для вашої цілі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điểm tổng gộp âm sắc, cao độ, độ trôi chảy và độ thoải mái thành một con số cho mục tiêu của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合分把音色、音高、流畅度和轻松度合成一个面向你目标的数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綜合分把音色、音高、流暢度和輕鬆度合成一個針對你目標的數字。"
          }
        }
      }
    },
