        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwolnij trochę; przy szybkim tempie rezonans ucieka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacelere um pouco; a pressa faz a ressonância escapar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încetinește puțin; viteza face rezonanța să alunece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите чуть медленнее; на скорости резонанс ускользает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochu spomaľte; rýchlosť rezonanciu rozkolíše."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekoliko upočasnite; hitrost poruši resonanco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakta ner lite. Hög fart får resonansen att glida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช้าลงอีกนิด ความเร็วทำให้เรโซแนนซ์หลุดง่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz yavaşlayın; hız rezonansın kaymasına yol açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говоріть трохи повільніше; на швидкості резонанс вислизає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chậm lại một chút; nói nhanh làm cộng hưởng tuột mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍微放慢，语速快了共鸣容易跑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍微放慢，語速快了共鳴容易跑掉。"
          }
        }
      }
    },
