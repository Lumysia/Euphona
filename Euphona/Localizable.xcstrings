    "score_focus_flow" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن الحفاظ على إيقاع متساوٍ: القراءة بسرعتك الخاصة والتوقف حيث يتوقف النص، دون توقفات طويلة أو استعجال. الأسلوب البطيء الهادئ لا يكلّف شيئًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén un pas uniforme: llegeix a la teva velocitat i fes pauses on les fa el text, sense aturades llargues ni pressa. Un estil lent i tranquil no resta res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte vyrovnané tempo: čtěte svým tempem a dělejte pauzy tam, kde je dělá text, bez dlouhých zastavení a spěchu. Pomalý, klidný styl nestojí nic."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold et jævnt tempo: Læs i din egen hastighed, og hold pause, hvor teksten gør det, uden lange stop eller hastværk. En langsom, rolig stil koster ingenting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein gleichmäßiges Tempo: Lies in deiner eigenen Geschwindigkeit und mach Pausen, wo der Text sie vorgibt, ohne lange Stopps oder Hetzen. Ein langsamer, ruhiger Stil kostet nichts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε ομοιόμορφο ρυθμό: διαβάστε με τη δική σας ταχύτητα και κάντε παύση όπου την κάνει το κείμενο, χωρίς μεγάλες στάσεις ή βιασύνη. Ένα αργό, ήρεμο στιλ δεν κοστίζει τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep an even pace: read at your own speed and pause where the text does, without long stops or rushing. A slow, calm style costs nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén un paso parejo: lee a tu velocidad y haz pausas donde las hace el texto, sin paradas largas ni prisas. Un estilo lento y tranquilo no resta nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä tahti tasaisena: lue omalla nopeudellasi ja tauota siellä, missä tekstikin, ilman pitkiä taukoja tai kiirehtimistä. Hidas, rauhallinen tyyli ei maksa mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez un rythme régulier : lisez à votre propre vitesse et marquez une pause là où le texte en fait une, sans longs arrêts ni précipitation. Un style lent et calme ne coûte rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לשמור על קצב אחיד: לקרוא במהירות שלך ולעצור במקומות שבהם הטקסט עוצר, בלי עצירות ארוכות או מהירות יתר. סגנון איטי ורגוע לא עולה בכלום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गति एक-सी रखें: अपनी रफ़्तार से पढ़ें और जहाँ पाठ रुकता है वहीं रुकें, लंबे रुकाव या जल्दबाज़ी के बिना। धीमी, शांत शैली से कुछ नहीं कटता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite ujednačen tempo: čitajte svojom brzinom i stanite tamo gdje staje tekst, bez dugih stanki i žurbe. Spor, miran stil ne košta ništa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd egyenletesen a tempót: olvass a saját sebességeddel, és ott tarts szünetet, ahol a szöveg is, hosszú megállások és sietés nélkül. A lassú, nyugodt stílus nem kerül semmibe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga tempo tetap merata: bacalah dengan kecepatan Anda sendiri dan berhentilah di tempat teks berhenti, tanpa jeda panjang atau terburu-buru. Gaya yang lambat dan tenang tidak mengurangi apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni un’andatura regolare: leggi alla tua velocità e fai pause dove le fa il testo, senza pause lunghe né fretta. Uno stile lento e calmo non costa nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定のペースを保ちましょう。自分の速さで読み、文章の区切りで止まり、長く止まったり急いだりしないようにします。ゆっくり落ち着いた話し方は減点されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 속도를 유지하세요. 자기 속도로 읽고, 글이 쉬는 곳에서 쉬되, 오래 멈추거나 서두르지 마세요. 느리고 차분한 말투는 감점되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalkan kadar yang sekata: baca pada kelajuan anda sendiri dan berhenti di tempat teks berhenti, tanpa hentian panjang atau tergesa-gesa. Gaya yang perlahan dan tenang tidak menjejaskan apa-apa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold et jevnt tempo: Les i din egen hastighet og ta pause der teksten har pause, uten lange stopp eller hastverk. En langsom, rolig stil koster ingenting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een gelijkmatig tempo aan: lees op je eigen snelheid en pauzeer waar de tekst dat doet, zonder lange stops of haast. Een langzame, rustige stijl kost niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj równe tempo: czytaj we własnym tempie i rób przerwy tam, gdzie robi je tekst, bez długich przestojów i pośpiechu. Wolny, spokojny styl nic nie kosztuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um andamento constante: leia na sua velocidade e pause onde o texto pausa, sem paradas longas nem pressa. Um jeito lento e calmo não custa nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează un ritm egal: citește în ritmul tău și fă pauze acolo unde le face textul, fără opriri lungi sau grabă. Un stil lent și calm nu costă nimic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите ровный темп: читайте в своей скорости и делайте паузы там, где их делает текст, без долгих остановок и спешки. Медленная спокойная манера ничего не стоит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte rovnomerné tempo: čítajte vlastnou rýchlosťou a robte pauzy tam, kde ich robí text, bez dlhých zastavení a ponáhľania. Pomalý, pokojný štýl nič nestojí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranjajte enakomeren tempo: berite s svojo hitrostjo in delajte premore tam, kjer jih dela besedilo, brez dolgih premorov in hitenja. Počasen, miren slog ne stane nič."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll en jämn takt: läs i din egen hastighet och gör paus där texten gör det, utan långa stopp eller hets. En långsam, lugn stil kostar ingenting."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รักษาจังหวะให้สม่ำเสมอ: อ่านด้วยความเร็วของคุณเอง และหยุดตรงที่ข้อความหยุด โดยไม่หยุดนานหรือรีบ สไตล์ที่ช้าและสงบไม่เสียคะแนน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenli bir hız tutun: kendi hızınızda okuyun ve metnin durduğu yerde durun; uzun duraklar ya da acele olmasın. Yavaş, sakin bir tarz hiçbir şeye mal olmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте рівний темп: читайте у своїй швидкості й робіть паузи там, де їх робить текст, без довгих зупинок і поспіху. Повільна спокійна манера нічого не коштує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ tốc độ đều: đọc với tốc độ của riêng bạn và nghỉ ở chỗ văn bản nghỉ, không ngừng quá lâu cũng không vội. Phong cách chậm, bình tĩnh không bị trừ điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持均匀的节奏：按自己的语速朗读，在文字该停的地方停一下，不要长时间停顿，也不要赶。慢而平稳的风格不扣分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持均勻的節奏：按自己的語速朗讀，在文字該停的地方停一下，不要長時間停頓，也不要趕。慢而平穩的風格不扣分。"
          }
        }
      }
    },
