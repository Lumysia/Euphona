        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen geschriebenen Rückmeldungen von Euphona. Übungen und Messungen sind bei jeder Wahl gleich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δικές του γραπτές αξιολογήσεις του Euphona. Οι ασκήσεις και οι μετρήσεις είναι ίδιες με κάθε επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona’s own written reviews. Exercises and measurements are the same with every choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoraciones escritas propias de Euphona. Los ejercicios y las mediciones son los mismos con cualquier opción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
