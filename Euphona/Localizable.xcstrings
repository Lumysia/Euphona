    "coach_ex_pitch_siren_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانزلاق عبر مداك الصوتي يمدّ العضلات المسؤولة عن درجة الصوت ويعلّم التحكم فيها كلها، لا عند نغمة واحدة فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lliscar per tot el teu rang estira els músculs que fixen el to i t’ensenya a controlar-lo en tot ell, no només en una nota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klouzání celým rozsahem protahuje svaly určující výšku a učí kontrole napříč celou její délkou, ne jen na jednom tónu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du glider gennem hele dit omfang, strækkes de muskler, der styrer tonehøjden, og du lærer kontrol over det hele, ikke kun på én tone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gleiten durch deinen Stimmumfang dehnt die Muskeln, die die Tonhöhe steuern, und schult die Kontrolle über den gesamten Bereich, nicht nur bei einem Ton."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το γλίστρημα σε όλο το εύρος τεντώνει τους μύες που ρυθμίζουν το τονικό ύψος και διδάσκει έλεγχο σε όλο το φάσμα, όχι μόνο σε μία νότα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliding through your range stretches the muscles that set pitch and teaches control across all of it, not just at one note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizarte por todo tu rango estira los músculos que fijan el tono y enseña a controlarlo en todo él, no solo en una nota."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liukuminen koko äänialan läpi venyttää äänenkorkeutta säätäviä lihaksia ja opettaa hallintaa koko alueella, ei vain yhdellä äänellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisser dans toute votre tessiture étire les muscles qui règlent la hauteur et apprend à la contrôler partout, pas seulement sur une note."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלקה לאורך כל הטווח מותחת את השרירים הקובעים את גובה הקול ומלמדת שליטה בכולו, ולא רק בצליל אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी रेंज में फिसलने से पिच तय करने वाली मांसपेशियाँ खिंचती हैं और सिर्फ़ एक सुर पर नहीं, पूरी रेंज में नियंत्रण आता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klizanje kroz cijeli raspon rasteže mišiće koji određuju visinu glasa i uči kontroli u cijelom rasponu, a ne samo na jednom tonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tartományon végigcsúszás megnyújtja a hangmagasságot szabályozó izmokat, és az egész tartományban tanít kontrollt, nem csak egyetlen hangon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meluncur melintasi jangkauan suara meregangkan otot yang menentukan nada dan melatih kendali di seluruhnya, bukan hanya pada satu nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scivolare lungo tutta l’estensione allunga i muscoli che regolano il tono e insegna a controllarlo in tutta l’estensione, non solo su una nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音域全体を滑らせると、ピッチを決める筋肉がほぐれ、1 つの音だけでなく全域でコントロールできるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음역을 미끄러지듯 오가면 음높이를 정하는 근육이 풀리고, 한 음만이 아니라 전체 범위에서 조절하는 법을 익힐 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meluncur merentasi julat suara meregangkan otot yang menentukan nada dan melatih kawalan merentasinya, bukan hanya pada satu nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å gli gjennom hele stemmeomfanget tøyer musklene som styrer tonehøyden, og lærer deg kontroll over hele omfanget, ikke bare på én tone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glijden door je bereik rekt de spieren die de toonhoogte bepalen en leert je die over het hele bereik te beheersen, niet alleen bij één toon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwanie głosu przez cały zakres rozciąga mięśnie ustawiające wysokość i uczy kontroli na całej jej długości, nie tylko na jednym dźwięku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar por toda a sua extensão alonga os músculos que definem o tom e ensina o controle em toda ela, não só em uma nota."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alunecarea prin registrul tău întinde mușchii care stabilesc înălțimea și te învață controlul pe tot intervalul, nu doar la o notă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скольжение по всему диапазону растягивает мышцы, задающие высоту тона, и учит управлять ею на всём протяжении, а не только на одной ноте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kĺzanie celým rozsahom preťahuje svaly, ktoré určujú výšku hlasu, a učí ovládanie v celom rozsahu, nielen na jednom tóne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drsenje po vsem obsegu razteguje mišice, ki določajo višino glasu, in uči nadzora po celotnem obsegu, ne le pri eni noti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du glider genom hela ditt register töjs musklerna som styr tonhöjden, och du lär dig kontroll över hela omfånget, inte bara på en ton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเลื่อนเสียงตลอดช่วงเสียงช่วยยืดกล้ามเนื้อที่กำหนดระดับเสียง และสอนให้ควบคุมได้ทั่วทั้งช่วง ไม่ใช่แค่ที่โน้ตเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aralığınız boyunca kaymak, perdeyi belirleyen kasları gerer ve yalnızca tek bir notada değil, tamamında kontrol öğretir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ковзання всім діапазоном розтягує м’язи, що задають висоту тону, і вчить керувати нею на всьому протязі, а не лише на одній ноті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lướt qua toàn bộ quãng giọng giúp giãn các cơ quyết định cao độ và dạy bạn kiểm soát trên cả quãng, không chỉ ở một nốt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在音域里滑动能拉伸控制音高的肌肉，让你在整个范围里都能控制，而不只是一个音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在音域裡滑動能伸展控制音高的肌肉，讓你在整個範圍裡都能控制，而不只是一個音。"
          }
        }
      }
    },
    "coach_ex_question_rise_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. طرح أسئلة قصيرة: «حقًّا؟»، «هل هذا مؤكد؟»، «هل هو اليوم؟»\n2. ترك كل سؤال يرتفع وينخفض مع النطاق.\n3. الحفاظ على الاسترخاء وأسلوب المحادثة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Fes preguntes curtes: «De debò?», «Segur?», «És avui?»\n2. Deixa que cadascuna pugi i baixi amb la franja.\n3. Mantén un to relaxat i de conversa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pokládejte krátké otázky: „Opravdu?“, „Jistě?“, „Je to dnes?“\n2. Nechte každou stoupat a klesat s pásmem.\n3. Mluvte uvolněně, konverzačním tónem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Stil korte spørgsmål: »Virkelig?«, »Er du sikker?«, »Er det i dag?«\n2. Lad hvert spørgsmål stige og falde med båndet.\n3. Hold det afslappet og samtaleagtigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Stelle kurze Fragen: „Wirklich?“, „Bist du sicher?“, „Ist es heute?“\n2. Lass jede mit dem Band steigen und fallen.\n3. Bleib entspannt und sprich wie im Gespräch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Κάντε σύντομες ερωτήσεις: «Αλήθεια;», «Είστε σίγουροι;», «Είναι σήμερα;»\n2. Αφήστε την καθεμία να ανεβαίνει και να κατεβαίνει με τη ζώνη.\n3. Μείνετε χαλαρά και συνομιλητικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ask short questions: “Really?”, “Are you sure?”, “Is it today?”\n2. Let each one rise and fall with the band.\n3. Keep it relaxed and conversational."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Haz preguntas cortas: «¿De verdad?», «¿Seguro?», «¿Es hoy?»\n2. Deja que cada una suba y baje con la banda.\n3. Mantén un tono relajado y conversacional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kysy lyhyitä kysymyksiä: ”Oikeastiko?”, ”Oletko varma?”, ”Onko se tänään?”\n2. Anna jokaisen nousta ja laskea alueen mukana.\n3. Pidä se rentona ja keskustelevana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Posez des questions courtes : « Vraiment ? », « C’est certain ? », « C’est pour aujourd’hui ? »\n2. Laissez chacune monter et descendre avec la bande.\n3. Gardez un ton détendu, celui de la conversation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לשאול שאלות קצרות: “באמת?”, “בטוח?”, “זה היום?”\n2. לתת לכל אחת לעלות ולרדת עם הטווח.\n3. להישאר רגועים וטבעיים, כמו בשיחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. छोटे सवाल पूछें: “सच में?”, “पक्का?”, “क्या आज ही?”\n2. हर सवाल को दायरे के साथ उठने और गिरने दें।\n3. आराम से, बातचीत के लहजे में रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Postavljajte kratka pitanja: „Stvarno?“, „Sigurno?“, „Je li to danas?“\n2. Svako neka se podigne i spusti s pojasom.\n3. Neka bude opušteno i razgovorno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tegyél fel rövid kérdéseket: „Tényleg?”, „Biztos?”, „Ma van?”\n2. Mindegyik emelkedjen és essen a sávval.\n3. Maradj laza és beszélgetős."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ajukan pertanyaan pendek: “Benarkah?”, “Yakin?”, “Hari ini?”\n2. Biarkan masing-masing naik dan turun mengikuti rentang.\n3. Tetap santai dan seperti bercakap-cakap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Fai domande brevi: «Davvero?», «Certo?», «È oggi?»\n2. Lascia che ognuna salga e scenda con la fascia.\n3. Mantieni un tono rilassato e colloquiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 短い質問をします。「本当に？」「間違いない？」「今日なの？」\n2. 範囲に合わせて、それぞれの語尾を上げて下げます。\n3. 会話のように、リラックスして行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 짧은 질문을 해 보세요. “정말요?”, “확실해요?”, “오늘이에요?”\n2. 각 질문이 범위를 따라 올라갔다 내려오게 하세요.\n3. 편안하게, 대화하듯 하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tanya soalan pendek: “Betulkah?”, “Pasti?”, “Hari ini?”\n2. Biarkan setiap satu naik dan turun mengikut julat.\n3. Kekal santai dan seperti berbual."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Still korte spørsmål: «Virkelig?», «Er du sikker?», «Er det i dag?»\n2. La hvert spørsmål stige og falle med båndet.\n3. Hold det avslappet og samtalepreget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Stel korte vragen: “Echt?”, “Weet je het zeker?”, “Is het vandaag?”\n2. Laat elke vraag met de band stijgen en dalen.\n3. Houd het ontspannen en gesprekachtig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zadawaj krótkie pytania: „Naprawdę?”, „Na pewno?”, „Czy to dzisiaj?”\n2. Pozwól każdemu unosić się i opadać razem z pasmem.\n3. Mów swobodnie, jak w rozmowie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Faça perguntas curtas: “Sério?”, “Tem certeza?”, “É hoje?”\n2. Deixe cada uma subir e descer com a faixa.\n3. Mantenha um jeito relaxado, de conversa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pune întrebări scurte: „Serios?”, „Chiar așa?”, „E azi?”\n2. Lasă fiecare să urce și să coboare odată cu banda.\n3. Păstrează un ton relaxat, de conversație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Задавайте короткие вопросы: «Правда?», «Вы уверены?», «Это сегодня?»\n2. Пусть каждый поднимается и опускается вместе с полосой.\n3. Говорите расслабленно, как в разговоре."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pýtajte sa krátke otázky: „Naozaj?“, „Určite?“, „Je to dnes?“\n2. Nechajte každú stúpať a klesať s pásmom.\n3. Hovorte uvoľnene a konverzačne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Postavljajte kratka vprašanja: „Res?“, „Zagotovo?“, „Je to danes?“\n2. Vsako pustite, da se dvigne in spusti s pasom.\n3. Ostanite sproščeni in pogovorni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ställ korta frågor: ”Verkligen?”, ”Är du säker?”, ”Är det i dag?”\n2. Låt varje fråga stiga och sjunka med bandet.\n3. Håll det avslappnat och samtalsnära."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ถามคำถามสั้นๆ: “จริงหรือ” “แน่ใจไหม” “วันนี้ใช่ไหม”\n2. ให้แต่ละประโยคขึ้นและลงไปตามแถบ\n3. ผ่อนคลายและพูดเหมือนคุยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kısa sorular sorun: “Gerçekten mi?”, “Emin misiniz?”, “Bugün mü?”\n2. Her birinin bantla birlikte yükselip alçalmasına izin verin.\n3. Rahat ve sohbet havasında kalın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ставте короткі запитання: «Справді?», «Ви впевнені?», «Це сьогодні?»\n2. Нехай кожне піднімається й опускається разом зі смугою.\n3. Говоріть розслаблено, як у розмові."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hỏi những câu ngắn: “Thật không?”, “Bạn chắc chứ?”, “Hôm nay à?”\n2. Để mỗi câu lên rồi xuống theo dải.\n3. Giữ thoải mái, như đang trò chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 问一些短问题：“真的吗？”“你确定？”“是今天吗？”\n2. 让每一句跟着范围上扬再落下。\n3. 保持放松，像在聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 問一些短問題：「真的嗎？」「你確定嗎？」「是今天嗎？」\n2. 讓每一句跟著範圍上揚再落下。\n3. 保持放鬆，像在聊天。"
          }
        }
      }
    },
    "coach_ex_question_rise_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن ترك الصوت يتحرك؛ الارتفاع انزلاق لا قفزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa que la veu es mogui; una pujada és un lliscament, no un salt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte hlas pohybovat se; stoupnutí je klouzání, ne skok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad stemmen bevæge sig. En stigning er en glidning, ikke et spring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Stimme sich bewegen; ein Anstieg ist ein Gleiten, kein Sprung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε τη φωνή να κινείται· η άνοδος είναι γλίστρημα, όχι άλμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the voice move; a rise is a glide, not a jump."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la voz se mueva; una subida es un deslizamiento, no un salto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna äänen liikkua. Nousu on liuku, ei hyppy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la voix bouger ; une montée est un glissement, pas un saut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לתת לקול לנוע; עלייה היא החלקה, לא קפיצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ को चलने दें; ऊपर उठना फिसलना है, छलाँग नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustite glas da se kreće; podizanje je klizanje, a ne skok."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyd mozogni a hangot; az emelkedés csúszás, nem ugrás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan suara bergerak; naik itu meluncur, bukan melompat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che la voce si muova; una salita è uno scivolamento, non un salto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声を動かしましょう。上昇は跳ぶのではなく、滑らせるものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리가 움직이게 두세요. 올라가는 것은 미끄러지는 것이지, 뛰어오르는 것이 아니에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan suara bergerak; naik ialah meluncur, bukan melompat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stemmen bevege seg. En stigning er et glid, ikke et hopp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je stem bewegen; een stijging is een glijbeweging, geen sprong."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól głosowi się poruszać; wzrost to przesunięcie, nie skok."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a voz se mover; uma subida é um deslizar, não um salto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă vocea să se miște; o urcare este o alunecare, nu un salt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте голосу двигаться; подъём — это скольжение, а не прыжок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechajte hlas pohybovať sa; stúpanie je kĺzanie, nie skok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustite glasu, da se giblje; dvig je drsenje, ne skok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt rösten röra sig. En stigning är ett glid, inte ett hopp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปล่อยให้เสียงเคลื่อนไหว การขึ้นเสียงคือการเลื่อน ไม่ใช่การกระโดด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesin hareket etmesine izin verin; yükseliş bir kayıştır, sıçrama değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте голосу рухатися; підйом — це ковзання, а не стрибок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để giọng chuyển động; lên giọng là lướt lên, không phải nhảy lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让声音动起来，上扬是滑上去，不是跳上去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓聲音動起來，上揚是滑上去，不是跳上去。"
          }
        }
      }
    },
