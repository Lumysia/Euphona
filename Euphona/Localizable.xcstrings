    "score_components_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرس الصوت والارتياح من نماذج Euphona، والانسيابية من إيقاعك وتوقفاتك. درجة الصوت هي درجة كلامك المعتادة (الوسيط)، وتُحسب بالتساوي بأنصاف النغمات من الكلام الذكوري المعتاد (115 هرتز) إلى الكلام الأنثوي المعتاد (205 هرتز)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El timbre i la soltesa vénen dels models d’Euphona, el ritme de la teva velocitat i les teves pauses. El to és el teu to habitual en parlar (la mediana), comptat de manera uniforme en semitons des de la parla masculina típica (115 Hz) fins a la parla femenina típica (205 Hz)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva a uvolněnost pocházejí z modelů Euphony, plynulost z vašeho tempa a pauz. Výška hlasu je vaše typická výška při řeči (medián), počítaná rovnoměrně v půltónech od typické mužské řeči (115 Hz) po typickou ženskou řeč (205 Hz)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarve og lethed kommer fra Euphonas modeller, flow fra dit tempo og dine pauser. Tonehøjde er din typiske taletonehøjde (medianen), regnet jævnt i halvtoner fra typisk maskulin tale (115 Hz) til typisk feminin tale (205 Hz)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarbe und Leichtigkeit stammen aus den Modellen von Euphona, der Sprechfluss aus deinem Tempo und deinen Pausen. Die Tonhöhe ist deine typische Sprechtonhöhe (der Median), gleichmäßig in Halbtönen gezählt von typischer männlicher Sprechstimme (115 Hz) bis zu typischer weiblicher Sprechstimme (205 Hz)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χροιά και η άνεση προέρχονται από τα μοντέλα του Euphona, η ροή από τον ρυθμό και τις παύσεις σας. Το τονικό ύψος είναι το τυπικό τονικό ύψος ομιλίας σας (η διάμεσος), μετρημένο ομοιόμορφα σε ημιτόνια από την τυπική αρσενική ομιλία (115 Hz) έως την τυπική θηλυκή ομιλία (205 Hz)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre and ease come from Euphona’s models, flow from your pace and pauses. Pitch is your typical speaking pitch (the median), counted evenly in semitones from typical masculine speech (115 Hz) to typical feminine speech (205 Hz)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El timbre y la soltura vienen de los modelos de Euphona, el ritmo de tu velocidad y tus pausas. El tono es tu tono habitual al hablar (la mediana), contado de forma uniforme en semitonos desde el habla masculina típica (115 Hz) hasta el habla femenina típica (205 Hz)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenväri ja vaivattomuus tulevat Euphonan malleista, rytmi tahdistasi ja tauoistasi. Äänenkorkeus on tyypillinen puheesi äänenkorkeus (mediaani), laskettuna tasaisesti puolisävelaskelina tyypillisestä maskuliinisesta puheesta (115 Hz) tyypilliseen feminiiniseen puheeseen (205 Hz)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timbre et l’aisance viennent des modèles d’Euphona, la fluidité de votre rythme et de vos pauses. La hauteur est votre hauteur de parole habituelle (la médiane), comptée de façon régulière en demi-tons, de la parole masculine typique (115 Hz) à la parole féminine typique (205 Hz)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גוון ונינוחות מגיעים מהמודלים של Euphona, שטף מהקצב וההפסקות שלך. גובה הקול הוא גובה הדיבור האופייני שלך (החציון), הנספר באופן אחיד בחצאי טונים מדיבור גברי אופייני (115 Hz) עד דיבור נשי אופייני (205 Hz)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वर-रंग और सहजता Euphona के मॉडल से आते हैं, प्रवाह आपकी गति और ठहराव से। पिच आपकी बोलने की सामान्य पिच (माध्यिका) है, जिसे सामान्य पुरुष-स्वर (115 Hz) से सामान्य स्त्री-स्वर (205 Hz) तक सेमीटोन में बराबर गिना जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja glasa i opuštenost dolaze iz Euphoninih modela, tijek govora iz vašeg tempa i stanki. Visina glasa je vaša uobičajena visina govora (medijan), brojena ravnomjerno u polutonovima od tipičnog muškog govora (115 Hz) do tipičnog ženskog govora (205 Hz)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangszín és a könnyedség az Euphona modelljeiből származik, a beszédfolyam a tempódból és a szüneteidből. A hangmagasság a jellemző beszédhangmagasságod (a medián), félhangokban egyenletesen számolva a jellemző férfi beszédtől (115 Hz) a jellemző női beszédig (205 Hz)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre dan kemudahan berasal dari model Euphona, kelancaran dari tempo dan jeda Anda. Nada adalah nada bicara umum Anda (median), dihitung merata dalam semiton dari ucapan maskulin umum (115 Hz) hingga ucapan feminin umum (205 Hz)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbro e scioltezza vengono dai modelli di Euphona, il ritmo dall’andatura e dalle pause. Il tono è il tuo tono tipico del parlato (la mediana), contato in modo uniforme in semitoni dal parlato maschile tipico (115 Hz) al parlato femminile tipico (205 Hz)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色と楽さは Euphona のモデル、流れはペースと間から求めます。ピッチは、話し声の典型的なピッチ（中央値）で、典型的な男性の話し声（115 Hz）から典型的な女性の話し声（205 Hz）まで、半音を単位に均等に数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음색과 편안함은 Euphona의 모델에서, 흐름은 속도와 쉼에서 나와요. 음높이는 말할 때의 대표 음높이(중앙값)이며, 대표적인 남성 음성(115 Hz)에서 대표적인 여성 음성(205 Hz)까지 반음 단위로 고르게 계산해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre dan kemudahan datang daripada model Euphona, kelancaran daripada kadar dan jeda anda. Nada ialah nada pertuturan lazim anda (median), dikira sekata dalam semiton daripada pertuturan maskulin lazim (115 Hz) hingga pertuturan feminin lazim (205 Hz)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarge og letthet kommer fra Euphonas modeller, flyt fra tempoet og pausene dine. Tonehøyde er din typiske taletonehøyde (medianen), regnet jevnt i halvtoner fra typisk maskulin tale (115 Hz) til typisk feminin tale (205 Hz)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klankkleur en gemak komen van de modellen van Euphona, vloeiendheid van je tempo en pauzes. Toonhoogte is je gebruikelijke spreektoonhoogte (de mediaan), gelijkmatig in halve tonen geteld van typische mannelijke spraak (115 Hz) tot typische vrouwelijke spraak (205 Hz)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barwa i swoboda pochodzą z modeli Euphony, płynność — z Twojego tempa i przerw. Wysokość głosu to Twoja typowa wysokość w mowie (mediana), liczona równomiernie w półtonach od typowej mowy męskiej (115 Hz) do typowej mowy kobiecej (205 Hz)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre e leveza vêm dos modelos do Euphona, o ritmo vem do seu andamento e das suas pausas. O tom é o seu tom típico de fala (a mediana), contado de forma uniforme em semitons da fala masculina típica (115 Hz) até a fala feminina típica (205 Hz)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbrul și ușurința vin de la modelele Euphona, fluiditatea din ritmul și pauzele tale. Înălțimea tonului este înălțimea ta obișnuită de vorbire (mediana), numărată uniform în semitonuri de la vorbirea masculină tipică (115 Hz) la vorbirea feminină tipică (205 Hz)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тембр и лёгкость оцениваются моделями Euphona, плавность — по вашему темпу и паузам. Высота тона — это ваша обычная высота речи (медиана), которая считается равномерно в полутонах: от типичной мужской речи (115 Гц) до типичной женской (205 Гц)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farba hlasu a uvoľnenosť vychádzajú z modelov Euphony, tok reči z vášho tempa a pauz. Výška hlasu je vaša typická výška pri reči (medián), počítaná rovnomerne v poltónoch od typickej mužskej reči (115 Hz) po typickú ženskú reč (205 Hz)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva glasu in sproščenost izhajata iz Euphoninih modelov, tok govora iz vašega tempa in premorov. Višina glasu je vaša običajna višina govora (mediana), šteta enakomerno v poltonih od značilnega moškega govora (115 Hz) do značilnega ženskega govora (205 Hz)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfärg och lätthet kommer från Euphonas modeller, flyt från din takt och dina pauser. Tonhöjd är din typiska talhöjd (medianen), räknad jämnt i halvtoner från typiskt maskulint tal (115 Hz) till typiskt feminint tal (205 Hz)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีเสียงและความผ่อนคลายมาจากโมเดลของ Euphona ความลื่นไหลมาจากจังหวะและการหยุดพักของคุณ ระดับเสียงคือระดับเสียงพูดทั่วไปของคุณ (ค่ามัธยฐาน) นับเท่ากันเป็นเซมิโทนจากเสียงพูดชายทั่วไป (115 Hz) ถึงเสียงพูดหญิงทั่วไป (205 Hz)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tını ve rahatlık Euphona’nın modellerinden, akış ise hızınızdan ve duraklarınızdan gelir. Perde, tipik konuşma perdenizdir (medyan); tipik eril konuşmadan (115 Hz) tipik dişil konuşmaya (205 Hz) kadar yarım ton cinsinden eşit sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тембр і легкість оцінюються моделями Euphona, плавність — за вашим темпом і паузами. Висота тону — це ваша звична висота мовлення (медіана), яку рахують рівномірно в півтонах: від типового чоловічого мовлення (115 Гц) до типового жіночого (205 Гц)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm sắc và độ thoải mái đến từ các mô hình của Euphona, độ trôi chảy đến từ tốc độ và quãng nghỉ của bạn. Cao độ là cao độ nói điển hình của bạn (trung vị), tính đều theo nửa cung từ giọng nói nam điển hình (115 Hz) đến giọng nói nữ điển hình (205 Hz)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色和轻松度来自 Euphona 的模型，流畅度来自你的语速和停顿。音高是你说话的典型音高（中位数），从典型男声（115 Hz）到典型女声（205 Hz）按半音均匀计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色和輕鬆度來自 Euphona 的模型，流暢度來自你的語速和停頓。音高是你說話的典型音高（中位數），從典型男聲（115 Hz）到典型女聲（205 Hz）依半音均勻計算。"
          }
        }
      }
    },
    "score_components_footer_masculine" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرس الصوت والارتياح من نماذج Euphona، والانسيابية من إيقاعك وتوقفاتك. درجة الصوت هي درجة كلامك المعتادة (الوسيط)، وتُحسب بالتساوي بأنصاف النغمات من الكلام الأنثوي المعتاد (205 هرتز) نزولًا إلى الكلام الذكوري المعتاد (115 هرتز)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El timbre i la soltesa vénen dels models d’Euphona, el ritme de la teva velocitat i les teves pauses. El to és el teu to habitual en parlar (la mediana), comptat de manera uniforme en semitons des de la parla femenina típica (205 Hz) fins a la parla masculina típica (115 Hz)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva a uvolněnost pocházejí z modelů Euphony, plynulost z vašeho tempa a pauz. Výška hlasu je vaše typická výška při řeči (medián), počítaná rovnoměrně v půltónech od typické ženské řeči (205 Hz) dolů k typické mužské řeči (115 Hz)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarve og lethed kommer fra Euphonas modeller, flow fra dit tempo og dine pauser. Tonehøjde er din typiske taletonehøjde (medianen), regnet jævnt i halvtoner fra typisk feminin tale (205 Hz) ned til typisk maskulin tale (115 Hz)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarbe und Leichtigkeit stammen aus den Modellen von Euphona, der Sprechfluss aus deinem Tempo und deinen Pausen. Die Tonhöhe ist deine typische Sprechtonhöhe (der Median), gleichmäßig in Halbtönen gezählt von typischer weiblicher Sprechstimme (205 Hz) bis hinunter zu typischer männlicher Sprechstimme (115 Hz)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χροιά και η άνεση προέρχονται από τα μοντέλα του Euphona, η ροή από τον ρυθμό και τις παύσεις σας. Το τονικό ύψος είναι το τυπικό τονικό ύψος ομιλίας σας (η διάμεσος), μετρημένο ομοιόμορφα σε ημιτόνια από την τυπική θηλυκή ομιλία (205 Hz) προς την τυπική αρσενική ομιλία (115 Hz)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre and ease come from Euphona’s models, flow from your pace and pauses. Pitch is your typical speaking pitch (the median), counted evenly in semitones from typical feminine speech (205 Hz) down to typical masculine speech (115 Hz)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El timbre y la soltura vienen de los modelos de Euphona, el ritmo de tu velocidad y tus pausas. El tono es tu tono habitual al hablar (la mediana), contado de forma uniforme en semitonos desde el habla femenina típica (205 Hz) hasta el habla masculina típica (115 Hz)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenväri ja vaivattomuus tulevat Euphonan malleista, rytmi tahdistasi ja tauoistasi. Äänenkorkeus on tyypillinen puheesi äänenkorkeus (mediaani), laskettuna tasaisesti puolisävelaskelina tyypillisestä feminiinisestä puheesta (205 Hz) tyypilliseen maskuliiniseen puheeseen (115 Hz)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timbre et l’aisance viennent des modèles d’Euphona, la fluidité de votre rythme et de vos pauses. La hauteur est votre hauteur de parole habituelle (la médiane), comptée de façon régulière en demi-tons, de la parole féminine typique (205 Hz) à la parole masculine typique (115 Hz)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גוון ונינוחות מגיעים מהמודלים של Euphona, שטף מהקצב וההפסקות שלך. גובה הקול הוא גובה הדיבור האופייני שלך (החציון), הנספר באופן אחיד בחצאי טונים מדיבור נשי אופייני (205 Hz) עד דיבור גברי אופייני (115 Hz)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वर-रंग और सहजता Euphona के मॉडल से आते हैं, प्रवाह आपकी गति और ठहराव से। पिच आपकी बोलने की सामान्य पिच (माध्यिका) है, जिसे सामान्य स्त्री-स्वर (205 Hz) से सामान्य पुरुष-स्वर (115 Hz) तक सेमीटोन में बराबर गिना जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja glasa i opuštenost dolaze iz Euphoninih modela, tijek govora iz vašeg tempa i stanki. Visina glasa je vaša uobičajena visina govora (medijan), brojena ravnomjerno u polutonovima od tipičnog ženskog govora (205 Hz) prema dolje do tipičnog muškog govora (115 Hz)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangszín és a könnyedség az Euphona modelljeiből származik, a beszédfolyam a tempódból és a szüneteidből. A hangmagasság a jellemző beszédhangmagasságod (a medián), félhangokban egyenletesen számolva a jellemző női beszédtől (205 Hz) lefelé a jellemző férfi beszédig (115 Hz)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre dan kemudahan berasal dari model Euphona, kelancaran dari tempo dan jeda Anda. Nada adalah nada bicara umum Anda (median), dihitung merata dalam semiton dari ucapan feminin umum (205 Hz) turun ke ucapan maskulin umum (115 Hz)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbro e scioltezza vengono dai modelli di Euphona, il ritmo dall’andatura e dalle pause. Il tono è il tuo tono tipico del parlato (la mediana), contato in modo uniforme in semitoni dal parlato femminile tipico (205 Hz) al parlato maschile tipico (115 Hz)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色と楽さは Euphona のモデル、流れはペースと間から求めます。ピッチは、話し声の典型的なピッチ（中央値）で、典型的な女性の話し声（205 Hz）から典型的な男性の話し声（115 Hz）まで、半音を単位に均等に数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음색과 편안함은 Euphona의 모델에서, 흐름은 속도와 쉼에서 나와요. 음높이는 말할 때의 대표 음높이(중앙값)이며, 대표적인 여성 음성(205 Hz)에서 대표적인 남성 음성(115 Hz)까지 반음 단위로 고르게 계산해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre dan kemudahan datang daripada model Euphona, kelancaran daripada kadar dan jeda anda. Nada ialah nada pertuturan lazim anda (median), dikira sekata dalam semiton daripada pertuturan feminin lazim (205 Hz) turun ke pertuturan maskulin lazim (115 Hz)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarge og letthet kommer fra Euphonas modeller, flyt fra tempoet og pausene dine. Tonehøyde er din typiske taletonehøyde (medianen), regnet jevnt i halvtoner fra typisk feminin tale (205 Hz) ned til typisk maskulin tale (115 Hz)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klankkleur en gemak komen van de modellen van Euphona, vloeiendheid van je tempo en pauzes. Toonhoogte is je gebruikelijke spreektoonhoogte (de mediaan), gelijkmatig in halve tonen geteld van typische vrouwelijke spraak (205 Hz) omlaag tot typische mannelijke spraak (115 Hz)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barwa i swoboda pochodzą z modeli Euphony, płynność — z Twojego tempa i przerw. Wysokość głosu to Twoja typowa wysokość w mowie (mediana), liczona równomiernie w półtonach od typowej mowy kobiecej (205 Hz) w dół do typowej mowy męskiej (115 Hz)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbre e leveza vêm dos modelos do Euphona, o ritmo vem do seu andamento e das suas pausas. O tom é o seu tom típico de fala (a mediana), contado de forma uniforme em semitons da fala feminina típica (205 Hz) até a fala masculina típica (115 Hz)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbrul și ușurința vin de la modelele Euphona, fluiditatea din ritmul și pauzele tale. Înălțimea tonului este înălțimea ta obișnuită de vorbire (mediana), numărată uniform în semitonuri de la vorbirea feminină tipică (205 Hz) în jos până la vorbirea masculină tipică (115 Hz)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тембр и лёгкость оцениваются моделями Euphona, плавность — по вашему темпу и паузам. Высота тона — это ваша обычная высота речи (медиана), которая считается равномерно в полутонах: от типичной женской речи (205 Гц) вниз до типичной мужской (115 Гц)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farba hlasu a uvoľnenosť vychádzajú z modelov Euphony, tok reči z vášho tempa a pauz. Výška hlasu je vaša typická výška pri reči (medián), počítaná rovnomerne v poltónoch od typickej ženskej reči (205 Hz) dole po typickú mužskú reč (115 Hz)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva glasu in sproščenost izhajata iz Euphoninih modelov, tok govora iz vašega tempa in premorov. Višina glasu je vaša običajna višina govora (mediana), šteta enakomerno v poltonih od značilnega ženskega govora (205 Hz) navzdol do značilnega moškega govora (115 Hz)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfärg och lätthet kommer från Euphonas modeller, flyt från din takt och dina pauser. Tonhöjd är din typiska talhöjd (medianen), räknad jämnt i halvtoner från typiskt feminint tal (205 Hz) ner till typiskt maskulint tal (115 Hz)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีเสียงและความผ่อนคลายมาจากโมเดลของ Euphona ความลื่นไหลมาจากจังหวะและการหยุดพักของคุณ ระดับเสียงคือระดับเสียงพูดทั่วไปของคุณ (ค่ามัธยฐาน) นับเท่ากันเป็นเซมิโทนจากเสียงพูดหญิงทั่วไป (205 Hz) ลงมาถึงเสียงพูดชายทั่วไป (115 Hz)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tını ve rahatlık Euphona’nın modellerinden, akış ise hızınızdan ve duraklarınızdan gelir. Perde, tipik konuşma perdenizdir (medyan); tipik dişil konuşmadan (205 Hz) tipik eril konuşmaya (115 Hz) kadar yarım ton cinsinden eşit sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тембр і легкість оцінюються моделями Euphona, плавність — за вашим темпом і паузами. Висота тону — це ваша звична висота мовлення (медіана), яку рахують рівномірно в півтонах: від типового жіночого мовлення (205 Гц) униз до типового чоловічого (115 Гц)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm sắc và độ thoải mái đến từ các mô hình của Euphona, độ trôi chảy đến từ tốc độ và quãng nghỉ của bạn. Cao độ là cao độ nói điển hình của bạn (trung vị), tính đều theo nửa cung từ giọng nói nữ điển hình (205 Hz) xuống giọng nói nam điển hình (115 Hz)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色和轻松度来自 Euphona 的模型，流畅度来自你的语速和停顿。音高是你说话的典型音高（中位数），从典型女声（205 Hz）到典型男声（115 Hz）按半音均匀计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色和輕鬆度來自 Euphona 的模型，流暢度來自你的語速和停頓。音高是你說話的典型音高（中位數），從典型女聲（205 Hz）到典型男聲（115 Hz）依半音均勻計算。"
          }
        }
      }
    },
