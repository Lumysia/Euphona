    "feedback_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند المتابعة يُفتح GitHub، حيث تنشره من حسابك. المنشورات هناك علنية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuar s’obre GitHub, on el publiques des del teu compte. Les publicacions hi són públiques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračováním se otevře GitHub, kde příspěvek zveřejníte ze svého účtu. Příspěvky tam jsou veřejné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du fortsætter, åbnes GitHub, hvor du slår det op fra din egen konto. Opslag dér er offentlige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fortfahren öffnet sich GitHub, wo du es mit deinem eigenen Konto veröffentlichst. Beiträge dort sind öffentlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζοντας ανοίγει το GitHub, όπου το δημοσιεύετε από τον δικό σας λογαριασμό. Οι δημοσιεύσεις εκεί είναι δημόσιες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuing opens GitHub, where you post it from your own account. Posts there are public."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar se abre GitHub, donde lo publicas desde tu propia cuenta. Allí las publicaciones son públicas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkaminen avaa GitHubin, jossa julkaiset sen omalla tililläsi. Julkaisut siellä ovat julkisia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer ouvre GitHub, où vous le publiez depuis votre propre compte. Les publications y sont publiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשך יפתח את GitHub, שם תפרסמו מהחשבון שלכם. הפרסומים שם ציבוריים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे बढ़ने पर GitHub खुलेगा, जहाँ आप इसे अपने खाते से पोस्ट करेंगे। वहाँ की पोस्ट सार्वजनिक होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavak otvara GitHub, gdje to objavljujete sa svog računa. Objave su ondje javne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folytatás megnyitja a GitHubot, ahol a saját fiókodból teszed közzé. Az ottani bejegyzések nyilvánosak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan akan membuka GitHub, tempat Anda mempostingnya dari akun Anda sendiri. Postingan di sana bersifat publik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
