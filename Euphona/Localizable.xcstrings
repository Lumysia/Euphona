    "onboarding_coach_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم يختار المدرّب درسًا قصيرًا، ويتابع كل محاولة بأدوات Euphona، ويقرر ما يأتي بعد ذلك. ويمكنك اختيار من يكتب مراجعاته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dia el Coach tria una lliçó curta, observa cada intent amb les eines d’Euphona i decideix què ve després. Tria qui escriu les seves valoracions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenér každý den vybere krátkou lekci, sleduje každý pokus pomocí nástrojů Euphony a rozhodne, co bude dál. Vyberte, kdo bude psát jeho hodnocení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag vælger coachen en kort lektion, følger hvert forsøg med Euphonas værktøjer og afgør, hvad der kommer næste gang. Vælg, hvem der skriver vurderingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag wählt der Coach eine kurze Lektion, beobachtet jeden Versuch mit den Werkzeugen von Euphona und entscheidet, was als Nächstes kommt. Wähle, wer die Rückmeldungen schreibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ημέρα ο Coach επιλέγει ένα σύντομο μάθημα, παρακολουθεί κάθε προσπάθεια με τα εργαλεία του Euphona και αποφασίζει τι ακολουθεί. Επιλέξτε ποιος γράφει τις αξιολογήσεις του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day the Coach picks a short lesson, watches each try with Euphona’s tools and decides what comes next. Choose who writes its reviews."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día el Coach elige una lección corta, observa cada intento con las herramientas de Euphona y decide qué viene después. Elige quién escribe sus valoraciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valmentaja valitsee joka päivä lyhyen oppitunnin, seuraa jokaista yritystä Euphonan työkaluilla ja päättää, mitä seuraavaksi tehdään. Valitse, kuka kirjoittaa arviot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour, le coach choisit une courte leçon, observe chaque essai avec les outils d’Euphona et décide de la suite. Choisissez qui rédige ses bilans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בכל יום המאמן בוחר שיעור קצר, עוקב אחרי כל ניסיון בעזרת הכלים של Euphona ומחליט מה הלאה. אפשר לבחור מי יכתוב את הסקירות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोच हर दिन एक छोटा पाठ चुनता है, Euphona के टूल से आपकी हर कोशिश देखता है और तय करता है कि आगे क्या होगा। चुनें कि समीक्षाएँ कौन लिखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trener svaki dan odabire kratku lekciju, prati svaki pokušaj Euphoninim alatima i odlučuje što slijedi. Odaberite tko piše njegove ocjene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az edző minden nap kiválaszt egy rövid leckét, az Euphona eszközeivel figyeli minden próbálkozásodat, és eldönti, mi következik. Válaszd ki, ki írja az értékeléseit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap hari Pelatih memilih pelajaran singkat, mengamati setiap percobaan dengan alat Euphona, dan memutuskan langkah berikutnya. Pilih siapa yang menulis ulasannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno il Coach sceglie una breve lezione, osserva ogni tentativo con gli strumenti di Euphona e decide cosa viene dopo. Scegli chi scrive le sue valutazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチが毎日短いレッスンを選び、Euphona のツールで毎回の挑戦を見て、次に何をするかを決めます。レビューを誰が書くかを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치가 매일 짧은 레슨을 고르고, Euphona의 도구로 매번의 시도를 살펴보며 다음 단계를 정해요. 리뷰를 누가 작성할지 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap hari Jurulatih memilih pelajaran ringkas, memerhati setiap percubaan dengan alat Euphona dan memutuskan apa yang seterusnya. Pilih siapa yang menulis ulasannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag velger coachen en kort leksjon, følger hvert forsøk med Euphonas verktøy og avgjør hva som kommer neste gang. Velg hvem som skriver vurderingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag kiest de coach een korte les, volgt elke poging met de hulpmiddelen van Euphona en beslist wat er daarna komt. Kies wie de beoordelingen schrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdego dnia trener wybiera krótką lekcję, obserwuje każdą próbę za pomocą narzędzi Euphony i decyduje, co dalej. Wybierz, kto pisze jego oceny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo dia o Coach escolhe uma lição curta, acompanha cada tentativa com as ferramentas do Euphona e decide o que vem depois. Escolha quem escreve as avaliações dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În fiecare zi, antrenorul alege o lecție scurtă, urmărește fiecare încercare cu instrumentele Euphona și decide ce urmează. Alege cine scrie evaluările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день тренер выбирает короткий урок, следит за каждой попыткой с помощью инструментов Euphona и решает, что дальше. Выберите, кто будет писать его рецензии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tréner každý deň vyberie krátku lekciu, sleduje každý pokus pomocou nástrojov Euphony a rozhodne, čo bude ďalej. Vyberte, kto bude písať jeho hodnotenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trener vsak dan izbere kratko lekcijo, spremlja vsak poskus z Euphoninimi orodji in odloči, kaj sledi. Izberite, kdo piše njegove ocene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje dag väljer coachen en kort lektion, följer varje försök med Euphonas verktyg och avgör vad som kommer härnäst. Välj vem som skriver omdömena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกวันโค้ชจะเลือกบทเรียนสั้นๆ ดูการลองแต่ละครั้งด้วยเครื่องมือของ Euphona และตัดสินใจว่าจะทำอะไรต่อ เลือกว่าใครจะเขียนรีวิว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koç her gün kısa bir ders seçer, her denemeyi Euphona’nın araçlarıyla izler ve sırada ne olacağına karar verir. Değerlendirmelerini kimin yazacağını seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щодня тренер добирає короткий урок, стежить за кожною спробою за допомогою інструментів Euphona й вирішує, що далі. Виберіть, хто писатиме його огляди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ngày huấn luyện viên chọn một bài học ngắn, theo dõi từng lần thử bằng các công cụ của Euphona và quyết định bước tiếp theo. Hãy chọn ai sẽ viết các nhận xét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练每天安排一节短课，用 Euphona 的工具看你每次尝试，再决定下一步。选择由谁来写点评。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教練每天安排一節短課，用 Euphona 的工具看你每次嘗試，再決定下一步。選擇由誰來寫點評。"
          }
        }
      }
    },
