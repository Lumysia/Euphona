        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringe deine Sprechtonhöhe Stück für Stück näher an das Ziel. Das Werkzeug „Tonhöhe“ zeigt einen Zielbereich, in dem du bleiben kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε το τονικό ύψος ομιλίας προς τον στόχο λίγο λίγο. Το εργαλείο Τονικό ύψος δείχνει ένα εύρος-στόχο για να μένετε μέσα σε αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your speaking pitch toward the goal a little at a time. The Pitch tool shows a target range to stay in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca tu tono al hablar al objetivo poco a poco. La herramienta Tono muestra un rango objetivo en el que mantenerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä puheesi äänenkorkeutta kohti tavoitetta vähän kerrallaan. Äänenkorkeustyökalu näyttää tavoitealueen, jolla pysyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapprochez votre hauteur de parole de l’objectif petit à petit. L’outil Hauteur affiche une plage cible à respecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי להזיז את גובה הקול בדיבור לעבר היעד מעט בכל פעם. כלי גובה הקול מציג טווח יעד להישאר בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलने की पिच को लक्ष्य की ओर थोड़ा-थोड़ा करके ले जाएँ। पिच टूल रहने के लिए एक लक्ष्य दायरा दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomičite visinu glasa pri govoru prema cilju malo po malo. Alat Visina glasa prikazuje ciljni raspon u kojem se treba držati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Told a beszédhangmagasságodat egy kicsit a cél felé. A Hangmagasság eszköz mutatja a célsávot, amelyben maradhatsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan nada bicara Anda ke arah tujuan sedikit demi sedikit. Alat Nada menampilkan rentang target untuk dijaga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvicina il tuo tono di parlato all’obiettivo poco alla volta. Lo strumento Tono mostra una fascia obiettivo in cui restare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話し声のピッチを、少しずつ目標に近づけましょう。ピッチツールには、保つべき目標範囲が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말할 때의 음높이를 목표 쪽으로 조금씩 옮겨 보세요. 음높이 도구에 머물 목표 범위가 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan nada pertuturan anda ke arah matlamat sedikit demi sedikit. Alat Nada menunjukkan julat sasaran untuk dikekalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt taletonehøyden mot målet litt om gangen. Tonehøydeverktøyet viser et målområde du kan holde deg innenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breng je spreektoonhoogte stap voor stap dichter bij het doel. Het hulpmiddel Toonhoogte toont een doelbereik om in te blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwaj wysokość głosu w mowie w stronę celu po trochu. Narzędzie wysokości głosu pokazuje docelowy zakres, w którym warto się trzymać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproxime seu tom de fala da meta aos poucos. A ferramenta Tom mostra uma faixa-alvo para você manter."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apropie înălțimea vorbirii de obiectiv puțin câte puțin. Instrumentul Înălțime arată un interval țintă în care să rămâi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понемногу приближайте высоту тона речи к цели. Инструмент «Высота тона» показывает целевой диапазон, в котором стоит держаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posúvajte výšku hlasu pri reči k cieľu po malých krokoch. Nástroj Výška hlasu zobrazuje cieľový rozsah, v ktorom sa držať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Višino glasu pri govoru postopoma premikajte proti cilju. Orodje Višina glasu prikazuje ciljni obseg, v katerem ostanete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta din talhöjd mot målet lite i taget. Tonhöjdsverktyget visar ett målomfång att hålla sig inom."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขยับระดับเสียงพูดไปทางเป้าหมายทีละนิด เครื่องมือระดับเสียงแสดงช่วงเป้าหมายให้อยู่ในนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma perdenizi hedefe doğru azar azar yaklaştırın. Perde aracı, içinde kalmanız için bir hedef aralık gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потроху наближайте висоту тону мовлення до цілі. Інструмент «Висота тону» показує цільовий діапазон, у якому варто триматися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dịch dần cao độ nói của bạn về phía mục tiêu. Công cụ Cao độ hiển thị một dải mục tiêu để bạn giữ trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一点一点把说话的音高往目标方向移动。“音高”工具会显示一个目标范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一點一點把說話的音高往目標方向移動。「音高」工具會顯示一個目標範圍。"
          }
        }
      }
    },
