    "streak_keep_going" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التدرّب مجددًا غدًا يُبقي السلسلة مستمرة. وفي اليوم المتعب، يُحتسب درس الراحة أيضًا."
