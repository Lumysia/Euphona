        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ขอแค่เบาและสบายก็พอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün her şey yumuşak ve kolay olmakla ilgili."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "М’яко й легко — ось і все завдання на сьогодні."
          }
        },
        "vi" : {
