    "dashboard_metric_variation_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار حركة درجة صوتك أثناء الكلام. الحركة الأكبر تبدو أكثر حيوية؛ والأقل تبدو أكثر ثباتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant es mou el teu to mentre parles. Més moviment sona més viu; menys sona més estable."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak moc se výška hlasu při mluvení pohybuje. Víc pohybu zní živěji; méně zní vyrovnaněji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor meget tonehøjden bevæger sig, mens du taler. Mere bevægelse lyder mere livligt, mindre lyder mere roligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie stark sich deine Tonhöhe beim Sprechen bewegt. Mehr Bewegung klingt lebendiger, weniger klingt ruhiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο κινείται το τονικό ύψος καθώς μιλάτε. Περισσότερη κίνηση ακούγεται πιο ζωντανή· λιγότερη, πιο σταθερή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much your pitch moves while you speak. More movement sounds livelier; less sounds steadier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se mueve tu tono mientras hablas. Más movimiento suena más vivo; menos suena más estable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka paljon äänenkorkeutesi liikkuu puhuessasi. Enemmän liikettä kuulostaa eloisammalta, vähemmän tasaisemmalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien votre hauteur bouge quand vous parlez. Plus de mouvement sonne plus vivant ; moins sonne plus posé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה גובה הקול שלך נע בזמן הדיבור. יותר תנועה נשמעת חיה יותר; פחות נשמעת יציבה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलते समय आपकी पिच कितना चलती है। ज़्यादा चाल से आवाज़ ज़्यादा जीवंत और कम चाल से ज़्यादा स्थिर लगती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko se visina glasa mijenja dok govorite. Više kretanja zvuči življe; manje zvuči mirnije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyit mozog a hangmagasságod beszéd közben. A több mozgás élénkebben hangzik; a kevesebb nyugodtabban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa banyak nada Anda bergerak saat berbicara. Gerak lebih banyak terdengar lebih hidup; lebih sedikit terdengar lebih stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto si muove il tuo tono mentre parli. Più movimento suona più vivace; meno suona più stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話すときにピッチがどれだけ動くか。動きが多いと生き生きと、少ないと落ち着いて聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말할 때 음높이가 얼마나 움직이는지예요. 많이 움직이면 생동감 있게, 적게 움직이면 안정적으로 들려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa banyak nada anda bergerak semasa bertutur. Pergerakan lebih banyak kedengaran lebih bersemangat; lebih sedikit kedengaran lebih mantap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mye tonehøyden beveger seg mens du snakker. Mer bevegelse høres livligere ut, mindre høres roligere ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel je toonhoogte beweegt terwijl je spreekt. Meer beweging klinkt levendiger; minder klinkt rustiger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak bardzo zmienia się wysokość głosu, gdy mówisz. Więcej ruchu brzmi żywiej; mniej — spokojniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o seu tom se move enquanto você fala. Mais movimento soa mais animado; menos soa mais estável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât se mișcă înălțimea ta când vorbești. Mai multă mișcare sună mai vioi; mai puțină sună mai calm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько высота тона меняется, пока вы говорите. Чем больше движения, тем живее звучание; чем меньше, тем оно ровнее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako veľmi sa výška hlasu pri reči mení. Viac pohybu znie živšie; menej znie vyrovnanejšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako zelo se višina glasu spreminja med govorom. Več gibanja zveni živahneje; manj zveni umirjeneje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur mycket tonhöjden rör sig medan du talar. Mer rörelse låter livligare, mindre låter lugnare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระดับเสียงของคุณเคลื่อนไหวมากแค่ไหนขณะพูด เคลื่อนไหวมากฟังดูมีชีวิตชีวากว่า น้อยฟังดูนิ่งกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşurken perdenizin ne kadar hareket ettiği. Daha çok hareket daha canlı, daha azı daha durağan duyulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки висота тону змінюється, поки ви говорите. Чим більше руху, тим жвавіше звучання; чим менше, тим воно рівніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cao độ của bạn thay đổi bao nhiêu khi nói. Thay đổi nhiều nghe sinh động hơn; ít hơn nghe điềm đạm hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说话时音高起伏的幅度。起伏多听起来更生动，少则更平稳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說話時音高起伏的幅度。起伏多聽起來更生動，少則更平穩。"
          }
        }
      }
    },
