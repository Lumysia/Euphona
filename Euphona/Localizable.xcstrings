    "coach_talk_prompt_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصف ما تناولته على الفطور وكيف أعددته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descriu què has esmorzat i com ho has preparat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popište, co bývá k snídani, a jak se to připravuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv, hvad du spiste til morgenmad, og hvordan du lavede det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe, was du zum Frühstück hattest und wie du es zubereitet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιγράψτε τι φάγατε για πρωινό και πώς το φτιάξατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe what you had for breakfast and how you made it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe qué desayunaste y cómo lo preparaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
