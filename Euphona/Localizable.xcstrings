    "coach_ex_pitch_sentences_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العبارات اليومية هي أكثر ما يُستخدم فيه الصوت، لذلك ينتقل التدرّب عليها بأسرع ما يكون إلى الحياة اليومية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frases de cada dia són on més s’usa la veu, així que practicar-les es trasllada més de pressa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běžné fráze jsou místem, kde se hlas používá nejvíc, takže jejich nácvik se do života přenese nejrychleji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hverdagsfraser er det, stemmen bruges mest til, så når du øver dem, slår det hurtigst igennem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alltagssätze sind das, wofür die Stimme am meisten gebraucht wird; deshalb wirkt das Üben damit am schnellsten im Alltag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι καθημερινές φράσεις είναι εκεί όπου χρησιμοποιείται περισσότερο η φωνή, γι' αυτό η εξάσκηση σε αυτές περνά ταχύτερα στην καθημερινότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyday phrases are where the voice is used most, so practising them carries over fastest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las frases cotidianas son donde más se usa la voz, así que practicarlas se traslada más rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiset fraasit ovat se, mihin ääntä käytetään eniten, joten niiden harjoittelu siirtyy nopeimmin arkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les phrases du quotidien sont ce que la voix utilise le plus ; s’y entraîner se transfère donc le plus vite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משפטים יומיומיים הם המקום שבו הקול בשימוש הרב ביותר, ולכן תרגול שלהם עובר הכי מהר אל החיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़मर्रा के वाक्यों में ही आवाज़ सबसे ज़्यादा इस्तेमाल होती है, इसलिए इनका अभ्यास सबसे जल्दी असर दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svakodnevne fraze mjesto su gdje glas najviše koristimo, pa se vježba s njima najbrže prenosi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mindennapi mondatokban használjuk a legtöbbet a hangunkat, ezért a rájuk végzett gyakorlás ültethető át a leggyorsabban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frasa sehari-hari adalah tempat suara paling sering dipakai, jadi melatihnya paling cepat terbawa ke keseharian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le frasi di tutti i giorni sono dove si usa di più la voce, quindi esercitarle si trasferisce più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常のフレーズは声を最もよく使う場面なので、練習の成果が最も早く生活に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일상적인 표현은 목소리를 가장 많이 쓰는 곳이라, 이를 연습하면 가장 빨리 생활에 옮겨져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frasa harian ialah tempat suara paling kerap digunakan, jadi melatihnya paling cepat terbawa ke kehidupan harian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hverdagsfraser er det stemmen brukes mest til, så å øve på dem slår raskest gjennom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alledaagse zinnen zijn waar je stem het meest voor wordt gebruikt, dus daarmee oefenen werkt het snelst door in het dagelijks leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne zwroty to miejsce, gdzie głos pracuje najczęściej, więc ćwiczenie ich najszybciej przenosi się na życie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As frases do dia a dia são onde mais se usa a voz, então praticá-las se transfere mais rápido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frazele de zi cu zi sunt locul unde vocea e folosită cel mai mult, așa că exersarea lor se transferă cel mai repede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повседневные фразы — то, где голос используется чаще всего, поэтому практика на них быстрее всего переносится в жизнь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bežné frázy sú miestom, kde hlas používame najčastejšie, takže ich nácvik sa prenesie najrýchlejšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsakdanje fraze so mesto, kjer glas uporabljamo največ, zato se vaja z njimi najhitreje prenese."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vardagliga fraser är det du använder rösten mest till, så att öva på dem ger snabbast effekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประโยคในชีวิตประจำวันคือที่ที่ใช้เสียงมากที่สุด การฝึกจึงติดตัวเร็วที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük cümleler sesin en çok kullanıldığı yerdir; bu yüzden onlarla çalışmak en hızlı günlük hayata geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повсякденні фрази — це те, де голос використовується найчастіше, тому практика на них найшвидше переходить у життя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những câu nói hằng ngày là nơi giọng được dùng nhiều nhất, nên luyện chúng sẽ đi vào đời sống nhanh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常短句是声音用得最多的地方，所以练它们最快能用到生活里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常短句是聲音用得最多的地方，所以練它們最快能用到生活裡。"
          }
        }
      }
    },
    "coach_ex_pitch_siren_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. بصوت «أوو» أو «نغ»، تتبّع النطاق المتحرك صعودًا ثم هبوطًا.\n2. الانزلاق بسلاسة، دون قفزات أو انقطاع.\n3. إبقاء مستوى الصوت منخفضًا ومتساويًا.\n4. عند القمة، الحفاظ على الخفة بدل الضغط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Amb «uuu» o «ng», segueix la franja en moviment cap amunt i de tornada cap avall.\n2. Llisca amb suavitat, sense salts ni talls.\n3. Mantén el volum suau i uniforme.\n4. A dalt, mantén-te lleuger sense estrènyer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Na „úúú“ nebo „ng“ sledujte pohyblivé pásmo nahoru a zase dolů.\n2. Klouzejte plynule, bez skoků a přerušení.\n3. Držte hlasitost tichou a vyrovnanou.\n4. Nahoře zůstaňte v lehkosti, nestahujte se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. På »ooo« eller »ng« følger du det bevægelige bånd op og ned igen.\n2. Glid jævnt, uden spring eller brud.\n3. Hold lydstyrken lav og jævn.\n4. Deroppe skal du være let i stedet for at presse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Folge auf „uuu“ oder „ng“ dem wandernden Band nach oben und wieder nach unten.\n2. Gleite weich, ohne Sprünge oder Brüche.\n3. Halte die Lautstärke leise und gleichmäßig.\n4. Bleib oben leicht, statt zu pressen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Με «ουου» ή «νγκ», ακολουθήστε την κινούμενη ζώνη προς τα πάνω και πάλι προς τα κάτω.\n2. Γλιστρήστε ομαλά, χωρίς άλματα ή διακοπές.\n3. Κρατήστε την ένταση χαμηλή και σταθερή.\n4. Στην κορυφή μείνετε ελαφριά, χωρίς να σφίγγετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. On “ooo” or “ng”, follow the moving band up and back down.\n2. Glide smoothly, without jumps or breaks.\n3. Keep the volume soft and even.\n4. At the top, stay light rather than squeezing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Con «uuu» o «ng», sigue la banda en movimiento hacia arriba y de vuelta hacia abajo.\n2. Desliza con suavidad, sin saltos ni cortes.\n3. Mantén el volumen suave y parejo.\n4. Arriba, mantente ligero sin apretar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Seuraa liikkuvaa aluetta ylös ja takaisin alas äänellä ”ooo” tai ”ng”.\n2. Liu’u sulavasti ilman hyppyjä tai katkoksia.\n3. Pidä äänenvoimakkuus pehmeänä ja tasaisena.\n4. Ylhäällä pysy kevyenä äläkä purista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sur « ouu » ou « ng », suivez la bande mobile vers le haut puis vers le bas.\n2. Glissez en douceur, sans saut ni rupture.\n3. Gardez un volume doux et régulier.\n4. En haut, gardez de la légèreté sans serrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. עם “אוּוּ” או “נג”, ללכת אחרי הטווח הנע למעלה ושוב למטה.\n2. להחליק ברצף, בלי קפיצות או הפסקות.\n3. לשמור על עוצמה נמוכה ואחידה.\n4. בנקודה הגבוהה להישאר קליל במקום ללחוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “ऊऊऊ” या “ng” पर चलते दायरे के साथ ऊपर और फिर वापस नीचे जाएँ।\n2. बिना छलाँग या टूट के सरलता से फिसलें।\n3. आवाज़ धीमी और एक-सी रखें।\n4. ऊपर पहुँचकर दबाने की बजाय हल्के रहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Na „uuu“ ili „ng“ pratite pokretni pojas prema gore i opet prema dolje.\n2. Kližite glatko, bez skokova i prekida.\n3. Glasnoću držite tihom i ujednačenom.\n4. Na vrhu neka ostane lagano, bez stiskanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. „Úúú” vagy „ng” hangon kövesd a mozgó sávot felfelé és vissza lefelé.\n2. Csúsztass simán, ugrások és szünetek nélkül.\n3. A hangerő legyen halk és egyenletes.\n4. Fent maradj könnyed, ne szorítsd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pada “uuu” atau “ng”, ikuti rentang yang bergerak naik lalu turun kembali.\n2. Luncurkan dengan mulus, tanpa lompatan atau putus.\n3. Jaga volume tetap lembut dan merata.\n4. Di puncak, tetap ringan dan jangan menekan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Con «uuu» o «ng», segui la fascia in movimento verso l’alto e di nuovo verso il basso.\n2. Scivola con dolcezza, senza salti né interruzioni.\n3. Tieni il volume basso e uniforme.\n4. In alto, mantieni leggerezza senza stringere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「ウー」または「ng」で、動く範囲に沿って上がり、また下がります。\n2. 跳んだり途切れたりせず、なめらかに動かします。\n3. 音量は小さく、均一に保ちます。\n4. 高いところでは、締めつけずに軽さを保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “우” 또는 “응”으로, 움직이는 범위를 따라 올라갔다가 다시 내려오세요.\n2. 튀거나 끊기지 않게 매끄럽게 미끄러지세요.\n3. 소리 크기는 작고 고르게 유지하세요.\n4. 높은 곳에서는 쥐어짜지 말고 가볍게 유지하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pada “uuu” atau “ng”, ikut julat yang bergerak naik kemudian turun semula.\n2. Luncur dengan lancar, tanpa lompatan atau putus.\n3. Pastikan kelantangan lembut dan sekata.\n4. Di puncak, kekal ringan dan jangan menghimpit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. På «ooo» eller «ng» følger du det bevegelige båndet opp og ned igjen.\n2. Glid jevnt, uten hopp eller brudd.\n3. Hold volumet lavt og jevnt.\n4. Der oppe skal du være lett i stedet for å presse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Volg op “oe” of “ng” de bewegende band omhoog en weer omlaag.\n2. Glij soepel, zonder sprongen of breuken.\n3. Houd het volume zacht en gelijkmatig.\n4. Blijf bovenaan licht in plaats van te knijpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Na „uuu” lub „ng” podążaj za ruchomym pasmem w górę i z powrotem w dół.\n2. Przesuwaj głos płynnie, bez skoków i przerw.\n3. Utrzymuj ciche i równe natężenie.\n4. Na szczycie utrzymaj lekkość, nie ściskaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Com “uuu” ou “ng”, acompanhe a faixa em movimento para cima e de volta para baixo.\n2. Deslize com suavidade, sem saltos nem quebras.\n3. Mantenha o volume baixo e constante.\n4. No alto, fique leve em vez de apertar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pe „uuu” sau „ng”, urmărește banda mobilă în sus și apoi înapoi în jos.\n2. Alunecă lin, fără salturi sau întreruperi.\n3. Ține volumul încet și egal.\n4. Sus, rămâi ușor în loc să strângi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. На «ууу» или «нг» следуйте за движущейся полосой вверх и обратно вниз.\n2. Скользите плавно, без скачков и разрывов.\n3. Держите громкость тихой и ровной.\n4. На вершине оставайтесь лёгкими, не зажимайтесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Na „úúú“ alebo „ng“ sledujte pohybujúce sa pásmo hore a späť dole.\n2. Kĺžte plynulo, bez skokov a prerušení.\n3. Hlasitosť držte jemnú a rovnomernú.\n4. Hore to nechajte ľahké, nestláčajte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Na „uuu“ ali „ng“ sledite premikajočemu se pasu navzgor in spet navzdol.\n2. Drsite gladko, brez skokov in presledkov.\n3. Glasnost naj bo tiha in enakomerna.\n4. Na vrhu naj ostane lahkotno, ne stiskajte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. På ”ooo” eller ”ng”, följ det rörliga bandet upp och ner igen.\n2. Glid mjukt, utan hopp eller avbrott.\n3. Håll volymen låg och jämn.\n4. Där uppe, var lätt i stället för att pressa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ออกเสียง “อู” หรือ “ng” ตามแถบที่เคลื่อนที่ขึ้นแล้วลงกลับมา\n2. เลื่อนอย่างราบรื่น ไม่กระโดดหรือขาดช่วง\n3. ให้เสียงเบาและสม่ำเสมอ\n4. เมื่อถึงเสียงสูง ให้เบาไว้ อย่าบีบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “Uuu” veya “ng” ile hareket eden bandı yukarı ve tekrar aşağı izleyin.\n2. Sıçrama veya kesinti olmadan yumuşakça kayın.\n3. Ses şiddetini düşük ve düzenli tutun.\n4. Tepede sıkmak yerine hafif kalın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. На «ууу» або «нг» слідуйте за рухомою смугою вгору й назад униз.\n2. Ковзайте плавно, без стрибків і розривів.\n3. Тримайте гучність тихою й рівною.\n4. На вершині лишайтеся легкими, не затискайтеся."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Với “u” hoặc “ng”, bám theo dải đang di chuyển lên rồi xuống lại.\n2. Lướt mượt mà, không nhảy hay ngắt quãng.\n3. Giữ âm lượng nhỏ và đều.\n4. Ở trên cao, hãy giữ nhẹ nhàng thay vì siết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 用“呜”或“嗯（ng）”，跟着移动的范围往上再往下。\n2. 平滑地滑，不要跳音或断开。\n3. 音量保持轻而均匀。\n4. 到高处时保持轻松，不要挤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 用「嗚」或「ng」，跟著移動的範圍往上再往下。\n2. 平滑地滑，不要跳音或斷開。\n3. 音量保持輕而均勻。\n4. 到高處時保持輕鬆，不要擠。"
          }
        }
      }
    },
    "coach_ex_pitch_siren_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن التباطؤ إذا فُقد النطاق؛ السلاسة أهم من الاتساع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves més a poc a poc si perds la franja; la suavitat importa més que l’amplada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpomalte, pokud pásmo ztratíte; plynulost je důležitější než rozsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt tempoet ned, hvis du mister båndet. Jævnt er vigtigere end bredt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werde langsamer, wenn du das Band verlierst; sanft ist wichtiger als weit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβραδύνετε αν χάσετε τη ζώνη· η ομαλότητα μετράει περισσότερο από το εύρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow down if you lose the band; smooth matters more than wide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve más despacio si pierdes la banda; lo suave importa más que lo amplio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidasta, jos menetät alueen. Sulavuus on tärkeämpää kuin laajuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentissez si vous perdez la bande ; mieux vaut fluide que large."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם מאבדים את הטווח, כדאי להאט; חלק חשוב יותר מרחב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दायरा छूट जाए तो धीमे हो जाएँ; चौड़ाई से ज़्यादा सहजता मायने रखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usporite ako izgubite pojas; glatkoća je važnija od raspona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassíts, ha elveszted a sávot; a simaság fontosabb a szélességnél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelankan jika kehilangan rentang; mulus lebih penting daripada lebar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rallenta se perdi la fascia; contano più la dolcezza che l’ampiezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲を見失ったらゆっくりに。広さよりなめらかさが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위를 놓치면 속도를 늦추세요. 넓은 것보다 매끄러운 것이 더 중요해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlahankan jika terlepas julat; kelancaran lebih penting daripada keluasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk tempoet hvis du mister båndet. Jevnt er viktigere enn bredt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga langzamer als je de band kwijtraakt; soepel is belangrijker dan breed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwolnij, jeśli zgubisz pasmo; płynność liczy się bardziej niż rozpiętość."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá mais devagar se perder a faixa; suavidade importa mais que amplitude."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încetinește dacă pierzi banda; lin contează mai mult decât larg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если потеряли полосу, замедлитесь; плавность важнее широты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak pásmo stratíte, spomaľte; plynulosť je dôležitejšia ako rozsah."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upočasnite, če pas izgubite; gladkost je pomembnejša od širine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakta ner om du tappar bandet. Mjukt är viktigare än brett."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าตามแถบไม่ทัน ให้ช้าลง ความราบรื่นสำคัญกว่าช่วงที่กว้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandı kaybederseniz yavaşlayın; geniş olmaktan çok pürüzsüz olmak önemlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо втратили смугу, сповільніться; плавність важливіша за ширину."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chậm lại nếu bạn lạc dải; mượt quan trọng hơn rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟丢了就放慢，平滑比幅度大更重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟丟了就放慢，平滑比幅度大更重要。"
          }
        }
      }
    },
    "coach_ex_pitch_siren_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
