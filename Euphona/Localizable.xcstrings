    "onboarding_preferences_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد هذا ما تستهدفه الدرجات والمدرّب. يمكنك تغييره في أي وقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això fixa cap a on apunten les puntuacions i el coach. Ho pots canviar quan vulguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se určuje, k čemu směřují skóre a trenér. Můžete to kdykoli změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det afgør, hvad scorerne og coachen sigter mod. Du kan til enhver tid ændre det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das bestimmt, worauf Werte und Coach abzielen. Du kannst es jederzeit ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό ορίζει τον στόχο των βαθμολογιών και του Coach. Μπορείτε να το αλλάξετε οποιαδήποτε στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sets what the scores and the coach aim for. You can change it anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto fija a qué apuntan las puntuaciones y el coach. Puedes cambiarlo cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä määrittää, mihin pisteet ja valmentaja tähtäävät. Voit muuttaa sitä milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela détermine l’objectif des scores et du coach. Vous pouvez le modifier à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבחירה קובעת למה הציונים והמאמן מכוונים. אפשר לשנות בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे तय होता है कि स्कोर और कोच किस ओर लक्ष्य रखें। इसे कभी भी बदला जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo određuje čemu teže rezultati i trener. Možete promijeniti u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez határozza meg, mire törekszenek a pontszámok és az edző. Bármikor módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menentukan sasaran skor dan pelatih. Dapat diubah kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo stabilisce a cosa puntano i punteggi e il coach. Puoi cambiarlo in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スコアとコーチが目指す方向を決めます。いつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점수와 코치가 목표로 하는 방향을 정해요. 언제든 바꿀 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menetapkan sasaran skor dan jurulatih. Anda boleh mengubahnya pada bila-bila masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette bestemmer hva poengsummene og coachen sikter mot. Du kan endre det når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bepaalt waar de scores en de coach op mikken. Je kunt het altijd wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustala, do czego dążą wyniki i trener. Możesz to zmienić w dowolnej chwili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso define o que as pontuações e o coach buscam. Você pode mudar quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta stabilește ținta scorurilor și a antrenorului. Poți schimba oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От этого зависит, на что ориентируются оценки и тренер. Это можно изменить в любой момент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podľa toho sa nastavia skóre a ciele trénera. Kedykoľvek to môžete zmeniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To določa, na kaj ciljata rezultata in trener. Kadar koli lahko spremenite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det styr vad poängen och coachen siktar mot. Du kan ändra det när som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเลือกนี้กำหนดว่าคะแนนและโค้ชจะมุ่งไปทางไหน เปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, puanların ve koçun neyi hedeflediğini belirler. İstediğiniz zaman değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від цього залежить, на що орієнтуються оцінки й тренер. Це можна змінити будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lựa chọn này quyết định điều mà điểm số và huấn luyện viên hướng tới. Bạn có thể đổi bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
