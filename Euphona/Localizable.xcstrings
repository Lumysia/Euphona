        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoracions escrites pròpies d’Euphona. Els exercicis i les mesures són els mateixos amb qualsevol opció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní psaná hodnocení Euphony. Cvičení a měření jsou stejná při každé volbě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphonas egne skrevne vurderinger. Øvelser og målinger er de samme uanset valg."
