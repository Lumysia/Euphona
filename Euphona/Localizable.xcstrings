        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start each number at the same height as the one before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza cada número a la misma altura que el anterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita jokainen luku samalta korkeudelta kuin edellinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez chaque nombre à la même hauteur que le précédent."
