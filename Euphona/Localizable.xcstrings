        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mondatok vége hajlamos leesni; tartsd egy kicsit feljebb."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akhir kalimat cenderung turun; tahan sedikit agar tetap naik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
