    "score_focus_ease" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو صوتك مضغوطًا قليلًا. يُستحسن التخفيف: مزيد من النَفَس، وضغط أقل، وبداية ألين لكل عبارة. وإذا كان هناك ألم أو بقيت بحّة فيُستحسن الراحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La teva veu sona una mica atipada. Afluixa: més aire, menys empenta, un inici més suau a cada frase. Si fa mal o continua la ronquera, descansa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš hlas zní trochu stlačeně. Zmírněte námahu: víc dechu, méně tlaku, měkčí nasazení každé fráze. Pokud to bolí nebo chrapot nemizí, odpočiňte si."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmen lyder lidt presset. Slap af: mere luft, mindre pres, en blødere start på hver frase. Hvis det gør ondt, eller stemmen er hæs, så hvil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Stimme klingt etwas gepresst. Lass locker: mehr Atem, weniger Druck, ein weicherer Einsatz bei jeder Phrase. Wenn es wehtut oder die Heiserkeit bleibt, ruh dich aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φωνή ακούγεται λίγο πιεσμένη. Χαλαρώστε: περισσότερη ανάσα, λιγότερη πίεση, πιο απαλή αρχή σε κάθε φράση. Αν πονάει ή παραμένει βραχνή, ξεκουραστείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your voice sounds a little pressed. Ease off: more breath, less push, a softer start to each phrase. If it hurts or stays hoarse, rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu voz suena un poco apretada. Afloja: más aire, menos empuje, un inicio más suave en cada frase. Si duele o sigue la ronquera, descansa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänesi kuulostaa hieman painetulta. Rentoudu: enemmän hengitystä, vähemmän painetta, pehmeämpi aloitus jokaiseen fraasiin. Jos siihen sattuu tai se on käheä, lepää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix sonne un peu pressée. Relâchez : plus de souffle, moins de poussée, un début plus doux à chaque phrase. En cas de douleur ou d’enrouement persistant, reposez-vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקול שלך נשמע קצת לחוץ. כדאי להרפות: יותר נשימה, פחות דחיפה, התחלה רכה יותר לכל ביטוי. אם כואב או שהקול נשאר צרוד, כדאי לנוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ थोड़ी दबी हुई लगती है। ढील दें: साँस ज़्यादा, ज़ोर कम, हर वाक्य की शुरुआत नरम। अगर दर्द हो या आवाज़ भर्राई रहे, तो आराम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš glas zvuči pomalo stisnuto. Popustite: više daha, manje guranja, mekši početak svake fraze. Ako boli ili promuklost ostaje, odmarajte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangod kicsit szorítottan szól. Lazíts: több levegő, kevesebb nyomás, lágyabb kezdés minden mondatnál. Ha fáj, vagy rekedt marad, pihenj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara Anda terdengar agak tertekan. Kendurkan: lebih banyak napas, kurang dorongan, awal setiap frasa yang lebih lembut. Jika terasa sakit atau tetap serak, istirahatlah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua voce suona un po’ compressa. Allenta: più fiato, meno spinta, un attacco più dolce a ogni frase. Se fa male o resta rauca, riposa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声が少し押さえつけられているように聞こえます。力を抜きましょう。息を多めに、押す力は控えめに、各フレーズの出だしをやわらかく。痛みがあったりかすれたりしている場合は、休んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리가 조금 눌려 들려요. 힘을 빼 보세요. 숨을 더 쓰고, 밀어내는 힘은 줄이고, 문장의 시작을 더 부드럽게 해 보세요. 아프거나 목이 쉬어 있으면 쉬세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara anda kedengaran agak tertekan. Kendurkan: lebih banyak nafas, kurang tolakan, permulaan setiap frasa yang lebih lembut. Jika terasa sakit atau terus serak, berehatlah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmen høres litt presset ut. Slapp av: mer luft, mindre press, en mykere start på hver frase. Hvis det gjør vondt eller stemmen er hes, hvil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je stem klinkt een beetje geperst. Laat los: meer adem, minder duwen, een zachtere start van elke zin. Als het pijn doet of je stem hees blijft, rust dan uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój głos brzmi trochę ściśnięty. Zmniejsz wysiłek: więcej oddechu, mniej nacisku, łagodniejszy początek każdej frazy. Jeśli boli albo chrypka nie mija, odpocznij."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua voz soa um pouco apertada. Alivie: mais ar, menos empurrão, um início mais suave em cada frase. Se doer ou continuar rouca, descanse."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocea ta sună puțin apăsat. Relaxează-te: mai multă respirație, mai puțină forță, un început mai blând la fiecare frază. Dacă te doare sau răgușeala rămâne, odihnește-te."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос звучит немного зажато. Ослабьте усилие: больше дыхания, меньше нажима, мягче начало каждой фразы. Если появилась боль или хрипота не проходит, отдохните."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš hlas znie trochu stlačene. Uvoľnite sa: viac dychu, menej tlaku, jemnejší nástup každej frázy. Ak to bolí alebo chrapot pretrváva, oddychujte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš glas zveni nekoliko stisnjeno. Popustite: več diha, manj potiskanja, nežnejši začetek vsake fraze. Če boli ali hripavost ostaja, počivajte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rösten låter lite pressad. Ta det lugnare: mer luft, mindre tryck, en mjukare början på varje fras. Om det gör ont eller rösten är hes, vila."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงฟังดูถูกบีบอยู่เล็กน้อย ผ่อนลง: ใช้ลมมากขึ้น ฝืนน้อยลง เริ่มแต่ละวลีให้นุ่มขึ้น หากเจ็บหรือเสียงแหบ ให้พัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiniz biraz bastırılmış duyuluyor. Gevşeyin: daha çok nefes, daha az itme, her cümleye daha yumuşak bir başlangıç. Ağrıyorsa veya kısık kalıyorsa dinlenin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос звучить трохи затиснуто. Послабте зусилля: більше дихання, менше тиску, м’якший початок кожної фрази. Якщо голос болить або захриплість не минає, відпочиньте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng của bạn nghe hơi bị ép. Hãy thả lỏng: dùng nhiều hơi hơn, đẩy ít hơn, mở đầu mỗi cụm từ nhẹ hơn. Nếu đau hoặc khàn kéo dài, hãy nghỉ ngơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声音听起来有点用力。放松一点：多用气息、少用力推，每句话的开头轻一些。如果嗓子疼或一直沙哑，就先休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聲音聽起來有點用力。放鬆一點：多用氣息、少用力推，每句話的開頭輕一些。如果嗓子會痛或一直沙啞，就先休息。"
          }
        }
      }
    },
