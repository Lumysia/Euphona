    "coach_ex_pitch_count_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العدّ ينقل درجة الصوت الجديدة من نغمة ممتدة إلى الكلام، وهي الخطوة التي تجعلها قابلة للاستخدام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptar porta el nou to d’una nota sostinguda a la parla, el pas que el fa útil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítání přenáší novou výšku hlasu z držené noty do řeči — to je krok, který ji činí použitelnou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du tæller, flytter den nye tonehøjde sig fra en holdt tone ind i tale, og det er det skridt, der gør den brugbar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Zählen wandert die neue Tonhöhe von einem gehaltenen Ton in die Sprache, und erst das macht sie nutzbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μέτρημα μεταφέρει το νέο τονικό ύψος από μια παρατεταμένη νότα στην ομιλία, το βήμα που το κάνει χρήσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counting moves the new pitch from a held note into speech, the step that makes it usable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contar lleva el nuevo tono de una nota sostenida al habla, el paso que lo hace útil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskeminen siirtää uuden äänenkorkeuden pitkästä äänestä puheeseen, ja juuri se tekee siitä käyttökelpoisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compter fait passer la nouvelle hauteur d’une note tenue à la parole, l’étape qui la rend utilisable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הספירה מעבירה את גובה הקול החדש מצליל ממושך אל הדיבור, והשלב הזה הופך אותו לשימושי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गिनती नई पिच को ठहरे हुए सुर से बोलचाल में ले जाती है, यही क़दम उसे काम का बनाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brojanje prenosi novu visinu glasa s držanog tona u govor, a to je korak koji je čini upotrebljivom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számolás a tartott hangból átviszi az új hangmagasságot a beszédbe, és ez teszi használhatóvá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhitung memindahkan nada baru dari nada tahan ke ucapan, langkah yang membuatnya berguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contare porta il nuovo tono da una nota tenuta al parlato, il passo che lo rende utilizzabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数を数えることで、新しいピッチを伸ばした音から話し言葉へ移せます。実際に使えるようになるための一歩です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자를 세면 새로운 음높이가 길게 낸 소리에서 말로 옮겨 가요. 실제로 쓸 수 있게 만드는 단계예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengira memindahkan nada baharu daripada nada tahan kepada pertuturan, langkah yang menjadikannya berguna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du teller, flyttes den nye tonehøyden fra en holdt tone over i tale, og det er steget som gjør den brukbar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tellen brengt de nieuwe toonhoogte van een aangehouden toon naar spraak, de stap die haar bruikbaar maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczenie przenosi nową wysokość głosu z przytrzymanego dźwięku do mowy — to krok, który czyni ją użyteczną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contar leva o novo tom de uma nota sustentada para a fala, o passo que o torna útil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Număratul mută noua înălțime de la o notă ținută la vorbire, pasul care o face utilizabilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счёт переносит новую высоту тона с долгой ноты в речь — это шаг, благодаря которому она становится пригодной для жизни."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítanie prenáša novú výšku hlasu z držaného tónu do reči, a to je krok, vďaka ktorému je použiteľná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štetje prenese novo višino glasu iz zadržane note v govor, korak, zaradi katerega je uporabna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du räknar flyttas den nya tonhöjden från en hållen ton till tal, och det steget gör den användbar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนับพาระดับเสียงใหม่จากโน้ตที่คงไว้เข้าสู่การพูด ซึ่งเป็นขั้นที่ทำให้ใช้งานได้จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayma, yeni perdeyi tutulan bir notadan konuşmaya taşır; onu kullanılır kılan adım budur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лічба переносить нову висоту тону з довгої ноти в мовлення — це крок, завдяки якому вона стає придатною для життя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm số đưa cao độ mới từ một nốt giữ dài vào lời nói, bước giúp nó dùng được trong thực tế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数数把新的音高从长音带进说话里，这一步让它真正能用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數數把新的音高從長音帶進說話裡，這一步讓它真正能用。"
          }
        }
      }
    },
    "coach_ex_pitch_hold_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. أخذ نفس مسترخٍ.\n2. قول «ممم-هممم» وترك الصوت يستقر في النطاق المظلَّل.\n3. إبقاء «ممم» أو «آ» سهلة هناك، ثم تركها والعثور عليها من جديد.\n4. الحفاظ على الخفة: إذا شعر الصوت بالشدّ فيُنزَل قليلًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Respira amb calma.\n2. Digues «mmm-hmm» i deixa que s’assenti a la franja ombrejada.\n3. Sosté una «mmm» o una «a» fàcil allà, deixa-la anar i torna-la a trobar.\n4. Mantén-te lleuger: si se sent tens, baixa una mica."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Klidně se nadechněte.\n2. Řekněte „mhm“ a nechte hlas usadit se ve vystínovaném pásmu.\n3. Podržte tam lehké „mmm“ nebo „á“, pak ho pusťte a znovu najděte.\n4. Zůstaňte v lehkosti: pokud se objeví napětí, sjeďte o kousek níž."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tag et afslappet åndedrag.\n2. Sig »mm-hm«, og lad det lande i det skraverede bånd.\n3. Hold en let »mmm« eller »a« der, slip det, og find det igen.\n4. Hold det let: Hvis det føles anspændt, så gå lidt ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Atme entspannt ein.\n2. Sage „mmm-hmm“ und lass die Stimme im schattierten Band ankommen.\n3. Halte dort ein leichtes „mmm“ oder „a“, lass dann los und finde es wieder.\n4. Bleib leicht: Wenn es sich verspannt, geh ein Stück tiefer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Πάρτε μια χαλαρή ανάσα.\n2. Πείτε «μμμ-χμμ» και αφήστε το να καθίσει στη σκιασμένη ζώνη.\n3. Κρατήστε εκεί ένα εύκολο «μμμ» ή «α», έπειτα αφήστε το και βρείτε το ξανά.\n4. Μείνετε ελαφριά: αν νιώθετε σφίξιμο, κατεβείτε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Take a relaxed breath.\n2. Say “mmm-hmm” and let it settle into the shaded band.\n3. Hold an easy “mmm” or “ah” there, then let it go and find it again.\n4. Stay light: if it feels tight, come down a little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Respira con calma.\n2. Di «mmm-hmm» y deja que se asiente en la banda sombreada.\n3. Sostén una «mmm» o una «a» fácil ahí, suéltala y vuelve a encontrarla.\n4. Mantente ligero: si se siente tenso, baja un poco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hengitä rennosti.\n2. Sano ”mm-hm” ja anna äänen asettua varjostetulle alueelle.\n3. Pidä siellä kevyttä ”mmm”- tai ”aa”-ääntä, päästä irti ja etsi se uudelleen.\n4. Pysy kevyenä: jos tuntuu kireältä, laskeudu hieman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Prenez une inspiration détendue.\n2. Dites « mmm-hmm » et laissez la voix se poser dans la bande colorée.\n3. Tenez un « mmm » ou un « a » facile à cet endroit, puis relâchez et retrouvez-le.\n4. Gardez de la légèreté : si cela se crispe, descendez un peu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לקחת נשימה רגועה.\n2. לומר “מממ-הממ” ולתת לו להתייצב בטווח המוצל.\n3. להחזיק שם “מממ” או “אה” קלים, ואז לשחרר ולמצוא אותו שוב.\n4. להישאר קליל: אם מרגישים מתח, לרדת קצת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. आराम से साँस लें।\n2. “हम्म-हम्म” कहें और आवाज़ को छायांकित दायरे में बैठने दें।\n3. वहाँ कोई आसान “म्म्म” या “आ” टिकाएँ, फिर छोड़ दें और दोबारा उसे खोजें।\n4. हल्के रहें: कसाव लगे तो थोड़ा नीचे आ जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Opušteno udahnite.\n2. Recite „mm-hm“ i pustite da se glas smjesti u osjenčani pojas.\n3. Tamo držite lagano „mmm“ ili „a“, zatim ga pustite i pronađite ponovno.\n4. Neka bude lagano: ako se napne, spustite se malo niže."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Végy egy laza levegőt.\n2. Mondd, hogy „mm-hm”, és hagyd a hangot elhelyezkedni a sötétített sávban.\n3. Tarts ott egy könnyű „mmm”-et vagy „á”-t, aztán engedd el, és találd meg újra.\n4. Maradj könnyed: ha megfeszül, menj lejjebb egy kicsit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tarik napas dengan santai.\n2. Ucapkan “mmm-hmm” dan biarkan suara menetap di rentang berbayang.\n3. Tahan “mmm” atau “ah” yang mudah di sana, lalu lepaskan dan temukan lagi.\n4. Tetap ringan: jika terasa tegang, turunlah sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Fai un respiro rilassato.\n2. Di’ «mmm-hmm» e lascia che si assesti nella fascia colorata.\n3. Tieni lì una «mmm» o una «a» facile, poi lasciala andare e ritrovala.\n4. Mantieni leggerezza: se senti tensione, scendi un poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 力を抜いて息を吸います。\n2. 「んーふん」と言い、声を色付きの範囲に落ち着かせます。\n3. そこで楽な「んー」や「アー」を保ち、いったん離して、また見つけます。\n4. 軽さを保ちます。力が入ったら、少し下げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 편안하게 숨을 들이쉬세요.\n2. “음-흠” 하고 말하며 소리를 색칠된 범위 안에 자리 잡게 하세요.\n3. 거기서 편안한 “음”이나 “아”를 유지하다가, 놓았다가 다시 찾아 보세요.\n4. 가볍게 유지하세요. 조이는 느낌이 들면 조금 내리세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tarik nafas dengan santai.\n2. Sebut “mmm-hmm” dan biarkan suara menetap dalam julat berlorek.\n3. Tahan “mmm” atau “ah” yang mudah di situ, kemudian lepaskan dan cari semula.\n4. Kekal ringan: jika terasa tegang, turun sedikit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ta et avslappet åndedrag.\n2. Si «mm-hm» og la det lande i det skraverte båndet.\n3. Hold en lett «mmm» eller «a» der, slipp, og finn det igjen.\n4. Hold det lett: Hvis det kjennes stramt, gå litt ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Adem ontspannen in.\n2. Zeg “mmm-hmm” en laat het in de gearceerde band tot rust komen.\n3. Houd daar een makkelijke “mmm” of “aa” aan, laat dan los en vind hem opnieuw.\n4. Blijf licht: als het gespannen voelt, ga dan iets lager."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Weź spokojny oddech.\n2. Powiedz „mm-hm” i pozwól, by dźwięk ułożył się w zacieniowanym paśmie.\n3. Przytrzymaj tam lekkie „mmm” lub „a”, potem puść i znajdź je ponownie.\n4. Utrzymaj lekkość: jeśli robi się ciasno, zejdź trochę niżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Respire com calma.\n2. Diga “mmm-hmm” e deixe o som assentar na faixa sombreada.\n3. Sustente um “mmm” ou “a” fácil ali, solte e encontre de novo.\n4. Fique leve: se parecer apertado, desça um pouco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Inspiră relaxat.\n2. Spune „mmm-hmm” și lasă sunetul să se așeze în banda umbrită.\n3. Ține acolo un „mmm” sau un „a” ușor, apoi dă-i drumul și găsește-l din nou.\n4. Rămâi ușor: dacă se simte încordat, coboară puțin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Сделайте спокойный вдох.\n2. Скажите «м-хм» и дайте звуку занять закрашенную полосу.\n3. Удерживайте там лёгкое «ммм» или «а», затем отпустите и найдите её снова.\n4. Оставайтесь лёгкими: если появилась зажатость, опуститесь чуть ниже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Uvoľnene sa nadýchnite.\n2. Povedzte „mm-hm“ a nechajte hlas usadiť sa v tieňovanom pásme.\n3. Držte tam ľahké „mmm“ alebo „á“, potom ho pustite a nájdite znova.\n4. Držte to ľahko: ak sa to napína, zíďte trochu nižšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sproščeno vdihnite.\n2. Recite „mm-hm“ in pustite, da se glas ustali v osenčenem pasu.\n3. Tam zadržite lahki „mmm“ ali „a“, nato spustite in ga znova poiščite.\n4. Naj bo lahkotno: če se napne, se spustite nekoliko nižje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ta ett avslappnat andetag.\n2. Säg ”mm-hm” och låt rösten landa i det skuggade bandet.\n3. Håll ett lätt ”mmm” eller ”aa” där, släpp och hitta tillbaka igen.\n4. Håll det lätt: om det känns spänt, gå ner lite."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. หายใจเข้าอย่างผ่อนคลาย\n2. พูด “อืม-ฮึม” แล้วปล่อยให้เสียงลงมาอยู่ในแถบที่แรเงา\n3. คง “มมม” หรือ “อา” ง่ายๆ ไว้ตรงนั้น แล้วปล่อยและหาให้เจออีกครั้ง\n4. ให้เบาไว้: ถ้ารู้สึกตึง ให้ลดลงเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Rahat bir nefes alın.\n2. “Mmm-hmm” deyin ve sesin gölgeli banda oturmasına izin verin.\n3. Orada kolay bir “mmm” veya “a” tutun, sonra bırakın ve yeniden bulun.\n4. Hafif kalın: sıkışıyorsa biraz aşağı inin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Спокійно вдихніть.\n2. Скажіть «м-гм» і дайте звуку влаштуватися в затіненій смузі.\n3. Утримуйте там легке «ммм» або «а», потім відпустіть і знайдіть її знову.\n4. Лишайтеся легкими: якщо з’явився затиск, опустіться трохи нижче."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hít một hơi thư giãn.\n2. Nói “mmm-hmm” và để giọng rơi vào dải được tô bóng.\n3. Giữ một tiếng “mmm” hoặc “a” dễ chịu ở đó, rồi buông ra và tìm lại.\n4. Giữ nhẹ nhàng: nếu thấy căng, hạ xuống một chút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 放松地吸一口气。\n2. 说“嗯哼”，让声音落进阴影范围里。\n3. 在那里轻松地保持“嗯”或“啊”，然后放开，再重新找到它。\n4. 保持轻松；觉得紧就稍微降一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 放鬆地吸一口氣。\n2. 說「嗯哼」，讓聲音落進陰影範圍裡。\n3. 在那裡輕鬆地保持「嗯」或「啊」，然後放開，再重新找到它。\n4. 保持輕鬆；覺得緊就稍微降一點。"
          }
        }
      }
    },
    "coach_ex_pitch_hold_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن استهداف منتصف النطاق لا حافته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta al centre de la franja, no a la vora."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mířte do středu pásma, ne na jeho okraj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigt efter midten af båndet frem for kanten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele auf die Mitte des Bandes statt auf den Rand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στοχεύστε στη μέση της ζώνης και όχι στην άκρη της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aim for the middle of the band rather than its edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta al centro de la banda, no a su borde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähtää alueen keskelle reunan sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez le milieu de la bande plutôt que son bord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לכוון לאמצע הטווח ולא לקצה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दायरे के किनारे की बजाय बीच को निशाना बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciljajte na sredinu pojasa, a ne na njegov rub."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sáv közepét célozd, ne a szélét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidik bagian tengah rentang, bukan tepinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta al centro della fascia, non al bordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲の端ではなく、真ん中をねらいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위의 가장자리보다 한가운데를 노려 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasarkan bahagian tengah julat, bukan tepinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikt mot midten av båndet i stedet for kanten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mik op het midden van de band in plaats van op de rand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celuj w środek pasma, a nie w jego brzeg."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mire no meio da faixa, não na borda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Țintește mijlocul benzii, nu marginea ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цельтесь в середину полосы, а не в её край."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierte na stred pásma, nie na jeho okraj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciljajte na sredino pasu, ne na njegov rob."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikta på mitten av bandet i stället för kanten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล็งไปที่กลางแถบมากกว่าขอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandın kenarını değil ortasını hedefleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цільтеся в середину смуги, а не в її край."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhắm vào giữa dải thay vì mép dải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瞄准范围的中间，而不是边缘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瞄準範圍的中間，而不是邊緣。"
          }
        }
      }
    },
