    "error_store_unavailable_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Euphona فتح مخزنه، لذا تُحفظ التحاليل الجديدة إلى أن يُغلق التطبيق فقط. وعادةً تحل إعادة تشغيل Euphona أو الجهاز هذه المشكلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona no ha pogut obrir el seu emmagatzematge, així que les anàlisis noves només es conserven fins que tanquis l’app. Reiniciar Euphona o el dispositiu sol solucionar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona nemohla otevřít úložiště, takže nové analýzy se uchovávají jen do zavření aplikace. Obvykle pomůže restart Euphony nebo zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona kunne ikke åbne sit lager, så nye analyser beholdes kun, indtil du lukker appen. Det hjælper som regel at genstarte Euphona eller enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona konnte seinen Speicher nicht öffnen, deshalb bleiben neue Analysen nur erhalten, bis du die App schließt. Ein Neustart von Euphona oder des Geräts behebt das meist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Euphona δεν μπόρεσε να ανοίξει τον χώρο αποθήκευσής του, γι' αυτό οι νέες αναλύσεις διατηρούνται μόνο μέχρι να κλείσετε την εφαρμογή. Συνήθως το διορθώνει η επανεκκίνηση του Euphona ή της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona couldn’t open its storage, so new analyses are kept only until you close the app. Restarting Euphona or the device usually fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona no pudo abrir su almacenamiento, así que los análisis nuevos solo se conservan hasta que cierres la app. Reiniciar Euphona o el dispositivo suele solucionarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona ei voinut avata tallennustilaansa, joten uudet analyysit säilyvät vain, kunnes suljet appin. Euphonan tai laitteen uudelleenkäynnistys yleensä korjaa tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona n’a pas pu ouvrir son stockage ; les nouvelles analyses ne sont donc conservées que jusqu’à la fermeture de l’app. Redémarrer Euphona ou l’appareil résout généralement le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona לא הצליחה לפתוח את האחסון שלה, ולכן ניתוחים חדשים נשמרים רק עד לסגירת האפליקציה. הפעלה מחדש של Euphona או של המכשיר בדרך כלל פותרת זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona अपना स्टोरेज नहीं खोल सका, इसलिए नए विश्लेषण सिर्फ़ ऐप बंद करने तक रखे जाते हैं। Euphona या डिवाइस को रीस्टार्ट करने से आमतौर पर यह ठीक हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona nije mogla otvoriti svoju pohranu pa se nove analize čuvaju samo dok ne zatvorite aplikaciju. Ponovno pokretanje Euphone ili uređaja to obično rješava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Euphona nem tudta megnyitni a tárhelyét, ezért az új elemzések csak az alkalmazás bezárásáig maradnak meg. Az Euphona vagy az eszköz újraindítása általában megoldja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona tidak dapat membuka penyimpanannya, sehingga analisis baru hanya disimpan sampai Anda menutup app. Memulai ulang Euphona atau perangkat biasanya memperbaikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona non è riuscita ad aprire il proprio archivio, quindi le nuove analisi restano solo finché non chiudi l’app. Di solito riavviare Euphona o il dispositivo risolve il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona がストレージを開けなかったため、新しい分析はアプリを閉じるまでしか保持されません。Euphona またはデバイスを再起動すると、たいてい解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona가 저장 공간을 열지 못해서, 새 분석은 앱을 닫을 때까지만 유지돼요. Euphona나 기기를 다시 시작하면 대개 해결돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona tidak dapat membuka storannya, jadi analisis baharu disimpan hanya sehingga anda menutup app. Memulakan semula Euphona atau peranti biasanya menyelesaikannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona kunne ikke åpne lagringen sin, så nye analyser beholdes bare til du lukker appen. Det hjelper vanligvis å starte Euphona eller enheten på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona kon de opslag niet openen, dus nieuwe analyses blijven alleen bewaard tot je de app sluit. Herstarten van Euphona of het apparaat lost dit meestal op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona nie mogła otworzyć magazynu, więc nowe analizy są przechowywane tylko do zamknięcia aplikacji. Zwykle pomaga ponowne uruchomienie Euphony lub urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Euphona não conseguiu abrir o armazenamento, então as novas análises só ficam guardadas até você fechar o app. Reiniciar o Euphona ou o dispositivo costuma resolver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona nu a putut deschide spațiul de stocare, așa că analizele noi sunt păstrate doar până închizi aplicația. Repornirea Euphona sau a dispozitivului rezolvă de obicei problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona не удалось открыть хранилище, поэтому новые анализы сохраняются только до закрытия приложения. Обычно помогает перезапуск Euphona или устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona nemohla otvoriť svoje úložisko, preto sa nové analýzy uchovajú len dovtedy, kým aplikáciu nezatvoríte. Reštartovanie Euphony alebo zariadenia to zvyčajne vyrieši."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona ni mogla odpreti svojega shranjevalnika, zato se nove analize hranijo le, dokler ne zaprete aplikacije. Ponovni zagon Euphone ali naprave to običajno odpravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona kunde inte öppna sin lagring, så nya analyser behålls bara tills du stänger appen. Det brukar hjälpa att starta om Euphona eller enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona เปิดพื้นที่จัดเก็บไม่ได้ การวิเคราะห์ใหม่จึงเก็บไว้จนกว่าคุณจะปิดแอปเท่านั้น การเริ่ม Euphona หรืออุปกรณ์ใหม่มักแก้ปัญหานี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona depolama alanını açamadı, bu yüzden yeni analizler yalnızca uygulamayı kapatana kadar tutulur. Euphona’yı veya cihazı yeniden başlatmak genellikle sorunu çözer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona не вдалося відкрити сховище, тому нові аналізи зберігаються лише до закриття застосунку. Зазвичай допомагає перезапуск Euphona або пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona không mở được bộ nhớ lưu trữ nên các phân tích mới chỉ được giữ đến khi bạn đóng ứng dụng. Khởi động lại Euphona hoặc thiết bị thường sẽ khắc phục được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona 无法打开存储空间，新的测评只会保留到你关闭 App 为止。重新打开 Euphona 或重启设备通常可以解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona 無法打開儲存空間，新的分析只會保留到你關閉 App 為止。重新打開 Euphona 或重新啟動裝置通常可以解決。"
          }
        }
      }
    },
