        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ηχογραφήσεις και τα αποτελέσματά σας μένουν στις συσκευές σας και στο δικό σας iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
