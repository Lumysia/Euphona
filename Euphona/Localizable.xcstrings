          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu am auzit destul ca să măsor asta. Pornește instrumentul și continuă până se termină timpul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для измерения слышно было слишком мало. Запустите инструмент и продолжайте, пока не истечёт время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
