    "dashboard_metric_ease_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى خلوّ صوتك من التكلّف: القيمة 100 تعني ألّا إجهاد أكثر مما يظهره المتحدثون الأصحاء. تُقدَّر من تسجيلات قيّمها مختصون في الصوت من حيث الإجهاد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com de poc forçada sona la teva veu: 100 vol dir no més esforç del que mostren les persones amb veu sana. S’estima a partir d’enregistraments que especialistes en veu van valorar pel seu esforç."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak nenuceně váš hlas zní: 100 znamená, že není slyšet větší napětí než u zdravých mluvčích. Odhaduje se z nahrávek, u kterých hlasoví odborníci hodnotili napětí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor ubesværet stemmen lyder: 100 betyder ikke mere anstrengelse end hos raske talere. Estimeret ud fra optagelser, som stemmeklinikere har vurderet for anstrengelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie unangestrengt deine Stimme klingt: 100 bedeutet nicht mehr Anstrengung als bei gesunden Sprechenden. Geschätzt aus Aufnahmen, deren Anstrengung von Stimmfachleuten bewertet wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο φυσική ακούγεται η φωνή σας: το 100 σημαίνει όχι περισσότερη κόπωση από ό,τι εμφανίζουν οι υγιείς ομιλητές. Εκτιμάται από ηχογραφήσεις που αξιολογήθηκαν για κόπωση από κλινικούς φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How unforced your voice sounds: 100 means no more strain than healthy speakers show. Estimated from recordings that voice clinicians rated for strain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo poco forzada que suena tu voz: 100 significa no más esfuerzo del que muestran las personas con voz sana. Se estima a partir de grabaciones que especialistas en voz valoraron por su esfuerzo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka vaivattomalta äänesi kuulostaa: 100 tarkoittaa, ettei rasitusta ole enempää kuin terveillä puhujilla. Arvio perustuu äänityksiin, joiden rasittuneisuuden äänenkäytön ammattilaiset ovat arvioineet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quel point votre voix sonne sans effort : 100 signifie pas plus de tension que chez les locuteurs en bonne santé. Estimé à partir d’enregistrements dont la tension a été évaluée par des cliniciens de la voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עד כמה הקול שלך נשמע ללא מאמץ: 100 פירושו לא יותר מאמץ ממה שדוברים בריאים מראים. מוערך מהקלטות שקלינאי קול דירגו מבחינת מאמץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ कितनी बिना ज़ोर की लगती है: 100 का मतलब है कि स्वस्थ बोलने वालों से ज़्यादा खिंचाव नहीं है। यह उन रिकॉर्डिंग से आँका जाता है जिन्हें आवाज़ के चिकित्सकों ने खिंचाव के लिए रेट किया था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko neusiljeno vaš glas zvuči: 100 znači da nema više naprezanja nego kod zdravih govornika. Procijenjeno iz snimaka koje su stručnjaci za glas ocijenili s obzirom na naprezanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyire erőlködés nélküli a hangod: a 100 azt jelenti, hogy nem megerőltetőbb, mint az egészséges beszélőké. Olyan felvételekből becsülve, amelyeket hangszakértők értékeltek megerőltetés szempontjából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa tidak dipaksa suara Anda terdengar: 100 berarti tidak lebih tegang daripada pembicara sehat. Diperkirakan dari rekaman yang dinilai ketegangannya oleh klinisi suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto è naturale la tua voce: 100 significa non più sforzo di quello che mostrano le persone con voce sana. È stimata da registrazioni che specialisti della voce hanno valutato per lo sforzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声がどれだけ無理なく聞こえるか。100 は、健康な話者と同程度の負担という意味です。音声の専門家が負担の度合いを評価した録音から推定しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리가 얼마나 힘들이지 않고 들리는지예요. 100은 건강한 화자와 같은 정도의 힘만 들어간다는 뜻이에요. 음성 전문가가 힘줌 정도를 평가한 녹음으로 추정해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betapa tidak dipaksa suara anda kedengaran: 100 bermaksud tidak lebih tegang daripada penutur yang sihat. Dianggarkan daripada rakaman yang dinilai ketegangannya oleh klinisian suara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor uanstrengt stemmen høres ut: 100 betyr ikke mer anstrengelse enn friske talere viser. Estimert fra opptak som stemmeklinikere har vurdert for anstrengelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ongedwongen je stem klinkt: 100 betekent niet meer inspanning dan gezonde sprekers laten horen. Geschat op basis van opnamen waarvan stemspecialisten de inspanning hebben beoordeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak niewymuszenie brzmi Twój głos: 100 oznacza nie więcej napięcia niż u zdrowych mówców. Szacowane na podstawie nagrań, które specjaliści od głosu ocenili pod kątem napięcia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão sem esforço sua voz soa: 100 significa não mais esforço do que pessoas com voz saudável apresentam. É estimado a partir de gravações que especialistas em voz avaliaram quanto ao esforço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de nestânjenită sună vocea ta: 100 înseamnă fără mai mult efort decât la vorbitorii sănătoși. Estimat din înregistrări ale căror efort a fost evaluat de specialiști în voce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько непринуждённо звучит ваш голос: 100 означает, что напряжения не больше, чем у здоровых говорящих. Оценивается по записям, которые специалисты по голосу оценили по напряжению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako nenútene váš hlas znie: 100 znamená, že nie je namáhavejší než u zdravých hovoriacich. Odhadnuté z nahrávok, ktoré odborníci na hlas hodnotili z hľadiska namáhania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako neprisiljeno zveni vaš glas: 100 pomeni, da ni več napora kot pri zdravih govorcih. Ocenjeno iz posnetkov, ki so jih strokovnjaki za glas ocenili glede napora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur ledigt rösten låter: 100 betyder inte mer ansträngning än friska talare visar. Uppskattat utifrån inspelningar som röstkliniker har bedömt för ansträngning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงของคุณฟังดูไม่ฝืนเพียงใด: 100 หมายถึงไม่ตึงเครียดไปกว่าผู้พูดที่มีสุขภาพดี ประเมินจากการบันทึกเสียงที่ผู้เชี่ยวชาญด้านเสียงให้คะแนนความตึงเครียด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinizin ne kadar zorlamasız duyulduğu: 100, sağlıklı konuşmacıların gösterdiğinden daha fazla zorlanma olmadığı anlamına gelir. Ses klinisyenlerinin zorlanma açısından derecelendirdiği kayıtlardan tahmin edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки невимушено звучить ваш голос: 100 означає, що напруження не більше, ніж у здорових мовців. Оцінюється за записами, які фахівці з голосу оцінили за напруженням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng của bạn nghe tự nhiên, không gắng sức đến đâu: 100 nghĩa là không gắng sức hơn người nói khỏe mạnh. Ước tính từ các bản ghi âm mà chuyên gia giọng nói đã đánh giá mức gắng sức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声音听起来有多不费力：100 表示不比健康的说话者更用力。根据嗓音专业人士评过用力程度的录音估算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聲音聽起來有多不費力：100 表示不比健康的說話者更用力。根據嗓音專業人員評過用力程度的錄音估算。"
          }
        }
      }
    },
