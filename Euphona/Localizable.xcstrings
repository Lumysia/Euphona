    "coach_ex_dog_dark_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خفض الحنجرة يطيل المجرى الصوتي. واللهاث البطيء يجد هذا الوضع دون دفع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixar la laringe allarga el tracte vocal. Panteixar lentament troba aquesta posició sense empènyer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snížený hrtan prodlužuje hlasový trakt. Pomalé dýchání tuto polohu najde bez tlačení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når strubehovedet sænkes, bliver ansatsrøret længere. Langsom hundepust finder den position uden at presse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein tieferer Kehlkopf verlängert den Vokaltrakt. Langsames Hecheln findet diese Position, ohne zu drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χαμηλή θέση του λάρυγγα μεγαλώνει τον φωνητικό σωλήνα. Το αργό λαχάνιασμα βρίσκει αυτή τη θέση χωρίς πίεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lowering the larynx lengthens the vocal tract. Slow panting finds that position without pushing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajar la laringe alarga el tracto vocal. Jadear despacio encuentra esa posición sin empujar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kurkunpää laskee, äänitorvi pitenee. Hidas läähätys löytää tämän asennon painamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaisser le larynx allonge le conduit vocal. Haleter lentement permet de trouver cette position sans forcer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנמכת הגרון מאריכה את דרכי הקול. התנשפות איטית מוצאת את המיקום הזה בלי לדחוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वरयंत्र नीचे करने से स्वर-नलिका लंबी हो जाती है। धीरे हाँफने से यह स्थिति बिना दबाव के मिल जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spuštanje grkljana produljuje glasovni trakt. Sporo dahtanje pronalazi taj položaj bez guranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gégefő leengedése megnyújtja a hangtraktust. A lassú lihegés nyomás nélkül megtalálja ezt a helyzetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menurunkan laring memperpanjang saluran suara. Terengah-engah pelan menemukan posisi itu tanpa mendorong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassare la laringe allunga il tratto vocale. Ansimare lentamente trova quella posizione senza spingere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喉頭を下げると声道が長くなります。ゆっくり息を弾ませると、押さえつけずにその位置が見つかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후두를 낮추면 성도가 길어져요. 천천히 헥헥거리면 밀어 내리지 않고도 그 위치를 찾을 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merendahkan laring memanjangkan saluran suara. Mengah perlahan menemui kedudukan itu tanpa menolak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når strupehodet senkes, blir ansatsrøret lengre. Rolig hundepusting finner den posisjonen uten å presse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het strottenhoofd zakt, wordt het spraakkanaal langer. Langzaam hijgen vindt die stand zonder te duwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obniżona krtań wydłuża przewód głosowy. Wolny oddech pozwala znaleźć to ustawienie bez naciskania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixar a laringe alonga o trato vocal. Ofegar devagar encontra essa posição sem empurrar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coborârea laringelui lungește tractul vocal. Gâfâitul rar găsește această poziție fără a împinge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда гортань опускается, голосовой тракт становится длиннее. Медленное дыхание помогает найти это положение без нажима."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zníženie hrtana predlžuje hlasový trakt. Pomalé dýchanie túto polohu nájde bez tlačenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spust grtanca podaljša glasovni trakt. Počasno sopihanje najde ta položaj brez potiskanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När struphuvudet sänks blir ansatsröret längre. Långsamt flåsande hittar det läget utan att pressa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลดกล่องเสียงลงทำให้ช่องเสียงยาวขึ้น การหอบช้าๆ ช่วยหาตำแหน่งนั้นได้โดยไม่ต้องกด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gırtlağı alçaltmak ses yolunu uzatır. Yavaş soluma, bu konumu itmeden bulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли гортань опускається, голосовий тракт стає довшим. Повільне дихання допомагає знайти це положення без тиску."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hạ thấp thanh quản làm đường phát âm dài ra. Thở dốc chậm giúp tìm ra vị trí đó mà không cần ép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放低喉头能加长声道。慢慢喘气能自然找到这个位置，而不用硬压。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放低喉頭能加長聲道。慢慢喘氣能自然找到這個位置，而不用硬壓。"
          }
        }
      }
    },
    "coach_ex_hum_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. الجلوس بارتياح واسترخاء الكتفين.\n2. دندنة «ممم» بلطف على نغمة سهلة واحدة، كأنك توافق أحدًا.\n3. التنفّس كلما لزم الأمر؛ دون دفع أبدًا.\n4. التوقف إذا آلم شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Seu còmodament i relaxa les espatlles.\n2. Taral·leja «mmm» suaument en una nota fàcil, com si donessis la raó a algú.\n3. Respira quan ho necessitis; no forcis mai.\n4. Atura’t si alguna cosa fa mal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pohodlně se posaďte a uvolněte ramena.\n2. Jemně broukejte „mmm“ na jednom pohodlném tónu, jako když s někým souhlasíte.\n3. Nadechněte se, kdykoli potřebujete; nic nevynucujte.\n4. Přestaňte, pokud něco bolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sid behageligt, og slap af i skuldrene.\n2. Nynn et blødt »mmm« på én let tone, som når man er enig med nogen.\n3. Træk vejret, når du har brug for det, og pres aldrig.\n4. Stop, hvis noget gør ondt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Setz dich bequem hin und entspanne die Schultern.\n2. Summe leise „mmm“ auf einem leichten Ton, als würdest du jemandem zustimmen.\n3. Atme, wann immer du willst; drücke nie.\n4. Hör auf, wenn irgendetwas wehtut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Καθίστε αναπαυτικά και χαλαρώστε τους ώμους.\n2. Μουρμουρίστε απαλά «μμμ» σε μία εύκολη νότα, σαν να συμφωνείτε με κάποιον.\n3. Αναπνεύστε όποτε χρειάζεται· μην πιέζετε ποτέ.\n4. Σταματήστε αν κάτι πονάει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sit comfortably and relax your shoulders.\n2. Hum “mmm” softly on one easy note, as if agreeing with someone.\n3. Breathe whenever you need to; never push.\n4. Stop if anything hurts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Siéntate cómodamente y relaja los hombros.\n2. Tararea «mmm» con suavidad en una nota fácil, como si dieras la razón a alguien.\n3. Respira cuando lo necesites; nunca fuerces.\n4. Para si algo duele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Istu mukavasti ja rentouta hartiat.\n2. Hyräile pehmeä ”mmm” yhdellä helpolla äänellä, kuin olisit samaa mieltä jonkun kanssa.\n3. Hengitä aina, kun tarvitset, äläkä koskaan pakota.\n4. Lopeta, jos jokin sattuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Installez-vous confortablement et détendez les épaules.\n2. Fredonnez doucement « mmm » sur une note facile, comme pour approuver quelqu’un.\n3. Respirez dès que nécessaire ; ne forcez jamais.\n4. Arrêtez si quelque chose fait mal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לשבת בנוחות ולשחרר את הכתפיים.\n2. לזמזם “ממם” בעדינות על צליל קל אחד, כאילו מסכימים עם מישהו.\n3. לנשום בכל פעם שצריך; אף פעם לא לדחוף.\n4. לעצור אם משהו כואב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. आराम से बैठें और कंधे ढीले छोड़ें।\n2. किसी एक आसान सुर पर धीमे से “म्म्म” गुनगुनाएँ, जैसे किसी की बात से सहमति जता रहे हों।\n3. ज़रूरत हो तब साँस लें; ज़ोर बिल्कुल न लगाएँ।\n4. कहीं भी दर्द हो तो रुक जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Udobno sjednite i opustite ramena.\n2. Tiho brujite „mmm“ na jednom lakom tonu, kao da se s nekim slažete.\n3. Udahnite kad god je potrebno; nikad ne forsirajte.\n4. Prestanite ako išta boli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ülj kényelmesen, és lazítsd el a vállad.\n2. Halkan dúdolj „mmm”-et egyetlen könnyű hangon, mintha egyetértenél valakivel.\n3. Lélegezz, ahányszor csak kell; soha ne erőltesd.\n4. Hagyd abba, ha bármi fáj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Duduklah dengan nyaman dan kendurkan bahu.\n2. Bersenandung “mmm” lembut pada satu nada yang mudah, seolah menyetujui seseorang.\n3. Tarik napas kapan pun perlu; jangan memaksa.\n4. Berhenti jika ada yang sakit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Siediti comodamente e rilassa le spalle.\n2. Canticchia «mmm» dolcemente su una nota facile, come per dare ragione a qualcuno.\n3. Respira quando ti serve; non forzare mai.\n4. Fermati se qualcosa fa male."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 楽に座り、肩の力を抜きます。\n2. 誰かに相づちを打つように、出しやすい 1 つの音で「んー」とやさしくハミングします。\n3. 息が必要なときはいつでも吸ってください。無理は禁物です。\n4. 痛みがあれば、すぐにやめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 편안하게 앉아 어깨 힘을 빼세요.\n2. 누군가에게 맞장구치듯 편한 음 하나로 “음~” 하고 부드럽게 허밍하세요.\n3. 숨이 필요하면 언제든 쉬세요. 절대 무리하지 마세요.\n4. 어디든 아프면 멈추세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Duduk dengan selesa dan kendurkan bahu.\n2. Bersenandung “mmm” dengan lembut pada satu nada yang mudah, seolah-olah bersetuju dengan seseorang.\n3. Tarik nafas bila-bila perlu; jangan memaksa.\n4. Berhenti jika ada yang sakit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sitt komfortabelt og slapp av i skuldrene.\n2. Nynn en myk «mmm» på én lett tone, som når man er enig med noen.\n3. Pust når du trenger det, og press aldri.\n4. Stopp hvis noe gjør vondt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ga comfortabel zitten en ontspan je schouders.\n2. Neurie zachtjes “mmm” op één makkelijke toon, alsof je het met iemand eens bent.\n3. Adem wanneer je maar wilt; forceer nooit.\n4. Stop als iets pijn doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Usiądź wygodnie i rozluźnij ramiona.\n2. Delikatnie nuć „mmm” na jednym wygodnym dźwięku, tak jak przy potakiwaniu komuś.\n3. Oddychaj, kiedy tylko trzeba; niczego nie forsuj.\n4. Przerwij, jeśli coś boli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sente-se confortavelmente e relaxe os ombros.\n2. Cantarole “mmm” suavemente em uma nota fácil, como se concordasse com alguém.\n3. Respire quando precisar; nunca force.\n4. Pare se algo doer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Așază-te confortabil și relaxează-ți umerii.\n2. Fredonează încet „mmm” pe o notă ușoară, ca și cum ai fi de acord cu cineva.\n3. Respiră oricând ai nevoie; nu forța niciodată.\n4. Oprește-te dacă ceva doare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Сядьте удобно и расслабьте плечи.\n2. Мягко гудите «ммм» на одной удобной ноте, как будто с кем-то соглашаетесь.\n3. Дышите, когда нужно; ничего не форсируйте.\n4. Остановитесь, если что-то болит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pohodlne sa usaďte a uvoľnite ramená.\n2. Jemne bzučte „mmm“ na jednom ľahkom tóne, akoby ste s niekým súhlasili.\n3. Nadýchnite sa, kedykoľvek treba; nikdy nenúťte.\n4. Prestaňte, ak niečo bolí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Udobno se usedite in sprostite ramena.\n2. Tiho brenčite „mmm“ na eni lahki noti, kot da se z nekom strinjate.\n3. Vdihnite, kadar koli je treba; nikoli ne silite.\n4. Prenehajte, če karkoli boli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sitt bekvämt och slappna av i axlarna.\n2. Nynna ett mjukt ”mmm” på en enda lätt ton, som när man håller med någon.\n3. Andas när du behöver och pressa aldrig.\n4. Sluta om något gör ont."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. นั่งให้สบายและผ่อนคลายหัวไหล่\n2. ฮัม “มมม” เบาๆ ที่โน้ตง่ายๆ หนึ่งเสียง เหมือนกำลังตอบรับใครสักคน\n3. หายใจเมื่อต้องการ อย่าฝืน\n4. หยุดทันทีถ้ารู้สึกเจ็บตรงไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Rahat oturun ve omuzlarınızı gevşetin.\n2. Biriyle aynı fikirdeymiş gibi, kolay bir notada yumuşakça “mmm” diye mırıldanın.\n3. İhtiyacınız olduğunda nefes alın; asla zorlamayın.\n4. Bir yer ağrırsa durun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Сядьте зручно й розслабте плечі.\n2. М’яко гудіть «ммм» на одній зручній ноті, ніби з кимось погоджуєтеся.\n3. Дихайте, коли потрібно; нічого не форсуйте.\n4. Зупиніться, якщо щось болить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ngồi thoải mái và thả lỏng vai.\n2. Ngân nga “mmm” nhẹ nhàng trên một nốt dễ chịu, như đang đồng tình với ai đó.\n3. Hít thở bất cứ khi nào bạn cần; đừng gắng sức.\n4. Dừng lại nếu có chỗ nào đau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 舒服地坐好，放松肩膀。\n2. 在一个轻松的音上轻声哼“嗯”，像在附和别人。\n3. 需要时随时换气，不要用力。\n4. 任何地方疼就停下来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 舒服地坐好，放鬆肩膀。\n2. 在一個輕鬆的音上輕聲哼「嗯」，像在附和別人。\n3. 需要時隨時換氣，不要用力。\n4. 任何地方會痛就停下來。"
          }
        }
      }
    },
