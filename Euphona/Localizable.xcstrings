    "coach_ex_vowel_bright_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجرى الصوتي الأقصر والأكثر تقدّمًا يرفع الفورمانتات، فيسمعها المستمعون صوتًا أكثر إشراقًا وأنثوية، بصرف النظر عن درجة الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tracte vocal més curt i avançat puja els formants, que es perceben com una veu més brillant i femenina, sigui quin sigui el to."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kratší a více vpředu položený hlasový trakt zvyšuje formanty, což posluchači vnímají jako jasnější, ženštější hlas bez ohledu na výšku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kortere, mere fremskudt ansatsrør hæver formanterne, hvilket lyttere hører som en lysere, mere feminin stemme, uafhængigt af tonehøjde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kürzerer, weiter vorn liegender Vokaltrakt hebt die Formanten an. Hörende nehmen das als hellere, weiblicher klingende Stimme wahr, unabhängig von der Tonhöhe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας πιο κοντός, πιο μπροστινός φωνητικός σωλήνας ανεβάζει τους συντονισμούς (formants), που οι ακροατές αντιλαμβάνονται ως πιο φωτεινή, πιο θηλυκή φωνή, ανεξάρτητα από το τονικό ύψος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shorter, more forward vocal tract raises the formants, which listeners hear as a brighter, more feminine voice, independent of pitch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tracto vocal más corto y adelantado sube los formantes, que se perciben como una voz más brillante y femenina, sea cual sea el tono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhyempi, edempänä oleva äänitorvi nostaa formantteja, minkä kuulija kuulee kirkkaampana, feminiinisempänä äänenä äänenkorkeudesta riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conduit vocal plus court et plus avancé élève les formants, ce que les auditeurs perçoivent comme une voix plus claire, plus féminine, indépendamment de la hauteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרכי קול קצרות וקדמיות יותר מעלות את הפורמנטים, ושומעים בכך קול בהיר ונשי יותר, ללא קשר לגובה הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी, ज़्यादा आगे की स्वर-नलिका फ़ॉर्मेंट को ऊँचा करती है, जिसे सुनने वाले पिच से अलग, ज़्यादा उजली और ज़्यादा स्त्रियोचित आवाज़ की तरह सुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraći i više naprijed postavljen glasovni trakt podiže formante, koje slušatelji čuju kao svjetliji, ženskiji glas, neovisno o visini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rövidebb és előrébb lévő hangtraktus emeli a formánsokat, amit a hallgatók világosabb, nőiesebb hangként hallanak, a hangmagasságtól függetlenül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran suara yang lebih pendek dan lebih ke depan menaikkan formant, yang didengar pendengar sebagai suara yang lebih cerah dan terdengar lebih feminin, terlepas dari nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tratto vocale più corto e avanzato alza i formanti, che chi ascolta percepisce come una voce più luminosa e femminile, a prescindere dal tono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声道が短く、より前寄りになるとフォルマントが上がり、聞き手には、ピッチとは関係なく、より明るく女性的な声として聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성도가 더 짧고 앞쪽에 있으면 포먼트가 올라가고, 듣는 사람은 음높이와 상관없이 더 밝고 여성적인 목소리로 들어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran suara yang lebih pendek dan lebih ke hadapan menaikkan formant, yang didengar pendengar sebagai suara yang lebih cerah dan kedengaran lebih feminin, tanpa mengira nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kortere, mer fremskutt ansatsrør hever formantene, noe lyttere hører som en lysere, mer feminin stemme, uavhengig av tonehøyde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een korter, meer naar voren liggend spraakkanaal verhoogt de formanten, wat luisteraars horen als een helderdere, vrouwelijkere stem, los van toonhoogte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótszy, bardziej wysunięty do przodu przewód głosowy podnosi formanty, co słuchacze odbierają jako jaśniejszy, bardziej kobiecy głos, niezależnie od wysokości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um trato vocal mais curto e avançado eleva os formantes, que são percebidos como uma voz mais brilhante e feminina, independentemente do tom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tract vocal mai scurt și mai în față ridică formanții, pe care ascultătorii îi aud ca o voce mai luminoasă, mai feminină, independent de înălțime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более короткий и выдвинутый вперёд голосовой тракт повышает форманты, и слушатели воспринимают это как более яркий, более женский голос независимо от высоты тона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kratší a viac vpredu položený hlasový trakt zvyšuje formanty, čo poslucháči vnímajú ako jasnejší, ženskejší hlas, nezávisle od výšky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krajši in bolj naprej postavljen glasovni trakt zviša formante, ki jih poslušalci slišijo kot svetlejši, bolj ženski glas, neodvisno od višine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kortare, mer framskjutet ansatsrör höjer formanterna, vilket lyssnare hör som en ljusare, mer feminin röst, oberoende av tonhöjd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่องเสียงที่สั้นและอยู่ข้างหน้ามากขึ้นทำให้ฟอร์มันต์สูงขึ้น ผู้ฟังได้ยินเป็นเสียงที่สดใสกว่า ฟังดูเป็นหญิงมากกว่า โดยไม่เกี่ยวกับระดับเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha kısa ve daha önde bir ses yolu formantları yükseltir; dinleyenler bunu perdeden bağımsız olarak daha parlak, daha dişil bir ses olarak duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коротший і висунутий уперед голосовий тракт підвищує форманти, і слухачі сприймають це як яскравіший, жіночніший голос незалежно від висоти тону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường phát âm ngắn hơn, hướng ra trước hơn làm các formant cao lên; người nghe cảm nhận đó là giọng sáng hơn, nữ tính hơn, bất kể cao độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更短、更靠前的声道会提高共振峰，听者会觉得声音更明亮、更女性化，这和音高无关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更短、更靠前的聲道會提高共振峰，聽者會覺得聲音更明亮、更女性化，這和音高無關。"
          }
        }
      }
    },
    "coach_ex_vowel_dark_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. قول «أووو» طويلة، كما في «نور».\n2. تدوير الشفتين وترك الفك ينخفض قليلًا.\n3. الإحساس بالصوت جالسًا منخفضًا في الحلق والصدر، دون ضغط.\n4. مراقبة النقطة وهي تتحرك إلى أسفل واليمين، نحو العلامات الزرقاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Digues una «uuu» llarga, com a «tu».\n2. Arrodoneix els llavis i deixa caure una mica la mandíbula.\n3. Nota com el so s’assenta baix a la gola i al pit, sense pressionar.\n4. Observa com el punt es mou cap avall i cap a la dreta, cap a les marques blaves."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Protáhněte dlouhé „úúú“, jako ve slově „buk“.\n2. Zakulaťte rty a mírně povolte čelist.\n3. Ucítěte, jak zvuk sedí nízko v hrdle a hrudi, bez tlaku.\n4. Sledujte, jak se tečka posouvá dolů a doprava k modrým orientačním bodům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sig et langt »ooo«, som i »sko«.\n2. Rund læberne, og lad kæben falde lidt.\n3. Mærk, at lyden sidder lavt i hals og bryst, uden at presse.\n4. Se prikken bevæge sig ned og mod højre, mod de blå pejlemærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sprich ein langes „uuu“, wie in „Mut“.\n2. Runde die Lippen und lass den Kiefer leicht sinken.\n3. Spüre, wie der Klang tief in Hals und Brust sitzt, ohne zu drücken.\n4. Sieh zu, wie der Punkt nach unten und rechts wandert, zu den blauen Markierungen hin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Πείτε ένα μακρύ «ουουου», όπως στη λέξη «πουλί».\n2. Στρογγυλέψτε τα χείλη και αφήστε το σαγόνι να χαμηλώσει ελαφρά.\n3. Νιώστε τον ήχο να κάθεται χαμηλά στον λαιμό και στο στήθος, χωρίς πίεση.\n4. Δείτε την τελεία να κινείται κάτω και δεξιά, προς τα μπλε ορόσημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Say a long “ooo”, as in “too”.\n2. Round your lips and let your jaw drop slightly.\n3. Feel the sound sit low in your throat and chest, without pressing.\n4. Watch the dot move down and right, toward the blue landmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Di una «uuu» larga, como en «tú».\n2. Redondea los labios y deja caer un poco la mandíbula.\n3. Nota cómo el sonido se asienta bajo en la garganta y el pecho, sin presionar.\n4. Observa cómo el punto se mueve hacia abajo y a la derecha, hacia las marcas azules."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sano pitkä ”ooo”.\n2. Pyöristä huulet ja anna leuan laskea hieman.\n3. Tunne, kuinka ääni istuu matalalla kurkussa ja rinnassa painamatta.\n4. Katso, kuinka piste liikkuu alas ja oikealle kohti sinisiä merkkejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Dites un long « ouuu », comme dans « fou ».\n2. Arrondissez les lèvres et laissez la mâchoire descendre légèrement.\n3. Sentez le son se placer bas dans la gorge et la poitrine, sans appuyer.\n4. Regardez le point descendre vers la droite, en direction des repères bleus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לומר “אוּ” ארוך, כמו ב“טוּב”.\n2. לעגל את השפתיים ולתת ללסת לרדת מעט.\n3. להרגיש את הצליל יושב נמוך בגרון ובחזה, בלי ללחוץ.\n4. לראות את הנקודה נעה למטה וימינה, לעבר הסימונים הכחולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “too” वाली लंबी “ऊऊऊ” कहें।\n2. होंठ गोल करें और जबड़े को थोड़ा नीचे आने दें।\n3. महसूस करें कि आवाज़ गले और सीने में नीचे बैठी है, बिना दबाए।\n4. बिंदु को नीचे और दाईं ओर, नीले निशानों की तरफ़ जाते देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Recite dugo „uuu“, kao u riječi „luna“.\n2. Zaokružite usne i pustite da čeljust lagano padne.\n3. Osjetite kako zvuk sjedi nisko u grlu i prsima, bez pritiska.\n4. Promatrajte kako se točka pomiče dolje i udesno, prema plavim orijentirima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mondj egy hosszú „úúú”-t, mint a „kút” szóban.\n2. Kerekítsd az ajkad, és hagyd egy kicsit leereszkedni az állkapcsod.\n3. Érezd, ahogy a hang mélyen ül a torkodban és a mellkasodban, nyomás nélkül.\n4. Figyeld, ahogy a pont lefelé és jobbra mozdul, a kék tájékozódási pontok felé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ucapkan “uuu” panjang, seperti pada “too”.\n2. Bulatkan bibir dan biarkan rahang turun sedikit.\n3. Rasakan suara berada rendah di tenggorokan dan dada, tanpa menekan.\n4. Lihat titik bergerak ke bawah dan kanan, menuju penanda biru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Di’ una «uuu» lunga, come in «tu».\n2. Arrotonda le labbra e lascia cadere un poco la mandibola.\n3. Senti il suono assestarsi in basso, nella gola e nel petto, senza premere.\n4. Guarda il punto spostarsi in basso e a destra, verso i riferimenti blu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「too」のように、長く「ウーー」と言います。\n2. 唇を丸め、あごを少し下げます。\n3. 押さえつけずに、音が喉と胸の低いところにあるのを感じます。\n4. 点が右下、青い目印のほうへ動くのを見ましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “too”의 소리처럼 “우우우” 하고 길게 말하세요.\n2. 입술을 동그랗게 하고 턱을 살짝 내리세요.\n3. 누르지 말고, 소리가 목과 가슴 낮은 곳에 자리한 느낌을 느껴 보세요.\n4. 점이 오른쪽 아래, 파란색 표시 쪽으로 움직이는 것을 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sebut “uuu” panjang, seperti dalam “too”.\n2. Bulatkan bibir dan biarkan rahang turun sedikit.\n3. Rasai bunyi berada rendah dalam tekak dan dada, tanpa menekan.\n4. Lihat titik bergerak ke bawah dan kanan, menuju penanda biru."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Si en lang «ooo», som i «sko».\n2. Rund leppene og la kjeven synke litt.\n3. Kjenn at lyden sitter lavt i hals og bryst, uten å presse.\n4. Se prikken bevege seg ned og mot høyre, mot de blå merkene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zeg een lange “oeee”, zoals in “boek”.\n2. Rond je lippen en laat je kaak iets zakken.\n3. Voel hoe het geluid laag in je keel en borst zit, zonder te duwen.\n4. Kijk hoe de stip omlaag en naar rechts beweegt, naar de blauwe markeringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Przeciągnij długie „uuu”, jak w słowie „buk”.\n2. Zaokrąglij usta i lekko opuść szczękę.\n3. Poczuj, jak dźwięk układa się nisko w gardle i klatce piersiowej, bez nacisku.\n4. Obserwuj, jak kropka przesuwa się w dół i w prawo, ku niebieskim punktom odniesienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Diga um “uuu” longo, como em “tu”.\n2. Arredonde os lábios e deixe a mandíbula cair um pouco.\n3. Sinta o som assentar embaixo, na garganta e no peito, sem pressionar.\n4. Veja o ponto descer e ir para a direita, em direção às marcas azuis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Spune un „uuu” lung, ca în „sul”.\n2. Rotunjește buzele și lasă maxilarul să coboare puțin.\n3. Simte sunetul așezat jos în gât și în piept, fără să apeși.\n4. Urmărește punctul cum se mută în jos și la dreapta, spre reperele albastre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Протяните «ууу», как в слове «луг».\n2. Округлите губы и слегка опустите челюсть.\n3. Почувствуйте, как звук располагается низко в горле и груди, без нажима.\n4. Следите, как точка движется вниз и вправо, к синим ориентирам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Povedzte dlhé „úúú“, ako v slove „múka“.\n2. Zaoblite pery a nechajte sánku mierne klesnúť.\n3. Pocíťte, ako zvuk sedí nízko v hrdle a hrudi, bez tlačenia.\n4. Sledujte, ako sa bod posúva dole a doprava, k modrým orientačným bodom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Recite dolg „uuu“, kot v besedi „luna“.\n2. Zaokrožite ustnice in pustite, da se čeljust rahlo spusti.\n3. Začutite, kako zvok sedi nizko v grlu in prsih, brez pritiskanja.\n4. Opazujte, kako se pika premika navzdol in v desno, proti modrim oporiščem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Säg ett långt ”ooo”, som i ”sko”.\n2. Runda läpparna och låt käken sjunka lite.\n3. Känn hur ljudet sitter lågt i hals och bröst, utan att pressa.\n4. Se hur pricken rör sig nedåt och åt höger, mot de blå riktmärkena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ออกเสียง “อูอู” ยาวๆ เหมือนใน “too”\n2. ห่อริมฝีปากและปล่อยกรามลงเล็กน้อย\n3. รู้สึกว่าเสียงอยู่ต่ำในลำคอและอก โดยไม่กดลง\n4. ดูจุดเคลื่อนลงไปทางขวา ไปหาเครื่องหมายสีน้ำเงิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “Uzun” sözcüğündeki gibi uzun bir “uuu” deyin.\n2. Dudaklarınızı yuvarlayın ve çenenizin hafifçe düşmesine izin verin.\n3. Sesin bastırmadan boğazınızın ve göğsünüzün alt kısmında durduğunu hissedin.\n4. Noktanın aşağı ve sağa, mavi işaretlere doğru hareket ettiğini izleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Протягніть «ууу», як у слові «луг».\n2. Округліть губи й злегка опустіть щелепу.\n3. Відчуйте, як звук міститься низько в горлі й грудях, без тиску.\n4. Стежте, як точка рухається вниз і праворуч, до синіх орієнтирів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kéo dài âm “uuu”, như trong “too”.\n2. Tròn môi và hạ hàm xuống một chút.\n3. Cảm nhận âm thanh nằm thấp trong cổ họng và ngực, không ép.\n4. Xem chấm di chuyển xuống và sang phải, về phía các điểm mốc màu xanh dương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 拖长说“乌”，像英文“too”。\n2. 嘴唇拢圆，下巴稍微放下。\n3. 感觉声音在喉咙和胸口低处，但不要压。\n4. 看圆点往右下方、往蓝色标记移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 拖長說「烏」，像英文的「too」。\n2. 嘴唇攏圓，下巴稍微放下。\n3. 感覺聲音在喉嚨和胸口低處，但不要壓。\n4. 看圓點往右下方、往藍色標記移動。"
          }
        }
      }
    },
    "coach_ex_vowel_dark_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفتان المدوّرتان تطيلان المجرى؛ لا تُدفع الحنجرة إلى الأسفل بقوة أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els llavis arrodonits allarguen el tracte; no empenyis mai la laringe cap avall amb força."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakulacené rty prodlužují trakt; hrtan nikdy netlačte silou dolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde læber forlænger ansatsrøret. Pres aldrig strubehovedet hårdt ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerundete Lippen verlängern den Trakt; drücke den Kehlkopf nie kräftig nach unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στρογγυλεμένα χείλη μακραίνουν τον σωλήνα· μην πιέζετε ποτέ τον λάρυγγα προς τα κάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounded lips lengthen the tract; never push the larynx down hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los labios redondeados alargan el tracto; nunca empujes la laringe hacia abajo con fuerza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyöristetyt huulet pidentävät äänitorvea. Älä koskaan paina kurkunpäätä voimalla alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des lèvres arrondies allongent le conduit ; ne poussez jamais le larynx vers le bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שפתיים מעוגלות מאריכות את דרכי הקול; לעולם לא לדחוף את הגרון למטה בכוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गोल होंठ नली को लंबा करते हैं; स्वरयंत्र को कभी ज़ोर से नीचे न दबाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaokružene usne produljuju trakt; grkljan nikad ne gurajte jako prema dolje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kerekített ajkak megnyújtják a traktust; a gégefőt soha ne told erősen lefelé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibir yang membulat memperpanjang saluran; jangan pernah menekan laring ke bawah dengan keras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le labbra arrotondate allungano il tratto; non spingere mai la laringe in basso con forza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唇を丸めると声道が伸びます。喉頭を無理に押し下げてはいけません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동그란 입술은 성도를 길게 해 줘요. 후두를 억지로 눌러 내리지는 마세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibir yang dibulatkan memanjangkan saluran; jangan sekali-kali menekan laring ke bawah dengan kuat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde lepper forlenger ansatsrøret. Press aldri strupehodet hardt ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afgeronde lippen verlengen het kanaal; duw het strottenhoofd nooit hard omlaag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaokrąglone usta wydłużają przewód; nigdy nie dociskaj krtani w dół."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lábios arredondados alongam o trato; nunca empurre a laringe para baixo com força."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buzele rotunjite lungesc tractul; nu împinge niciodată laringele tare în jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Округлённые губы удлиняют тракт; никогда не давите гортань вниз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaoblené pery predlžujú trakt; hrtan nikdy netlačte silno dole."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaokrožene ustnice podaljšajo trakt; grtanca nikoli ne potiskajte močno navzdol."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rundade läppar förlänger ansatsröret. Tryck aldrig ner struphuvudet hårt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ริมฝีปากที่ห่อทำให้ช่องเสียงยาวขึ้น อย่ากดกล่องเสียงลงแรงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvarlak dudaklar yolu uzatır; gırtlağı asla sertçe aşağı itmeyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Округлені губи подовжують тракт; ніколи не тисніть гортань донизу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môi tròn làm đường phát âm dài ra; đừng bao giờ ép thanh quản xuống mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拢圆嘴唇能加长声道；不要用力往下压喉咙。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "攏圓嘴唇能加長聲道；不要用力往下壓喉嚨。"
          }
        }
      }
    },
