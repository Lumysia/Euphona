    "dashboard_metric_flow_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى انتظام كلامك: إيقاعك وتوقفاتك. الأسلوب البطيء الهادئ لا يكلّف شيئًا؛ فقط الاستعجال أو التوقفات الطويلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com d’uniforme parles: la teva velocitat i les teves pauses. Un estil lent i tranquil no resta res; només la pressa o les aturades llargues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak vyrovnaně mluvíte: vaše tempo a vaše pauzy. Pomalý, klidný styl nestojí nic; snižuje jen spěch nebo dlouhá zastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor jævnt du taler: dit tempo og dine pauser. En langsom, rolig stil koster ingenting. Det gør kun hastværk og lange stop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie gleichmäßig du sprichst: dein Tempo und deine Pausen. Ein langsamer, ruhiger Stil kostet nichts; nur Hetzen oder lange Stopps wirken sich aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο ομοιόμορφα μιλάτε: ο ρυθμός και οι παύσεις σας. Ένα αργό, ήρεμο στιλ δεν κοστίζει τίποτα· μόνο η βιασύνη ή οι μεγάλες στάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How evenly you speak: your pace and your pauses. A slow, calm style costs nothing; only rushing or long stops do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo parejo que hablas: tu velocidad y tus pausas. Un estilo lento y tranquilo no resta nada; solo las prisas o las paradas largas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka tasaisesti puhut: tahtisi ja taukosi. Hidas, rauhallinen tyyli ei maksa mitään; vain kiire ja pitkät tauot maksavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quel point votre parole est régulière : votre rythme et vos pauses. Un style lent et calme ne coûte rien ; seuls la précipitation ou les longs arrêts comptent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עד כמה אחיד הדיבור שלך: הקצב וההפסקות. סגנון איטי ורגוע לא עולה בכלום; רק מהירות יתר או עצירות ארוכות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलने में कितनी एकरूपता है: गति और ठहराव। धीमी, शांत शैली से कुछ नहीं घटता; सिर्फ़ जल्दबाज़ी या लंबे रुकाव घटाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko ravnomjerno govorite: vaš tempo i stanke. Spor, miran stil ne košta ništa; samo žurba ili duge stanke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyire egyenletesen beszélsz: a tempód és a szüneteid. A lassú, nyugodt stílus nem kerül semmibe; csak a sietés vagy a hosszú megállások."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa merata Anda berbicara: tempo dan jeda. Gaya yang lambat dan tenang tidak mengurangi apa pun; hanya terburu-buru atau berhenti lama yang mengurangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto è regolare il tuo parlato: andatura e pause. Uno stile lento e calmo non costa nulla; solo la fretta o le pause lunghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どれだけ均等に話せているか。ペースと間のことです。ゆっくり落ち着いた話し方は減点されません。減点されるのは、急ぎすぎや長い中断だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼마나 고르게 말하는지, 즉 속도와 쉼이에요. 느리고 차분한 말투는 감점되지 않아요. 서두르거나 오래 멈출 때만 감점돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betapa sekata anda bertutur: kadar dan jeda anda. Gaya yang perlahan dan tenang tidak menjejaskan apa-apa; hanya tergesa-gesa atau berhenti lama yang menjejaskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor jevnt du snakker: tempoet og pausene dine. En langsom, rolig stil koster ingenting. Det er bare hastverk og lange stopp som gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe gelijkmatig je spreekt: je tempo en je pauzes. Een langzame, rustige stijl kost niets; alleen haasten of lange stops tellen mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak równo mówisz: Twoje tempo i przerwy. Wolny, spokojny styl nic nie kosztuje; liczy się tylko pośpiech lub długie przerwy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão constante é a sua fala: andamento e pausas. Um jeito lento e calmo não custa nada; só a pressa ou as paradas longas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de egal vorbești: ritmul și pauzele tale. Un stil lent și calm nu costă nimic; contează doar graba sau opririle lungi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько ровно вы говорите: ваш темп и ваши паузы. Медленная спокойная манера ничего не стоит; снижают оценку только спешка и долгие остановки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako rovnomerne hovoríte: vaše tempo a pauzy. Pomalý, pokojný štýl nič nestojí; iba ponáhľanie alebo dlhé zastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako enakomerno govorite: vaše tempo in premori. Počasen, miren slog ne stane nič; le hitenje ali dolgi premori."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur jämnt du talar: din takt och dina pauser. En långsam, lugn stil kostar ingenting. Bara hets och långa stopp gör det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณพูดสม่ำเสมอเพียงใด: จังหวะและการหยุดพัก สไตล์ที่ช้าและสงบไม่เสียคะแนน เสียเฉพาะการรีบพูดหรือหยุดนาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kadar düzenli konuştuğunuz: hızınız ve duraklarınız. Yavaş, sakin bir tarz hiçbir şeye mal olmaz; yalnızca acele etmek veya uzun duraklar olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки рівно ви говорите: ваш темп і ваші паузи. Повільна спокійна манера нічого не коштує; знижують оцінку лише поспіх і довгі зупинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nói đều đặn đến đâu: tốc độ và các quãng nghỉ. Phong cách chậm, bình tĩnh không bị trừ điểm; chỉ vội vàng hoặc ngừng quá lâu mới bị trừ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说话有多均匀：语速和停顿。慢而平稳的风格不扣分，只有赶得太快或长时间停顿才会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說話有多均勻：語速和停頓。慢而平穩的風格不扣分，只有趕得太快或長時間停頓才會。"
          }
        }
      }
    },
