    "dashboard_metric_timbre_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يُقرأ لون صوتك من خلال رنينه، كما يقيسه نموذج Euphona الخاص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com es percep el color de la teva veu, a partir de la ressonància, mesurat pel model propi d’Euphona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak se čte barva vašeho hlasu podle jeho rezonance, měřená vlastním modelem Euphony."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan din stemmes farve opfattes ud fra dens resonans, målt af Euphonas egen model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie die Farbe deiner Stimme wirkt, abgeleitet aus ihrer Resonanz und gemessen vom eigenen Modell von Euphona."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς διαβάζεται το χρώμα της φωνής σας, από την αντήχησή της, όπως το μετρά το δικό του μοντέλο του Euphona."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the color of your voice reads, from its resonance, measured by Euphona’s own model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se percibe el color de tu voz, a partir de su resonancia, medido por el propio modelo de Euphona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miltä äänesi väri kuulostaa resonanssin perusteella, Euphonan oman mallin mittaamana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment se lit la couleur de votre voix, à partir de sa résonance, mesurée par le modèle propre à Euphona."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איך נקרא צבע הקול שלך, לפי התהודה שלו, כפי שנמדד במודל של Euphona עצמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euphona के अपने मॉडल द्वारा अनुनाद से मापा गया कि आपकी आवाज़ का रंग कैसा सुनाई देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako se čita boja vašeg glasa iz njegove rezonancije, mjereno Euphoninim vlastitim modelom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogyan olvasható le a hangod színe a rezonanciájából, az Euphona saját modelljével mérve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana warna suara Anda terbaca, dari resonansinya, diukur oleh model Euphona sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come si percepisce il colore della tua voce, dalla sua risonanza, misurato dal modello di Euphona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共鳴から読み取った声の色合いを、Euphona 独自のモデルで測定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공명을 바탕으로 목소리의 색깔이 어떻게 들리는지를 Euphona의 자체 모델로 측정해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana warna suara anda terbaca, daripada resonansnya, diukur oleh model Euphona sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan fargen på stemmen din oppfattes ut fra resonansen, målt av Euphonas egen modell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe de kleur van je stem overkomt, gebaseerd op de resonantie, gemeten door het eigen model van Euphona."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak odczytywana jest barwa Twojego głosu na podstawie jego rezonansu, mierzona własnym modelem Euphony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a cor da sua voz é percebida, a partir da ressonância, medida pelo modelo próprio do Euphona."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum se citește culoarea vocii tale, pornind de la rezonanță, măsurată de modelul propriu al Euphona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какой «цвет» имеет ваш голос по его резонансу; измеряется собственной моделью Euphona."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako sa číta farba vášho hlasu z jeho rezonancie, meraná vlastným modelom Euphony."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako se bere barva vašega glasu iz njegove resonance, izmerjena z Euphoninim lastnim modelom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur din rösts färg uppfattas utifrån dess resonans, mätt av Euphonas egen modell."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีเสียงของคุณฟังดูเป็นอย่างไร จากเรโซแนนซ์ วัดโดยโมเดลของ Euphona เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinizin rengi, rezonansından okunduğunda nasıl görünüyor; Euphona’nın kendi modeliyle ölçülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який «колір» має ваш голос за його резонансом; вимірюється власною моделлю Euphona."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu giọng của bạn nghe ra sao, dựa trên cộng hưởng, do mô hình riêng của Euphona đo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 Euphona 自己的模型根据共鸣判断你的音色听起来偏向哪一边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 Euphona 自己的模型根據共鳴判斷你的音色聽起來偏向哪一邊。"
          }
        }
      }
    },
