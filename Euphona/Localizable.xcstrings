    "coach_answer_rest" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنُرح الصوت اليوم: دندنة خفيفة فقط. وإن كان هناك ألم أو بقيت بحّة فيُستحسن الراحة حتى يتحسن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avui deixem reposar la veu: només taral·leig suau. Si fa mal o continua la ronquera, descansa fins que et trobis millor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes dopřejme hlasu odpočinek: jen jemné broukání. Pokud to bolí nebo chrapot nemizí, odpočívejte, dokud se to nezlepší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad os hvile stemmen i dag: kun blid nynnen. Hvis det gør ondt, eller stemmen er hæs, så hvil, til det føles bedre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns deine Stimme heute schonen: nur sanftes Summen. Wenn es wehtut oder die Heiserkeit bleibt, ruh dich aus, bis es besser wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ας ξεκουράσουμε σήμερα τη φωνή: μόνο απαλό μουρμούρισμα. Αν πονάει ή παραμένει βραχνή, ξεκουραστείτε μέχρι να νιώσετε καλύτερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let’s rest your voice today: only gentle humming. If it hurts or stays hoarse, rest until it feels better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos a descansar la voz hoy: solo tarareo suave. Si duele o sigue la ronquera, descansa hasta que mejore."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levätään äänelle tänään: vain pehmeää huminaa. Jos siihen sattuu tai se on käheä, lepää, kunnes olo paranee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposons votre voix aujourd’hui : seulement des bourdonnements doux. En cas de douleur ou d’enrouement persistant, reposez-vous jusqu’à ce que cela aille mieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן היום לקול לנוח: רק זמזום עדין. אם כואב או שהקול נשאר צרוד, כדאי לנוח עד שירגיש טוב יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइए आज आवाज़ को आराम दें: सिर्फ़ हल्की गुनगुनाहट। अगर दर्द हो या आवाज़ भर्राई रहे, तो ठीक लगने तक आराम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danas pustimo glas da se odmori: samo nježno brujanje. Ako boli ili promuklost ostaje, odmarajte dok ne bude bolje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma pihentessük a hangodat: csak halk dúdolás. Ha fáj, vagy rekedt marad, pihenj, amíg jobb nem lesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mari istirahatkan suara hari ini: hanya bersenandung lembut. Jika terasa sakit atau tetap serak, istirahatlah sampai terasa lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi facciamo riposare la voce: solo canticchio dolce. Se fa male o resta rauca, riposa finché non va meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は声を休ませましょう。やさしいハミングだけにします。痛みやかすれがある場合は、良くなるまで休んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 목소리를 쉬게 해요. 부드러운 허밍만 해 보세요. 아프거나 목이 쉬어 있으면 나아질 때까지 쉬세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mari rehatkan suara hari ini: hanya senandung lembut. Jika terasa sakit atau terus serak, berehatlah sehingga lebih baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss hvile stemmen i dag: bare myk nynning. Hvis det gjør vondt eller stemmen er hes, hvil til det føles bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laten we je stem vandaag rust geven: alleen zacht neuriën. Als het pijn doet of je stem hees blijft, rust dan uit tot het beter voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajmy dziś głosowi odpocząć: tylko łagodne nucenie. Jeśli boli albo chrypka nie mija, odpoczywaj, aż poczujesz się lepiej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos descansar a voz hoje: só cantarolar suave. Se doer ou continuar rouca, descanse até melhorar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Să-ți odihnim vocea azi: doar fredonat ușor. Dacă te doare sau răgușeala rămâne, odihnește-te până te simți mai bine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дадим голосу отдохнуть: сегодня только мягкое гудение. Если появилась боль или хрипота не проходит, отдыхайте, пока не станет лучше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes hlas oddýchnime: iba jemné bzučanie. Ak to bolí alebo chrapot pretrváva, oddychujte, kým sa to nezlepší."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danes glasu ne obremenimo: samo nežno brenčanje. Če boli ali hripavost ostaja, počivajte, dokler ni bolje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi låter rösten vila i dag: bara lugnt nynnande. Om det gör ont eller rösten är hes, vila tills det känns bättre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้พักเสียงกันเถอะ: ฮัมเบาๆ เท่านั้น หากเจ็บหรือเสียงแหบ ให้พักจนกว่าจะรู้สึกดีขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün sesinizi dinlendirelim: yalnızca hafif mırıldanma. Ağrıyorsa veya kısık kalıyorsa kendinizi daha iyi hissedene kadar dinlenin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дамо голосу відпочити: сьогодні лише м’яке гудіння. Якщо голос болить або захриплість не минає, відпочивайте, доки не стане краще."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay hãy để giọng nghỉ ngơi: chỉ ngân nga nhẹ nhàng thôi. Nếu đau hoặc khàn kéo dài, hãy nghỉ cho đến khi thấy khá hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天让嗓子休息吧，只做轻柔的哼鸣。如果疼痛或一直沙哑，就休息到好了再练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天讓嗓子休息吧，只做輕柔的哼鳴。如果會痛或一直沙啞，就休息到好了再練。"
          }
        }
      }
    },
