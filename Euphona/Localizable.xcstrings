    "coach_ex_hum_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم للراحة. الدندنة الهادئة تُبقي الصوت متحركًا دون إجهاد؛ وإذا استمر الألم أو البحّة أكثر من أسبوعين فيُستحسن مراجعة طبيب أو أخصائي نطق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avui toca descansar. El taral·leig tranquil manté la veu en moviment sense esforç; si el dolor o la ronquera duren més de dues setmanes, consulta un metge o un logopeda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes je den odpočinku. Tiché broukání udržuje hlas v pohybu bez námahy; pokud bolest nebo chrapot trvají déle než dva týdny, navštivte lékaře nebo logopeda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag er en hviledag. Stille nynnen holder stemmen i gang uden anstrengelse. Hvis smerter eller hæshed varer mere end to uger, så kontakt en læge eller en logopæd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist Ruhetag. Leises Summen hält die Stimme ohne Anstrengung in Bewegung; wenn Schmerzen oder Heiserkeit länger als zwei Wochen anhalten, such ärztlichen oder logopädischen Rat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σημερινή μέρα είναι για ξεκούραση. Το χαμηλόφωνο μουρμούρισμα κρατά τη φωνή σε κίνηση χωρίς κόπωση· αν ο πόνος ή η βραχνάδα διαρκούν περισσότερο από δύο εβδομάδες, απευθυνθείτε σε γιατρό ή λογοθεραπευτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is for rest. Quiet humming keeps the voice moving without strain; if pain or hoarseness lasts more than two weeks, see a doctor or speech therapist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy toca descansar. El tarareo tranquilo mantiene la voz en movimiento sin esfuerzo; si el dolor o la ronquera duran más de dos semanas, consulta a un médico o a un logopeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänään levätään. Hiljainen humina pitää äänen liikkeessä rasittamatta. Jos kipu tai käheys jatkuu yli kaksi viikkoa, hakeudu lääkärille tai puheterapeutille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui est un jour de repos. Un bourdonnement discret fait travailler la voix sans effort ; si une douleur ou un enrouement dure plus de deux semaines, consultez un médecin ou un orthophoniste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היום מיועד למנוחה. זמזום שקט שומר על תנועת הקול בלי מאמץ; אם כאב או צרידות נמשכים יותר משבועיים, יש לפנות לרופא או לקלינאי תקשורת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज आराम का दिन है। धीमी गुनगुनाहट आवाज़ को बिना खिंचाव के चलाती रहती है; दो हफ़्ते से ज़्यादा दर्द या आवाज़ भर्राई रहे, तो डॉक्टर या स्पीच थेरेपिस्ट को दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danas je dan za odmor. Tiho brujanje drži glas u pokretu bez naprezanja; ako bol ili promuklost traje dulje od dva tjedna, posjetite liječnika ili logopeda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai nap a pihenésé. A halk dúdolás megerőltetés nélkül mozgásban tartja a hangot; ha a fájdalom vagy a rekedtség két hétnél tovább tart, fordulj orvoshoz vagy logopédushoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini untuk istirahat. Senandung pelan menjaga suara tetap bergerak tanpa tegang; jika sakit atau serak berlangsung lebih dari dua minggu, temui dokter atau terapis wicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi si riposa. Canticchiare piano mantiene la voce in movimento senza sforzo; se dolore o raucedine durano più di due settimane, rivolgiti a un medico o a un logopedista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は休息の日です。静かなハミングなら、負担をかけずに声を動かし続けられます。痛みやかすれが 2 週間以上続く場合は、医師または言語聴覚士に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 쉬는 날이에요. 조용한 허밍은 무리 없이 목소리를 움직여 줘요. 통증이나 목쉼이 2주 넘게 이어지면 의사나 언어치료사를 찾아가 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini untuk berehat. Senandung perlahan memastikan suara terus bergerak tanpa ketegangan; jika sakit atau serak berlarutan lebih daripada dua minggu, jumpa doktor atau ahli terapi pertuturan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag er det hvile. Stille nynning holder stemmen i gang uten anstrengelse. Hvis smerte eller heshet varer i mer enn to uker, ta kontakt med lege eller logoped."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag is om uit te rusten. Rustig neuriën houdt de stem in beweging zonder inspanning; als pijn of heesheid langer dan twee weken duurt, ga dan naar een arts of logopedist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś jest dzień odpoczynku. Ciche nucenie utrzymuje głos w ruchu bez wysiłku; jeśli ból lub chrypka trwają dłużej niż dwa tygodnie, zgłoś się do lekarza lub logopedy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje é dia de descanso. Cantarolar baixinho mantém a voz em movimento sem esforço; se dor ou rouquidão durarem mais de duas semanas, procure um médico ou fonoaudiólogo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azi este pentru odihnă. Fredonatul liniștit menține vocea în mișcare fără efort; dacă durerea sau răgușeala durează mai mult de două săptămâni, mergi la un medic sau la un logoped."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня день отдыха. Тихое гудение поддерживает голос в движении без напряжения; если боль или хрипота длятся больше двух недель, обратитесь к врачу или логопеду."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes je deň oddychu. Tiché bzučanie udrží hlas v pohybe bez namáhania; ak bolesť alebo chrapot trvá dlhšie ako dva týždne, navštívte lekára alebo logopéda."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danes je dan za počitek. Tiho brenčanje ohranja glas v gibanju brez napora; če bolečina ali hripavost traja več kot dva tedna, obiščite zdravnika ali logopeda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag är det vila. Tyst nynnande håller rösten igång utan ansträngning. Om smärta eller heshet varar i mer än två veckor, kontakta läkare eller logoped."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้เป็นวันพัก การฮัมเบาๆ ช่วยให้เสียงได้ขยับโดยไม่ตึงเครียด หากเจ็บหรือเสียงแหบนานกว่าสองสัปดาห์ ควรไปพบแพทย์หรือนักแก้ไขการพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün dinlenme günü. Sessiz mırıldanma sesi zorlamadan hareket halinde tutar; ağrı veya kısıklık iki haftadan uzun sürerse bir doktora ya da konuşma terapistine görünün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сьогодні день відпочинку. Тихе гудіння підтримує голос у русі без напруження; якщо біль або захриплість тривають понад два тижні, зверніться до лікаря чи логопеда."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay là ngày nghỉ. Ngân nga khe khẽ giúp giọng vẫn hoạt động mà không bị căng; nếu đau hoặc khàn giọng kéo dài hơn hai tuần, hãy đi khám bác sĩ hoặc chuyên gia trị liệu ngôn ngữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以休息为主。轻声哼鸣能让声音活动起来但不费力。如果疼痛或沙哑持续超过两周，请看医生或言语治疗师。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天以休息為主。輕聲哼鳴能讓聲音活動起來但不費力。如果疼痛或沙啞持續超過兩週，請看醫師或語言治療師。"
          }
        }
      }
    },
    "coach_ex_lip_trill_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. إغلاق الشفتين بارتخاء والنفخ حتى ترتجّا، مثل قارب بمحرك.\n2. إضافة صوت لطيف إلى الارتجاج.\n3. الانزلاق صعودًا وهبوطًا مثل صفارة إنذار بطيئة.\n4. إذا توقفت الشفتان، يمكن الضغط على الخدّين برفق بأطراف الأصابع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tanca els llavis sense estrènyer i bufa perquè vibrin, com una llanxa motora.\n2. Afegeix una mica de veu a la vibració.\n3. Llisca amunt i avall, com una sirena lenta.\n4. Si els llavis s’aturen, pressiona suaument les galtes amb la punta dels dits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Volně sevřete rty a vydechněte tak, aby se rozvibrovaly jako motor člunu.\n2. K vibrování přidejte jemný hlas.\n3. Klouzejte nahoru a dolů jako pomalá siréna.\n4. Pokud rty přestanou vibrovat, lehce stiskněte konečky prstů tváře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Luk læberne løst, og blæs, så de flagrer, som en motorbåd.\n2. Tilføj lidt stemme til flagrenet.\n3. Glid op og ned som en langsom sirene.\n4. Hvis læberne stopper, så tryk let på kinderne med fingerspidserne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Schließe die Lippen locker und blase, sodass sie flattern, wie ein Motorboot.\n2. Gib dem Flattern eine sanfte Stimme.\n3. Gleite auf und ab wie eine langsame Sirene.\n4. Wenn die Lippen aufhören, drücke mit den Fingerspitzen leicht auf die Wangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Κλείστε χαλαρά τα χείλη και φυσήξτε ώστε να πάλλονται, σαν μηχανάκι.\n2. Προσθέστε μια απαλή φωνή στην πάλλουσα ροή.\n3. Γλιστρήστε προς τα πάνω και προς τα κάτω σαν αργή σειρήνα.\n4. Αν τα χείλη σταματήσουν, πιέστε ελαφρά τα μάγουλα με τα δάχτυλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Close your lips loosely and blow so they flutter, like a motorboat.\n2. Add a gentle voice to the flutter.\n3. Glide up and down like a slow siren.\n4. If your lips stop, press your cheeks lightly with your fingertips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Cierra los labios sin apretar y sopla para que vibren, como una lancha motora.\n2. Añade un poco de voz a la vibración.\n3. Desliza la voz arriba y abajo, como una sirena lenta.\n4. Si los labios se paran, presiona suavemente las mejillas con las yemas de los dedos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sulje huulet löyhästi ja puhalla niin, että ne värisevät kuin moottorivene.\n2. Lisää väristykseen kevyt ääni.\n3. Liu’u ylös ja alas kuin hidas sireeni.\n4. Jos huulet pysähtyvät, paina poskia kevyesti sormenpäillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Fermez les lèvres sans les serrer et soufflez pour qu’elles vibrent, comme un bateau à moteur.\n2. Ajoutez une voix douce à la vibration.\n3. Glissez vers le haut et vers le bas comme une sirène lente.\n4. Si vos lèvres s’arrêtent, appuyez légèrement sur vos joues du bout des doigts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לסגור את השפתיים בחופשיות ולפוח כך שירטטו, כמו סירת מנוע.\n2. להוסיף קול עדין לרטט.\n3. להחליק למעלה ולמטה כמו סירנה איטית.\n4. אם השפתיים נעצרות, ללחוץ קלות על הלחיים בקצות האצבעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. होंठ ढीले बंद करें और फूँकें ताकि वे थरथराएँ, जैसे मोटरबोट की आवाज़।\n2. थरथराहट में हल्की आवाज़ जोड़ें।\n3. धीमे सायरन की तरह ऊपर-नीचे फिसलें।\n4. होंठ रुक जाएँ तो उँगलियों से गालों को हल्के से दबाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lagano zatvorite usne i puhnite da zatitraju, kao motorni čamac.\n2. Titranju dodajte nježan glas.\n3. Kližite gore i dolje kao spora sirena.\n4. Ako se usne zaustave, jagodicama prstiju lagano pritisnite obraze."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zárd lazán össze az ajkad, és fújj, hogy rezegjen, mint egy motorcsónak.\n2. Adj a rezgéshez halk hangot.\n3. Csúsztass fel és le, mint egy lassú sziréna.\n4. Ha az ajkad megáll, nyomd meg finoman az arcod az ujjbegyeiddel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Katupkan bibir dengan longgar dan tiup agar bergetar, seperti suara perahu motor.\n2. Tambahkan suara lembut pada getaran itu.\n3. Luncurkan nada naik dan turun seperti sirene yang lambat.\n4. Jika bibir berhenti bergetar, tekan pipi dengan lembut memakai ujung jari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Chiudi le labbra senza stringere e soffia in modo che vibrino, come un motoscafo.\n2. Aggiungi un po’ di voce alla vibrazione.\n3. Scivola su e giù, come una sirena lenta.\n4. Se le labbra si fermano, premi leggermente le guance con la punta delle dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 唇を軽く閉じ、息を吹いてモーターボートのように震わせます。\n2. 震えに、やさしく声を加えます。\n3. ゆっくりしたサイレンのように、音を上下になめらかに動かします。\n4. 唇が止まってしまうときは、指先で頬を軽く支えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 입술을 느슨하게 닫고 바람을 불어 모터보트처럼 떨리게 하세요.\n2. 떨림에 부드러운 소리를 더하세요.\n3. 느린 사이렌처럼 위아래로 부드럽게 미끄러져 보세요.\n4. 입술이 멈추면 손끝으로 볼을 가볍게 받쳐 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Katup bibir dengan longgar dan tiup supaya bergetar, seperti bunyi bot motor.\n2. Tambahkan suara lembut pada getaran itu.\n3. Luncurkan naik dan turun seperti siren yang perlahan.\n4. Jika bibir berhenti bergetar, tekan pipi dengan lembut menggunakan hujung jari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lukk leppene løst og blås slik at de vibrerer, som en motorbåt.\n2. Legg til litt stemme i vibreringen.\n3. Glid opp og ned som en langsom sirene.\n4. Hvis leppene stopper, trykk lett mot kinnene med fingertuppene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sluit je lippen losjes en blaas zodat ze fladderen, als een motorboot.\n2. Voeg een zachte stem toe aan het fladderen.\n3. Glij omhoog en omlaag als een langzame sirene.\n4. Als je lippen stoppen, druk dan met je vingertoppen licht op je wangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Luźno zamknij usta i dmuchnij tak, aby zadrżały, jak silnik motorówki.\n2. Dodaj do drżenia delikatny głos.\n3. Przesuwaj dźwięk w górę i w dół jak wolna syrena.\n4. Jeśli usta przestaną drgać, lekko przyciśnij policzki palcami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Feche os lábios sem apertar e sopre para que vibrem, como uma lancha a motor.\n2. Acrescente um pouco de voz à vibração.\n3. Deslize para cima e para baixo, como uma sirene lenta.\n4. Se os lábios pararem, pressione de leve as bochechas com a ponta dos dedos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Închide buzele lejer și suflă astfel încât să vibreze, ca o barcă cu motor.\n2. Adaugă o voce blândă vibrației.\n3. Alunecă în sus și în jos ca o sirenă lentă.\n4. Dacă buzele se opresc, apasă ușor obrajii cu vârful degetelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Свободно сомкните губы и выдохните так, чтобы они затрепетали, как мотор лодки.\n2. Добавьте к трепету мягкий голос.\n3. Скользите вверх и вниз, как медленная сирена.\n4. Если губы перестали трепетать, слегка прижмите щёки кончиками пальцев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Voľne zatvorte pery a fúkajte, aby sa rozochveli, ako motorový čln.\n2. Pridajte k chveniu jemný hlas.\n3. Kĺžte hore a dole ako pomalá siréna.\n4. Ak sa pery zastavia, jemne pritlačte končekmi prstov líca."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Rahlo zaprite ustnice in pihajte, da zatrepetajo, kot motorni čoln.\n2. Trepetanju dodajte nežen glas.\n3. Drsite gor in dol kot počasna sirena.\n4. Če se ustnice ustavijo, z blazinicami prstov rahlo pritisnite ličnice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Slut läpparna löst och blås så att de fladdrar, som en motorbåt.\n2. Lägg till lite röst i fladdret.\n3. Glid upp och ner som en långsam siren.\n4. Om läpparna stannar, tryck lätt mot kinderna med fingertopparna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ปิดริมฝีปากหลวมๆ แล้วเป่าลมให้สั่น เหมือนเสียงเรือยนต์\n2. ใส่เสียงเบาๆ ลงไปในเสียงสั่นนั้น\n3. เลื่อนเสียงขึ้นลงช้าๆ เหมือนไซเรน\n4. ถ้าริมฝีปากหยุดสั่น ให้ใช้ปลายนิ้วดันแก้มเบาๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Dudaklarınızı gevşekçe kapatın ve motorbot gibi titreşecek şekilde üfleyin.\n2. Titreşime hafif bir ses ekleyin.\n3. Yavaş bir siren gibi yukarı ve aşağı kayın.\n4. Dudaklarınız durursa parmak uçlarınızla yanaklarınıza hafifçe bastırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Вільно зімкніть губи й видихніть так, щоб вони затремтіли, як мотор човна.\n2. Додайте до тремтіння м’який голос.\n3. Ковзайте вгору й вниз, як повільна сирена.\n4. Якщо губи перестали тремтіти, злегка притисніть щоки кінчиками пальців."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Khép môi lỏng và thổi hơi để môi rung lên, như tiếng ca nô máy.\n2. Thêm giọng nhẹ vào tiếng rung đó.\n3. Lướt lên xuống như một hồi còi báo động chậm.\n4. Nếu môi ngừng rung, hãy dùng đầu ngón tay đỡ nhẹ hai má."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 嘴唇轻轻闭合，吹气让它们抖动，像小摩托艇的声音。\n2. 在抖动里加上轻柔的声音。\n3. 像慢速警笛一样上下滑音。\n4. 如果嘴唇停下来，可以用指尖轻轻托住脸颊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 嘴唇輕輕閉合，吹氣讓它們抖動，像小摩托艇的聲音。\n2. 在抖動裡加上輕柔的聲音。\n3. 像慢速警笛一樣上下滑音。\n4. 如果嘴唇停下來，可以用指尖輕輕托住臉頰。"
          }
        }
      }
    },
    "coach_ex_lip_trill_tip" : {
