    "coach_ex_timbre_words_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقياس جرس الصوت يستمع إلى الصوت كله، كما تفعل الدرجة الإجمالية، فيُظهر إن كان الرنين يثبت في كلمات حقيقية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mesurador de timbre escolta tota la veu, igual que la puntuació global, així que mostra si la ressonància es manté en paraules reals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazatel barvy poslouchá celý hlas, stejně jako celkové hodnocení, takže ukáže, jestli rezonance vydrží ve skutečných slovech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfarvemåleren lytter til hele stemmen, ligesom den samlede score gør, så den viser, om resonansen holder i rigtige ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Klangfarben-Anzeige hört auf die ganze Stimme, so wie auch der Gesamtwert, und zeigt daher, ob die Resonanz in echten Wörtern hält."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο μετρητής χροιάς ακούει ολόκληρη τη φωνή, όπως και η συνολική βαθμολογία, και έτσι δείχνει αν η αντήχηση κρατά σε πραγματικές λέξεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timbre meter listens to the whole voice, the way the overall score does, so it shows whether resonance holds up in real words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El medidor de timbre escucha toda la voz, igual que la puntuación global, así que muestra si la resonancia se mantiene en palabras reales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenvärimittari kuuntelee koko ääntä samoin kuin kokonaispisteet, joten se näyttää, pysyykö resonanssi todellisissa sanoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indicateur de timbre écoute toute la voix, comme le fait le score global ; il montre donc si la résonance tient dans de vrais mots."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מד הגוון מאזין לקול כולו, כמו הציון הכללי, ולכן הוא מראה אם התהודה מחזיקה במילים אמיתיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वर-रंग मीटर पूरी आवाज़ को सुनता है, ठीक कुल स्कोर की तरह, इसलिए यह दिखाता है कि असली शब्दों में अनुनाद टिकता है या नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjerač boje glasa sluša cijeli glas, kao i ukupni rezultat, pa pokazuje drži li se rezonancija i u stvarnim riječima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangszín-mérő az egész hangot hallgatja, ahogy az összpontszám is, így megmutatja, kitart-e a rezonancia valódi szavakban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengukur timbre mendengarkan seluruh suara, seperti skor keseluruhan, sehingga terlihat apakah resonansi bertahan dalam kata yang nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il misuratore del timbro ascolta tutta la voce, come il punteggio complessivo, quindi mostra se la risonanza regge in parole vere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色メーターは、総合スコアと同じように声全体を聞き取るので、実際の単語の中でも共鳴が保てているかがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음색 미터는 종합 점수처럼 목소리 전체를 듣기 때문에, 실제 단어에서도 공명이 유지되는지 알 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meter timbre mendengar seluruh suara, seperti skor keseluruhan, jadi ia menunjukkan sama ada resonans bertahan dalam perkataan sebenar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfargemåleren lytter til hele stemmen, slik den samlede poengsummen gjør, så den viser om resonansen holder i ekte ord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De klankkleurmeter luistert naar de hele stem, net als de totaalscore, en laat dus zien of de resonantie standhoudt in echte woorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskaźnik barwy słucha całego głosu, tak jak ocena ogólna, więc pokazuje, czy rezonans utrzymuje się w prawdziwych słowach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O medidor de timbre escuta a voz inteira, como a pontuação geral, então mostra se a ressonância se mantém em palavras de verdade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatorul de timbru ascultă întreaga voce, așa cum face scorul general, deci arată dacă rezonanța se menține în cuvinte reale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индикатор тембра слушает весь голос, так же как и общая оценка, поэтому показывает, держится ли резонанс в настоящих словах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazovateľ farby hlasu počúva celý hlas, rovnako ako celkové skóre, takže ukazuje, či rezonancia vydrží aj v skutočných slovách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merilnik barve glasu posluša celoten glas, tako kot skupni rezultat, zato pokaže, ali resonanca zdrži tudi v pravih besedah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klangfärgsmätaren lyssnar på hela rösten, precis som totalpoängen, så den visar om resonansen håller i riktiga ord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาตรวัดสีเสียงฟังทั้งเสียง เหมือนคะแนนรวม จึงบอกได้ว่าเรโซแนนซ์คงอยู่ในคำจริงๆ หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tını göstergesi, genel puan gibi sesin tamamını dinler; bu yüzden rezonansın gerçek sözcüklerde dayanıp dayanmadığını gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Індикатор тембру слухає весь голос, так само як і загальна оцінка, тому показує, чи тримається резонанс у справжніх словах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng hồ đo âm sắc nghe toàn bộ giọng, giống như điểm tổng, nên nó cho thấy cộng hưởng có giữ được trong từ thật hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色读数听的是整个声音，和总分的方式一样，所以它能看出共鸣在真实词语里能否保持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音色讀數聽的是整個聲音，和總分的方式一樣，所以它能看出共鳴在真實詞語裡能否保持。"
          }
        }
      }
    },
    "coach_ex_vowel_bright_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. قول «إييي» طويلة، كما في «بيت».\n2. الابتسام قليلًا وإبقاء اللسان عاليًا وإلى الأمام.\n3. تخيّل الصوت جالسًا خلف الأسنان الأمامية مباشرةً.\n4. مراقبة النقطة وهي تتحرك إلى أعلى واليسار، نحو العلامات الوردية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Digues una «iii» llarga, com a «si».\n2. Somriu una mica i mantén la llengua alta i endavant.\n3. Imagina el so just darrere de les dents de davant.\n4. Observa com el punt es mou cap amunt i cap a l’esquerra, cap a les marques roses."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Protáhněte dlouhé „ííí“, jako ve slově „lis“.\n2. Mírně se usmějte a držte jazyk vysoko a vpředu.\n3. Představte si, že zvuk sedí hned za předními zuby.\n4. Sledujte, jak se tečka posouvá nahoru a doleva k růžovým orientačním bodům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sig et langt »iii«, som i »vi«.\n2. Smil lidt, og hold tungen højt og fremme.\n3. Forestil dig, at lyden sidder lige bag fortænderne.\n4. Se prikken bevæge sig op og mod venstre, mod de lyserøde pejlemærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sprich ein langes „iii“, wie in „Biene“.\n2. Lächle leicht und halte die Zunge hoch und vorn.\n3. Stell dir vor, der Klang sitzt direkt hinter den Vorderzähnen.\n4. Sieh zu, wie der Punkt nach oben und links wandert, zu den rosa Markierungen hin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Πείτε ένα μακρύ «ιιι», όπως στη λέξη «νησί».\n2. Χαμογελάστε ελαφρά και κρατήστε τη γλώσσα ψηλά και μπροστά.\n3. Φανταστείτε τον ήχο ακριβώς πίσω από τα μπροστινά δόντια.\n4. Δείτε την τελεία να κινείται πάνω και αριστερά, προς τα ροζ ορόσημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Say a long “eee”, as in “see”.\n2. Smile slightly and keep the tongue high and forward.\n3. Imagine the sound sitting just behind your front teeth.\n4. Watch the dot move up and left, toward the pink landmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Di una «iii» larga, como en «sí».\n2. Sonríe un poco y mantén la lengua alta y adelantada.\n3. Imagina el sonido justo detrás de los dientes frontales.\n4. Observa cómo el punto se mueve hacia arriba y a la izquierda, hacia las marcas rosas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sano pitkä ”iii”.\n2. Hymyile hieman ja pidä kieli korkealla ja edessä.\n3. Kuvittele äänen istuvan heti etuhampaiden takana.\n4. Katso, kuinka piste liikkuu ylös ja vasemmalle kohti vaaleanpunaisia merkkejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Dites un long « iii », comme dans « si ».\n2. Souriez légèrement et gardez la langue haute et avancée.\n3. Imaginez le son placé juste derrière vos dents du devant.\n4. Regardez le point monter vers la gauche, en direction des repères roses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לומר “אִי” ארוך, כמו ב“בִּין”.\n2. לחייך קלות ולהחזיק את הלשון גבוהה וקדימה.\n3. לדמיין את הצליל יושב ממש מאחורי השיניים הקדמיות.\n4. לראות את הנקודה נעה למעלה ושמאלה, לעבר הסימונים הוורודים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “see” वाली लंबी “ईईई” कहें।\n2. हल्का मुस्कुराएँ और जीभ को ऊँची और आगे रखें।\n3. कल्पना करें कि आवाज़ सामने के दाँतों के ठीक पीछे बैठी है।\n4. बिंदु को ऊपर और बाईं ओर, गुलाबी निशानों की तरफ़ जाते देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Recite dugo „iii“, kao u riječi „vino“.\n2. Lagano se nasmiješite i držite jezik visoko i naprijed.\n3. Zamislite zvuk odmah iza prednjih zuba.\n4. Promatrajte kako se točka pomiče gore i ulijevo, prema ružičastim orijentirima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mondj egy hosszú „ííí”-t, mint a „víz” szóban.\n2. Mosolyogj kicsit, és tartsd a nyelved magasan és elöl.\n3. Képzeld el, hogy a hang közvetlenül a felső fogaid mögött ül.\n4. Figyeld, ahogy a pont felfelé és balra mozdul, a rózsaszín tájékozódási pontok felé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ucapkan “iii” panjang, seperti pada “see”.\n2. Tersenyum tipis dan jaga lidah tetap tinggi dan di depan.\n3. Bayangkan suara berada tepat di belakang gigi depan.\n4. Lihat titik bergerak ke atas dan kiri, menuju penanda merah muda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Di’ una «iii» lunga, come in «sì».\n2. Sorridi appena e tieni la lingua alta e in avanti.\n3. Immagina il suono subito dietro i denti davanti.\n4. Guarda il punto spostarsi in alto e a sinistra, verso i riferimenti rosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「see」のように、長く「イーー」と言います。\n2. 軽く微笑んで、舌を高く前に保ちます。\n3. 音が前歯のすぐ後ろにあるのを想像します。\n4. 点が左上、ピンクの目印のほうへ動くのを見ましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “see”의 소리처럼 “이이이” 하고 길게 말하세요.\n2. 살짝 미소를 짓고 혀를 높고 앞쪽에 두세요.\n3. 소리가 앞니 바로 뒤에 있다고 상상하세요.\n4. 점이 왼쪽 위, 분홍색 표시 쪽으로 움직이는 것을 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sebut “iii” panjang, seperti dalam “see”.\n2. Senyum sedikit dan pastikan lidah tinggi dan ke hadapan.\n3. Bayangkan bunyi berada tepat di belakang gigi hadapan.\n4. Lihat titik bergerak ke atas dan kiri, menuju penanda merah jambu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Si en lang «iii», som i «vi».\n2. Smil litt og hold tungen høyt og fremme.\n3. Se for deg at lyden sitter like bak fortennene.\n4. Se prikken bevege seg opp og mot venstre, mot de rosa merkene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zeg een lange “iii”, zoals in “kies”.\n2. Lach een beetje en houd je tong hoog en naar voren.\n3. Stel je voor dat het geluid vlak achter je voortanden zit.\n4. Kijk hoe de stip omhoog en naar links beweegt, naar de roze markeringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Przeciągnij długie „iii”, jak w słowie „lis”.\n2. Lekko się uśmiechnij i trzymaj język wysoko i z przodu.\n3. Wyobraź sobie, że dźwięk ułożył się tuż za górnymi zębami.\n4. Obserwuj, jak kropka przesuwa się w górę i w lewo, ku różowym punktom odniesienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Diga um “iii” longo, como em “si”.\n2. Sorria um pouco e mantenha a língua alta e para a frente.\n3. Imagine o som logo atrás dos dentes da frente.\n4. Veja o ponto subir e ir para a esquerda, em direção às marcas rosa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Spune un „iii” lung, ca în „vin”.\n2. Zâmbește ușor și ține limba sus și în față.\n3. Imaginează-ți sunetul așezat chiar în spatele dinților din față.\n4. Urmărește punctul cum se mută în sus și la stânga, spre reperele roz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Протяните «иии», как в слове «лист».\n2. Слегка улыбнитесь и держите язык высоко и впереди.\n3. Представьте, что звук находится прямо за передними зубами.\n4. Следите, как точка движется вверх и влево, к розовым ориентирам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Povedzte dlhé „ííí“, ako v slove „víno“.\n2. Mierne sa usmejte a držte jazyk vysoko a vpredu.\n3. Predstavte si zvuk hneď za prednými zubami.\n4. Sledujte, ako sa bod posúva hore a doľava, k ružovým orientačným bodom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Recite dolg „iii“, kot v besedi „vino“.\n2. Rahlo se nasmehnite in držite jezik visoko in naprej.\n3. Predstavljajte si zvok tik za sprednjimi zobmi.\n4. Opazujte, kako se pika premika navzgor in v levo, proti rožnatim oporiščem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Säg ett långt ”iii”, som i ”vi”.\n2. Le lite och håll tungan högt och framåt.\n3. Föreställ dig att ljudet sitter strax bakom framtänderna.\n4. Se hur pricken rör sig uppåt och åt vänster, mot de rosa riktmärkena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ออกเสียง “อีอี” ยาวๆ เหมือนใน “see”\n2. ยิ้มเล็กน้อย ยกลิ้นสูงและอยู่ข้างหน้า\n3. จินตนาการว่าเสียงอยู่หลังฟันหน้า\n4. ดูจุดเคลื่อนขึ้นไปทางซ้าย ไปหาเครื่องหมายสีชมพู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. “Sivri” sözcüğündeki gibi uzun bir “iii” deyin.\n2. Hafifçe gülümseyin ve dili yüksek ve önde tutun.\n3. Sesin ön dişlerinizin hemen arkasında durduğunu hayal edin.\n4. Noktanın yukarı ve sola, pembe işaretlere doğru hareket ettiğini izleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Протягніть «іііі», як у слові «літо».\n2. Злегка всміхніться й тримайте язик високо та попереду.\n3. Уявіть, що звук міститься просто за передніми зубами.\n4. Стежте, як точка рухається вгору й ліворуч, до рожевих орієнтирів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Kéo dài âm “iii”, như trong “see”.\n2. Cười nhẹ và giữ lưỡi cao và hướng ra trước.\n3. Hình dung âm thanh nằm ngay sau răng cửa.\n4. Xem chấm di chuyển lên và sang trái, về phía các điểm mốc màu hồng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 拖长说“衣”，像英文“see”。\n2. 微微笑，舌头保持高而靠前。\n3. 想象声音就在门牙后面。\n4. 看圆点往左上方、往粉色标记移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 拖長說「衣」，像英文的「see」。\n2. 微微笑，舌頭保持高而靠前。\n3. 想像聲音就在門牙後面。\n4. 看圓點往左上方、往粉紅色標記移動。"
          }
        }
      }
    },
    "coach_ex_vowel_bright_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتسامة خفيفة ولسان مرتفع يؤديان معظم العمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lleuger somriure i la llengua alçada fan quasi tota la feina."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehký úsměv a zvednutý jazyk odvedou většinu práce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et lille smil og en hævet tunge gør det meste af arbejdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leichtes Lächeln und eine angehobene Zunge erledigen das meiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ελαφρύ χαμόγελο και μια ανυψωμένη γλώσσα κάνουν το μεγαλύτερο μέρος της δουλειάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slight smile and a raised tongue do most of the work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ligera sonrisa y la lengua elevada hacen casi todo el trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieni hymy ja kohotettu kieli tekevät suurimman osan työstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger sourire et la langue relevée font presque tout le travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיוך קל ולשון מורמת עושים את רוב העבודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्की मुस्कान और ऊँची जीभ ज़्यादातर काम कर देती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blagi osmijeh i podignut jezik odrađuju većinu posla."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kis mosoly és emelt nyelv elvégzi a munka nagy részét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senyum tipis dan lidah terangkat melakukan sebagian besar pekerjaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieve sorriso e la lingua alzata fanno quasi tutto il lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い微笑みと舌を上げることで、ほとんどが決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝 미소 짓고 혀를 올리는 것만으로 대부분 해결돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senyuman kecil dan lidah yang diangkat melakukan kebanyakan kerja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et lite smil og en hevet tunge gjør det meste av jobben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een lichte glimlach en een opgeheven tong doen het meeste werk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekki uśmiech i uniesiony język robią większość pracy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um leve sorriso e a língua elevada fazem quase todo o trabalho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un zâmbet ușor și limba ridicată fac cea mai mare parte din treabă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкая улыбка и поднятый язык делают почти всю работу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierny úsmev a zdvihnutý jazyk urobia väčšinu práce."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahel nasmeh in dvignjen jezik opravita večino dela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett litet leende och en lyft tunga gör det mesta av jobbet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอยยิ้มเล็กน้อยกับลิ้นที่ยกสูงช่วยได้เกือบทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafif bir gülümseme ve yükseltilmiş bir dil işin çoğunu yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легка усмішка й піднятий язик виконують майже всю роботу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nụ cười nhẹ và lưỡi nâng cao làm gần hết công việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微笑和抬高舌头起了大部分作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微笑和抬高舌頭起了大部分作用。"
          }
        }
      }
    },
