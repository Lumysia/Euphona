    "coach_ex_straw_why" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد القشّة ضغط الهواء إلى الحبال الصوتية فتهتز بجهد أقل. وهي من أكثر تمارين الإحماء دراسةً في علاج الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La palleta retorna pressió d’aire a les cordes vocals, que vibren amb menys esforç. És un dels escalfaments més estudiats en teràpia de la veu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brčko zvyšuje zpětný tlak vzduchu na hlasivky, takže kmitají s menším úsilím. Je to jedno z nejlépe prozkoumaných rozezpívání v hlasové terapii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerøret presser luften tilbage mod stemmelæberne, så de vibrerer med mindre anstrengelse. Det er en af de mest velundersøgte opvarmninger i stemmeterapi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Strohhalm staut den Luftdruck bis zu den Stimmlippen zurück, sodass sie mit weniger Anstrengung schwingen. Es ist eines der am besten erforschten Aufwärmprogramme der Stimmtherapie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καλαμάκι στηρίζει την πίεση του αέρα στις φωνητικές χορδές, ώστε να πάλλονται με λιγότερη προσπάθεια. Είναι μία από τις πιο μελετημένες ασκήσεις προθέρμανσης στη φωνοθεραπεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The straw backs air pressure up onto your vocal folds, so they vibrate with less effort. It is one of the best-studied warm-ups in voice therapy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pajita devuelve presión de aire a las cuerdas vocales, que vibran con menos esfuerzo. Es uno de los calentamientos más estudiados en terapia de voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilli nostaa ilmanpainetta äänihuulten takana, joten ne värähtelevät pienemmällä vaivalla. Se on yksi tutkituimmista lämmittelyistä äänenkuntoutuksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paille renvoie la pression de l’air vers les plis vocaux, qui vibrent alors avec moins d’effort. C’est l’un des échauffements les mieux étudiés en rééducation vocale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשית מחזירה את לחץ האוויר אל מיתרי הקול, כך שהם רוטטים במאמץ קטן יותר. זהו אחד מתרגילי החימום הנחקרים ביותר בטיפול בקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्ट्रॉ हवा के दबाव को स्वर-रज्जुओं पर वापस लौटाता है, इसलिए वे कम मेहनत से कंपन करती हैं। आवाज़ की थेरेपी में यह सबसे ज़्यादा परखे गए वार्म-अप में से एक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slamka zadržava tlak zraka na glasnicama pa titraju uz manje truda. To je jedno od najbolje istraženih zagrijavanja u terapiji glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szívószál visszatorlasztja a légnyomást a hangszalagokra, így kisebb erőfeszítéssel rezegnek. A hangterápia egyik legjobban kutatott bemelegítése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedotan mengembalikan tekanan udara ke pita suara, sehingga bergetar dengan usaha lebih kecil. Ini salah satu pemanasan yang paling banyak diteliti dalam terapi suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cannuccia rimanda pressione d’aria alle corde vocali, che vibrano con meno sforzo. È uno dei riscaldamenti più studiati nella terapia della voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストローは空気の圧力を声帯に押し返し、少ない力で振動させます。音声治療で最もよく研究されているウォームアップの 1 つです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨대는 공기 압력을 성대 쪽으로 되돌려, 성대가 더 적은 힘으로 진동하게 해 줘요. 음성 치료에서 가장 많이 연구된 워밍업 중 하나예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedut minuman menolak tekanan udara kembali ke pita suara, jadi ia bergetar dengan usaha yang kurang. Ia antara pemanasan yang paling banyak dikaji dalam terapi suara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerøret presser luften tilbake mot stemmebåndene, så de vibrerer med mindre anstrengelse. Det er en av de best undersøkte oppvarmingene i stemmeterapi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het rietje stuwt de luchtdruk terug naar je stembanden, zodat die met minder moeite trillen. Het is een van de best onderzochte warming-ups in stemtherapie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słomka wytwarza opór powietrza na fałdach głosowych, więc drgają przy mniejszym wysiłku. To jedna z najlepiej zbadanych rozgrzewek w terapii głosu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canudo devolve pressão de ar às pregas vocais, que vibram com menos esforço. É um dos aquecimentos mais estudados na terapia de voz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paiul împinge presiunea aerului înapoi spre corzile vocale, care vibrează astfel cu mai puțin efort. Este unul dintre cele mai bine studiate exerciții de încălzire din terapia vocii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трубочка создаёт обратное давление воздуха на голосовые складки, и они колеблются с меньшим усилием. Это одна из самых изученных распевок в работе с голосом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slamka vytvára spätný tlak vzduchu na hlasivky, takže vibrujú s menšou námahou. Je to jedno z najlepšie preskúmaných zahrievacích cvičení v hlasovej terapii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slamica zadržuje zračni tlak na glasilkah, zato nihajo z manj napora. To je ena najbolje raziskanih ogrevalnih vaj v terapiji glasu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugröret ger ett motstånd som trycker tillbaka luften mot stämbanden, så att de vibrerar med mindre ansträngning. Det är en av de mest studerade uppvärmningarna inom röstterapi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลอดช่วยดันแรงดันลมกลับไปที่สายเสียง ทำให้สั่นได้โดยใช้แรงน้อยลง เป็นหนึ่งในการวอร์มอัปที่มีการศึกษามากที่สุดในการบำบัดเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipet hava basıncını ses tellerinize doğru geri yönlendirir, böylece daha az çabayla titreşirler. Ses terapisinde en iyi incelenmiş ısınma çalışmalarından biridir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трубочка створює зворотний тиск повітря на голосові зв’язки, і вони коливаються з меншим зусиллям. Це одна з найдетальніше вивчених розспівок у роботі з голосом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ống hút dồn áp suất không khí ngược lên dây thanh, nên chúng rung với ít sức hơn. Đây là một trong những bài khởi động được nghiên cứu nhiều nhất trong trị liệu giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸管让气压回到声带上，声带用更少的力气就能振动。这是嗓音治疗里研究最充分的热身方法之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸管讓氣壓回到聲帶上，聲帶用更少的力氣就能振動。這是嗓音治療裡研究最充分的熱身方法之一。"
          }
        }
      }
    },
    "coach_ex_talk_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. قراءة الموضوع ثم الحديث عنه كما يُتحدث إلى صديق.\n2. عدم التخطيط للجمل؛ المتابعة فحسب حتى ينتهي المؤقت.\n3. ترك الصوت الجديد يكون صوتك المعتاد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Llegeix la proposta i parla’n com ho faries amb algú de confiança.\n2. No planifiquis les frases; continua parlant fins que s’acabi el temporitzador.\n3. Deixa que la veu nova sigui la teva veu normal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Přečtěte si téma a mluvte o něm jako při rozhovoru s kamarádem.\n2. Nevymýšlejte věty předem; prostě pokračujte, dokud neskončí časovač.\n3. Nechte nový hlas být vaším běžným hlasem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Læs emnet, og tal så om det, som du ville til en ven.\n2. Planlæg ikke sætninger, bare bliv ved, til tiden er gået.\n3. Lad den nye stemme være din almindelige stemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lies das Thema und erzähle dann davon, wie du es einer Freundin oder einem Freund erzählen würdest.\n2. Plane keine Sätze; rede einfach weiter, bis der Timer endet.\n3. Lass die neue Stimme deine normale Stimme sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Διαβάστε το θέμα και μιλήστε γι' αυτό όπως θα μιλούσατε σε έναν φίλο.\n2. Μην σχεδιάζετε προτάσεις· συνεχίστε μέχρι να τελειώσει το χρονόμετρο.\n3. Αφήστε τη νέα φωνή να είναι η φυσική σας φωνή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Read the prompt, then talk about it as you would to a friend.\n2. Don't plan sentences; just keep going until the timer ends.\n3. Let the new voice be your normal voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lee la propuesta y habla de ello como lo harías con un amigo o una amiga.\n2. No planees las frases; sigue hablando hasta que acabe el temporizador.\n3. Deja que la nueva voz sea tu voz normal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lue aihe ja puhu siitä kuin ystävälle.\n2. Älä suunnittele lauseita, vaan jatka, kunnes ajastin päättyy.\n3. Anna uuden äänen olla tavallinen äänesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lisez le sujet, puis parlez-en comme vous le feriez à un ami.\n2. Ne préparez pas vos phrases ; continuez simplement jusqu’à la fin du minuteur.\n3. Laissez la nouvelle voix devenir votre voix habituelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. לקרוא את הנושא ואז לדבר עליו כמו עם חבר.\n2. לא לתכנן משפטים; פשוט להמשיך עד שהטיימר מסתיים.\n3. לתת לקול החדש להיות הקול הרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. प्रॉम्प्ट पढ़ें, फिर उस पर ऐसे बोलें जैसे किसी दोस्त से बात कर रहे हों।\n2. वाक्य पहले से न सोचें; टाइमर ख़त्म होने तक बोलते रहें।\n3. नई आवाज़ को अपनी सामान्य आवाज़ बनने दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Pročitajte temu, pa o njoj govorite kao prijatelju.\n2. Ne planirajte rečenice; samo nastavite dok ne istekne vrijeme.\n3. Neka novi glas bude vaš uobičajeni glas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Olvasd el a témát, aztán beszélj róla úgy, mint egy barátodnak.\n2. Ne tervezz mondatokat; csak folytasd, amíg le nem jár az időzítő.\n3. Az új hang legyen a megszokott hangod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Baca topiknya, lalu bicarakan seperti kepada teman.\n2. Jangan merencanakan kalimat; teruslah bicara sampai pengatur waktu selesai.\n3. Biarkan suara baru menjadi suara biasa Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Leggi lo spunto, poi parlane come faresti con un amico o un’amica.\n2. Non preparare le frasi; vai avanti finché il timer non finisce.\n3. Lascia che la nuova voce sia la tua voce normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. お題を読んで、友だちに話すように話します。\n2. 文を考えず、タイマーが終わるまで話し続けます。\n3. 新しい声を、いつもの自分の声にしていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 주제를 읽고, 친구에게 말하듯 이야기해 보세요.\n2. 문장을 미리 짜지 말고 타이머가 끝날 때까지 계속 말하세요.\n3. 새 목소리를 평소 목소리로 삼아 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Baca gesaan, kemudian bercakap tentangnya seperti kepada kawan.\n2. Jangan rancang ayat; teruskan bercakap sehingga pemasa tamat.\n3. Biarkan suara baharu menjadi suara biasa anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Les oppgaven og snakk så om den som til en venn.\n2. Ikke planlegg setninger, bare fortsett til tiden er ute.\n3. La den nye stemmen være den vanlige stemmen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Lees het onderwerp en praat er dan over zoals je tegen een vriend of vriendin zou doen.\n2. Plan geen zinnen; ga gewoon door tot de timer afloopt.\n3. Laat de nieuwe stem je gewone stem zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Przeczytaj temat, a potem opowiedz o nim jak komuś bliskiemu.\n2. Nie planuj zdań; po prostu mów, aż skończy się czas.\n3. Niech nowy głos będzie Twoim zwykłym głosem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Leia o tema e fale sobre ele como falaria com alguém próximo.\n2. Não planeje as frases; continue falando até o cronômetro acabar.\n3. Deixe a nova voz ser sua voz normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Citește tema, apoi vorbește despre ea cum ai vorbi cu un prieten.\n2. Nu-ți planifica propozițiile; continuă pur și simplu până se termină cronometrul.\n3. Lasă noua voce să fie vocea ta obișnuită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Прочитайте тему и поговорите о ней, как с другом.\n2. Не составляйте фразы заранее; просто продолжайте, пока не закончится таймер.\n3. Пусть новый голос будет вашим обычным голосом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Prečítajte si tému a hovorte o nej ako priateľovi.\n2. Vety si nepripravujte; len pokračujte, kým neuplynie čas.\n3. Nechajte nový hlas byť vaším bežným hlasom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Preberite temo in govorite o njej, kot bi govorili prijatelju.\n2. Stavkov ne načrtujte; kar nadaljujte, dokler se časovnik ne izteče.\n3. Naj bo novi glas vaš običajni glas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Läs frågan och berätta sedan om den som för en vän.\n2. Planera inga meningar, fortsätt bara tills tiden är slut.\n3. Låt den nya rösten vara din vanliga röst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. อ่านหัวข้อ แล้วพูดถึงมันเหมือนคุยกับเพื่อน\n2. ไม่ต้องวางแผนประโยค พูดต่อไปจนกว่าตัวจับเวลาจะหมด\n3. ให้เสียงใหม่เป็นเสียงปกติของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Konuyu okuyun, sonra bir arkadaşınızla konuşur gibi onun hakkında konuşun.\n2. Cümleleri önceden planlamayın; sayaç bitene kadar devam edin.\n3. Yeni sesin olağan sesiniz olmasına izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Прочитайте тему й поговоріть про неї, як із другом.\n2. Не складайте фрази заздалегідь; просто продовжуйте, доки не закінчиться таймер.\n3. Нехай новий голос буде вашим звичайним голосом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Đọc đề bài, rồi nói về nó như khi nói với một người bạn.\n2. Đừng soạn trước câu; cứ nói tiếp cho đến khi hết giờ.\n3. Hãy để giọng mới là giọng bình thường của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 看提示，然后像跟朋友聊天一样说一说。\n2. 不用想好句子，一直说到计时结束。\n3. 让新的声音成为你平常的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 看提示，然後像跟朋友聊天一樣說一說。\n2. 不用想好句子，一直說到計時結束。\n3. 讓新的聲音成為你平常的聲音。"
          }
        }
      }
    },
    "coach_ex_talk_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا انزلق الصوت أثناء التفكير، فيُستحسن التوقف قليلًا والبحث عنه ثم المتابعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la veu es descontrola mentre penses, fes una pausa, troba-la i continua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud vám hlas při přemýšlení uklouzne, udělejte pauzu, najděte ho a pokračujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis stemmen glider, mens du tænker, så hold en pause, find den, og fortsæt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Stimme beim Nachdenken verrutscht, mach eine Pause, finde sie wieder und sprich weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η φωνή γλιστρήσει όσο σκέφτεστε, κάντε παύση, βρείτε την και συνεχίστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the voice slips while you think, pause, find it, and go on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la voz se escapa mientras piensas, haz una pausa, encuéntrala y sigue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos ääni lipsuu ajatellessasi, tee tauko, etsi se ja jatka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la voix dérape pendant que vous réfléchissez, faites une pause, retrouvez-la et continuez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם הקול מחליק בזמן החשיבה, לעצור, למצוא אותו ולהמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोचते समय आवाज़ खिसक जाए, तो रुकें, उसे खोजें और आगे बढ़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako glas sklizne dok razmišljate, zastanite, pronađite ga i nastavite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha gondolkodás közben elcsúszik a hang, állj meg, találd meg, és folytasd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika suara tergelincir saat berpikir, berhenti, temukan lagi, lalu lanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la voce scivola mentre pensi, fai una pausa, ritrovala e prosegui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考えている間に声が元に戻ったら、止まって、見つけ直して、続けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각하다가 목소리가 달라지면 멈추고, 다시 찾고, 이어서 말하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika suara tergelincir semasa berfikir, berhenti, cari semula, dan teruskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis stemmen glir mens du tenker, ta en pause, finn den og fortsett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je stem wegglipt terwijl je nadenkt, pauzeer dan, vind hem terug en ga verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli głos ucieknie, gdy myślisz, zrób przerwę, odnajdź go i mów dalej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a voz escapar enquanto você pensa, pause, encontre-a e siga em frente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă vocea alunecă în timp ce te gândești, fă o pauză, găsește-o și continuă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если голос ускользнул, пока вы думали, сделайте паузу, найдите его и продолжайте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak hlas pri premýšľaní ujde, zastavte sa, nájdite ho a pokračujte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če glas med razmišljanjem zdrsne, se ustavite, ga poiščite in nadaljujte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om rösten halkar medan du tänker, gör en paus, hitta den och fortsätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเสียงหลุดตอนคิด ให้หยุด หาเสียงให้เจอ แล้วพูดต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşünürken ses kayarsa durun, sesi bulun ve devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо голос вислизнув, поки ви думали, зробіть паузу, знайдіть його й продовжуйте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu giọng trượt đi khi bạn nghĩ, hãy dừng, tìm lại và nói tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想事情时声音跑了，就停一下，找回来，再继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想事情時聲音跑了，就停一下，找回來，再繼續。"
          }
        }
      }
    },
