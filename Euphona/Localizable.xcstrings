    "onboarding_icloud_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك الاحتفاظ بتحاليلك وتسجيلاتك على كل أجهزتك. تُخزَّن في iCloud الخاص بك، ويجري التحليل دائمًا على جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva les anàlisis i els enregistraments a tots els dispositius. Es desen al teu iCloud privat, i l’anàlisi sempre s’executa al dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mějte své analýzy a nahrávky na všech svých zařízeních. Ukládají se do vašeho soukromého iCloudu a analýza vždy probíhá přímo v zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hav dine analyser og optagelser på alle dine enheder. De gemmes i din egen private iCloud, og analysen foregår altid på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte deine Analysen und Aufnahmen auf allen deinen Geräten. Sie werden in deiner eigenen privaten iCloud gespeichert, und die Analyse läuft immer auf deinem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε τις αναλύσεις και τις ηχογραφήσεις σας σε όλες τις συσκευές σας. Αποθηκεύονται στο δικό σας ιδιωτικό iCloud και η ανάλυση εκτελείται πάντα στη συσκευή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your analyses and recordings on all your devices. They are stored in your own private iCloud, and analysis always runs on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva tus análisis y grabaciones en todos tus dispositivos. Se guardan en tu iCloud privado y el análisis siempre se hace en tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä analyysisi ja äänityksesi kaikilla laitteillasi. Ne tallennetaan omaan yksityiseen iCloudiisi, ja analyysi tehdään aina laitteellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez vos analyses et vos enregistrements sur tous vos appareils. Ils sont stockés dans votre propre iCloud privé, et l’analyse s’exécute toujours sur votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לשמור את הניתוחים וההקלטות בכל המכשירים שלך. הם נשמרים ב-iCloud הפרטי שלך, והניתוח תמיד מתבצע במכשיר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने विश्लेषण और रिकॉर्डिंग अपने सभी डिवाइस पर रखें। ये आपके निजी iCloud में रहते हैं, और विश्लेषण हमेशा डिवाइस पर होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imajte svoje analize i snimke na svim uređajima. Pohranjene su u vašem privatnom iCloudu, a analiza se uvijek odvija na vašem uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legyenek az elemzéseid és felvételeid minden eszközödön. A saját privát iCloudodban tároljuk őket, az elemzés pedig mindig az eszközödön fut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan analisis dan rekaman Anda di semua perangkat Anda. Semuanya disimpan di iCloud pribadi Anda sendiri, dan analisis selalu berjalan di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritrova analisi e registrazioni su tutti i tuoi dispositivi. Sono salvate nel tuo iCloud privato e l’analisi avviene sempre sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析結果と録音をすべてのデバイスで使えます。保存先はあなた専用の iCloud で、分析は常にデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기에서 분석 결과와 녹음을 볼 수 있습니다. 데이터는 나만의 비공개 iCloud에 저장되며, 분석은 항상 기기에서 이루어집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan analisis dan rakaman anda pada semua peranti anda. Ia disimpan dalam iCloud peribadi anda sendiri, dan analisis sentiasa berjalan pada peranti anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha analysene og opptakene dine på alle enhetene dine. De lagres i din egen private iCloud, og analysen skjer alltid på enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar je analyses en opnamen op al je apparaten. Ze worden opgeslagen in je eigen privé-iCloud en de analyse draait altijd op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miej swoje analizy i nagrania na wszystkich urządzeniach. Są przechowywane w Twoim prywatnym iCloud, a analiza zawsze odbywa się na urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenha suas análises e gravações em todos os seus dispositivos. Elas ficam no seu iCloud privado, e a análise sempre acontece no dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează-ți analizele și înregistrările pe toate dispozitivele. Sunt stocate în propriul tău iCloud privat, iar analiza rulează întotdeauna pe dispozitivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните анализы и записи на всех своих устройствах. Они лежат в вашем личном iCloud, а анализ всегда выполняется на устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majte svoje analýzy a nahrávky vo všetkých zariadeniach. Ukladajú sa vo vašom súkromnom iCloude a analýza vždy prebieha vo vašom zariadení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imejte svoje analize in posnetke v vseh svojih napravah. Shranjeni so v vašem zasebnem iCloudu, analiza pa vedno poteka v vaši napravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha dina analyser och inspelningar på alla dina enheter. De sparas i din privata iCloud, och analysen sker alltid på din enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บการวิเคราะห์และการบันทึกเสียงไว้บนอุปกรณ์ทุกเครื่องของคุณ ข้อมูลเก็บใน iCloud ส่วนตัวของคุณเอง และการวิเคราะห์ทำงานบนอุปกรณ์เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizlerinizi ve kayıtlarınızı tüm cihazlarınızda saklayın. Bunlar kendi özel iCloud’unuzda tutulur ve analiz her zaman cihazınızda çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте аналізи й записи на всіх своїх пристроях. Вони лежать у вашому особистому iCloud, а аналіз завжди виконується на пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ kết quả phân tích và bản ghi trên mọi thiết bị của bạn. Chúng được lưu trong iCloud riêng của bạn, và việc phân tích luôn diễn ra trên thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的所有设备上保留测评结果和录音。它们只存放在你自己的私人 iCloud 里，分析始终在设备上进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的所有裝置上保留分析結果與錄音。它們只存放在你自己的私人 iCloud 中，分析一律在裝置上進行。"
          }
        }
      }
    },
