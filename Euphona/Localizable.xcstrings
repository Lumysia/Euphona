        }
      }
    },
    "coach_check_in_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هناك ألم أو تعب شديد، يصبح اليوم يوم راحة مع دندنة خفيفة فقط. أما الألم أو البحّة التي تستمر أكثر من أسبوعين فتستحق زيارة طبيب أو أخصائي نطق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fa mal o notes molt de cansament, avui serà un dia de descans només amb taral·leig suau. Si el dolor o la ronquera duren més de dues setmanes, convé consultar un metge o un logopeda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud to bolí nebo cítíte velkou únavu, dnešek bude dnem odpočinku jen s jemným broukáním. Bolest nebo chrapot trvající déle než dva týdny jsou důvodem k návštěvě lékaře nebo logopeda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det gør ondt, eller stemmen føles meget træt, bliver dagen en hviledag med kun blid nynnen. Smerter eller hæshed i mere end to uger bør tages op med en læge eller en logopæd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Schmerzen oder großer Müdigkeit wird der Tag zum Ruhetag mit nur sanftem Summen. Schmerzen oder Heiserkeit, die länger als zwei Wochen anhalten, sollten ärztlich oder logopädisch abgeklärt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν πονάει ή υπάρχει μεγάλη κούραση, η σημερινή μέρα γίνεται ημέρα ξεκούρασης με μόνο απαλό μουρμούρισμα. Αν ο πόνος ή η βραχνάδα διαρκούν περισσότερο από δύο εβδομάδες, αξίζει μια επίσκεψη σε γιατρό ή λογοθεραπευτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it hurts or feels very tired, today becomes a rest day with gentle humming only. Pain or hoarseness lasting more than two weeks is worth a visit to a doctor or speech therapist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si duele o notas mucho cansancio, hoy será un día de descanso solo con tarareo suave. Si el dolor o la ronquera duran más de dos semanas, conviene consultar a un médico o a un logopeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos siihen sattuu tai ääni tuntuu hyvin väsyneeltä, päivästä tulee lepopäivä, jossa on vain pehmeää huminaa. Yli kaksi viikkoa jatkuvasta kivusta tai käheydestä kannattaa puhua lääkärin tai puheterapeutin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de douleur ou de grande fatigue, la journée devient un jour de repos avec seulement des bourdonnements doux. Une douleur ou un enrouement de plus de deux semaines mérite une visite chez un médecin ou un orthophoniste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם כואב או שיש עייפות רבה, היום הופך ליום מנוחה עם זמזום עדין בלבד. כאב או צרידות שנמשכים יותר משבועיים מצדיקים פנייה לרופא או לקלינאי תקשורת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर दर्द हो या बहुत थकान लगे, तो आज आराम का दिन बन जाता है, जिसमें सिर्फ़ हल्की गुनगुनाहट होगी। दो हफ़्ते से ज़्यादा दर्द या आवाज़ का भर्रायापन रहे, तो डॉक्टर या स्पीच थेरेपिस्ट को दिखाना ठीक रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako boli ili je glas jako umoran, danas će biti dan odmora samo s nježnim brujanjem. Bol ili promuklost koja traje dulje od dva tjedna razlog je za posjet liječniku ili logopedu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha fáj, vagy nagyon fáradt a hangod, a mai nap pihenőnap lesz, csak halk dúdolással. A két hétnél tovább tartó fájdalom vagy rekedtség miatt érdemes orvoshoz vagy logopédushoz fordulni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika terasa sakit atau sangat lelah, hari ini menjadi hari istirahat dengan senandung lembut saja. Sakit atau serak yang berlangsung lebih dari dua minggu sebaiknya diperiksakan ke dokter atau terapis wicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fa male o senti molta stanchezza, oggi diventa un giorno di riposo con solo canticchio dolce. Dolore o raucedine che durano più di due settimane meritano una visita da un medico o da un logopedista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "痛みがあったり、とても疲れていたりする場合、今日はやさしいハミングだけの休息日になります。痛みやかすれが 2 週間以上続く場合は、医師または言語聴覚士に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아프거나 매우 피곤하면 오늘은 부드러운 허밍만 하는 휴식일이 돼요. 통증이나 목쉼이 2주 넘게 이어지면 의사나 언어치료사를 찾아가 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika terasa sakit atau sangat penat, hari ini menjadi hari rehat dengan senandung lembut sahaja. Sakit atau serak yang berlarutan lebih daripada dua minggu wajar diperiksa oleh doktor atau ahli terapi pertuturan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det gjør vondt eller stemmen føles veldig sliten, blir dagen en hviledag med bare myk nynning. Smerte eller heshet som varer i mer enn to uker, bør tas opp med lege eller logoped."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij pijn of grote vermoeidheid wordt het een rustdag met alleen zacht neuriën. Pijn of heesheid die langer dan twee weken duurt, is een bezoek aan een arts of logopedist waard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli boli albo czujesz duże zmęczenie, dzisiaj będzie dzień odpoczynku z samym łagodnym nuceniem. Ból lub chrypka trwające dłużej niż dwa tygodnie to powód, by iść do lekarza lub logopedy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se doer ou houver muito cansaço, hoje vira um dia de descanso, só com cantarolar suave. Dor ou rouquidão por mais de duas semanas merecem uma consulta com médico ou fonoaudiólogo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă te doare sau simți o oboseală puternică, ziua devine o zi de odihnă, doar cu fredonat ușor. Durerea sau răgușeala care durează mai mult de două săptămâni merită o vizită la un medic sau la un logoped."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если есть боль или сильная усталость, сегодня будет день отдыха с мягким гудением. Боль или хрипота дольше двух недель — повод обратиться к врачу или логопеду."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak to bolí alebo je hlas veľmi unavený, dnešok sa zmení na oddychový deň iba s jemným bzučaním. Bolesť alebo chrapot trvajúce dlhšie ako dva týždne je dôvod navštíviť lekára alebo logopéda."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če boli ali je glas zelo utrujen, bo današnji dan dan počitka samo z nežnim brenčanjem. Bolečina ali hripavost, ki traja več kot dva tedna, je razlog za obisk zdravnika ali logopeda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det gör ont eller rösten känns mycket trött blir dagen en vilodag med bara lugnt nynnande. Smärta eller heshet som varar i mer än två veckor bör tas upp med läkare eller logoped."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเจ็บหรือเหนื่อยมาก วันนี้จะกลายเป็นวันพักที่ฮัมเบาๆ เท่านั้น หากเจ็บหรือเสียงแหบนานกว่าสองสัปดาห์ ควรไปพบแพทย์หรือนักแก้ไขการพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağrıyorsa veya çok yorgunsa bugün, yalnızca hafif mırıldanmayla bir dinlenme günü olur. İki haftadan uzun süren ağrı veya kısıklık için bir doktora ya da konuşma terapistine görünmeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо є біль або сильна втома, сьогодні буде день відпочинку з м’яким гудінням. Біль або захриплість понад два тижні — привід звернутися до лікаря чи логопеда."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn thấy đau hoặc rất mệt, hôm nay sẽ là ngày nghỉ, chỉ ngân nga nhẹ nhàng. Đau hoặc khàn giọng kéo dài hơn hai tuần thì nên đi khám bác sĩ hoặc chuyên gia trị liệu ngôn ngữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果疼或非常疲劳，今天会变成只做轻柔哼鸣的休息日。疼痛或沙哑持续超过两周，建议去看医生或言语治疗师。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果會痛或非常疲勞，今天會變成只做輕柔哼鳴的休息日。疼痛或沙啞持續超過兩週，建議去看醫師或語言治療師。"
          }
        }
      }
    },
