    "coach_first_analysis_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل هدف يُحدَّد من صوتك أنت. يكفي قراءة مقطع قصير مرة واحدة ليظهر درسك الأول هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada objectiu es fixa a partir de la teva pròpia veu. Llegeix un passatge curt una vegada i aquí apareixerà la teva primera lliçó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý cíl se nastavuje podle vašeho vlastního hlasu. Přečtěte jednou krátký úryvek a zde se objeví vaše první lekce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mål bygger på din egen stemme. Læs en kort tekst højt én gang, så dukker din første lektion op her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Ziel wird aus deiner eigenen Stimme abgeleitet. Lies einmal einen kurzen Text vor, und deine erste Lektion erscheint hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε στόχος ορίζεται από τη δική σας φωνή. Διαβάστε μία φορά ένα σύντομο κείμενο και το πρώτο σας μάθημα θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every target is set from your own voice. Read a short passage once, and your first lesson appears here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada objetivo se fija a partir de tu propia voz. Lee un pasaje corto una vez y aquí aparecerá tu primera lección."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen tavoite perustuu omaan ääneesi. Lue lyhyt teksti kerran, niin ensimmäinen oppitunti ilmestyy tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque objectif est fixé à partir de votre propre voix. Lisez un court texte une fois, et votre première leçon apparaîtra ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל יעד נקבע לפי הקול שלך. קוראים קטע קצר פעם אחת, והשיעור הראשון שלך יופיע כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर लक्ष्य आपकी अपनी आवाज़ से तय होता है। एक छोटा अनुच्छेद एक बार पढ़ें, और आपका पहला पाठ यहाँ दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki cilj određuje se prema vašem vlastitom glasu. Jednom pročitajte kratak tekst i vaša prva lekcija pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden cél a saját hangodból indul ki. Olvass fel egyszer egy rövid szöveget, és itt megjelenik az első leckéd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap target ditetapkan dari suara Anda sendiri. Bacakan satu bagian pendek, dan pelajaran pertama Anda muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni obiettivo parte dalla tua voce. Leggi un breve brano una volta e qui apparirà la tua prima lezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての目標は、あなた自身の声をもとに設定されます。短い文章を 1 回読むと、最初のレッスンがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 목표는 내 목소리를 바탕으로 정해져요. 짧은 글을 한 번 읽으면 첫 레슨이 여기에 나타나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap sasaran ditetapkan daripada suara anda sendiri. Baca satu petikan pendek, dan pelajaran pertama anda muncul di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mål bygger på din egen stemme. Les en kort tekst én gang, så dukker den første leksjonen din opp her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk doel wordt afgestemd op je eigen stem. Lees één keer een korte tekst voor en je eerste les verschijnt hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy cel jest ustawiany na podstawie Twojego własnego głosu. Przeczytaj raz krótki fragment, a tutaj pojawi się Twoja pierwsza lekcja."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada meta é definida a partir da sua própria voz. Leia um trecho curto uma vez e sua primeira lição aparece aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare țintă se stabilește pornind de la propria ta voce. Citește o dată un scurt text și prima ta lecție apare aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все цели строятся по вашему собственному голосу. Прочитайте один короткий отрывок, и здесь появится ваш первый урок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
