    "coach_after_tired" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن ترك صوتك يرتاح بقية اليوم. وإن كان يؤلمك أو بقيت فيه بحّة لأكثر من بضعة أسابيع، فيُستحسن مراجعة مختص في الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa reposar la veu la resta del dia. Si fa mal, o si la ronquera dura més d’unes quantes setmanes, consulta un especialista en veu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopřejte hlasu do konce dnešního dne pauzu. Pokud to bolí nebo chrapot trvá déle než několik týdnů, navštivte odborníka na hlas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad stemmen hvile resten af dagen. Hvis det gør ondt, eller hvis stemmen er hæs i mere end et par uger, så kontakt en stemmespecialist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönn deiner Stimme für den Rest des Tages eine Pause. Wenn es wehtut oder die Heiserkeit länger als ein paar Wochen anhält, wende dich an eine Fachperson für Stimme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε τη φωνή σας να ξεκουραστεί για το υπόλοιπο της ημέρας. Αν πονάει ή παραμένει βραχνή για περισσότερες από λίγες εβδομάδες, απευθυνθείτε σε ειδικό φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your voice a break for the rest of today. If it hurts, or stays hoarse for more than a few weeks, see a voice specialist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja descansar tu voz el resto del día. Si duele, o si la ronquera dura más de unas semanas, acude a un especialista en voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna äänen levätä loppupäivä. Jos siihen sattuu tai se pysyy käheänä yli muutaman viikon, hakeudu äänen asiantuntijalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez votre voix se reposer pour le reste de la journée. En cas de douleur, ou si l’enrouement persiste plus de quelques semaines, consultez un spécialiste de la voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לתת לקול לנוח ביתר שעות היום. אם כואב, או אם הקול נשאר צרוד יותר מכמה שבועות, כדאי לפנות לאיש מקצוע בתחום הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज बाकी समय आवाज़ को आराम दें। अगर दर्द हो, या आवाज़ कुछ हफ़्तों से ज़्यादा भर्राई रहे, तो किसी आवाज़ विशेषज्ञ को दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do kraja današnjeg dana pustite glasu da se odmori. Ako boli ili promuklost traje dulje od nekoliko tjedana, posjetite stručnjaka za glas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyd pihenni a hangodat a nap hátralévő részében. Ha fáj, vagy néhány hétnél tovább rekedt marad, keress fel egy hangszakértőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istirahatkan suara Anda selama sisa hari ini. Jika terasa sakit, atau serak lebih dari beberapa minggu, temui spesialis suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia riposare la voce per il resto di oggi. Se fa male, o se la raucedine dura più di qualche settimana, rivolgiti a uno specialista della voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はこのあと声を休ませましょう。痛みがある場合や、かすれた状態が数週間以上続く場合は、音声の専門医に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 남은 시간에는 목소리를 쉬게 해 주세요. 아프거나 쉰 목소리가 몇 주 넘게 이어지면 음성 전문의를 찾아가 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehatkan suara anda sepanjang hari ini. Jika terasa sakit, atau serak lebih daripada beberapa minggu, jumpa pakar suara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stemmen hvile resten av dagen. Hvis det gjør vondt, eller stemmen er hes i mer enn noen få uker, ta kontakt med en stemmespesialist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gun je stem de rest van de dag rust. Als het pijn doet, of als je stem langer dan een paar weken hees blijft, ga dan naar een stemspecialist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj głosowi odpocząć do końca dzisiejszego dnia. Jeśli boli albo chrypka trwa dłużej niż kilka tygodni, zgłoś się do specjalisty od głosu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe sua voz descansar pelo resto de hoje. Se doer, ou se a rouquidão durar mais de algumas semanas, procure um especialista em voz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă-ți vocea să se odihnească pentru restul zilei. Dacă te doare sau dacă răgușeala durează mai mult de câteva săptămâni, mergi la un specialist în voce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте голосу отдохнуть до конца сегодняшнего дня. Если голос болит или хрипота не проходит больше нескольких недель, обратитесь к специалисту по голосу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajte hlasu do konca dnešného dňa oddych. Ak to bolí alebo chrapot trvá dlhšie ako niekoľko týždňov, vyhľadajte odborníka na hlas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do konca današnjega dne glasu privoščite počitek. Če boli ali hripavost traja dlje kot nekaj tednov, obiščite strokovnjaka za glas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt rösten vila resten av dagen. Om det gör ont, eller om rösten är hes i mer än några veckor, kontakta en röstspecialist."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เสียงได้พักตลอดวันนี้ หากรู้สึกเจ็บ หรือเสียงแหบนานกว่าไม่กี่สัปดาห์ ควรปรึกษาผู้เชี่ยวชาญด้านเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünün geri kalanında sesinize ara verin. Ağrıyorsa veya birkaç haftadan uzun süre kısık kalırsa bir ses uzmanına görünün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте голосу відпочити до кінця сьогоднішнього дня. Якщо голос болить або захриплість не минає понад кілька тижнів, зверніться до фахівця з голосу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để giọng nghỉ ngơi trong phần còn lại của hôm nay. Nếu thấy đau, hoặc giọng khàn kéo dài hơn vài tuần, hãy đến gặp bác sĩ chuyên khoa giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天剩下的时间让嗓子歇一歇。如果疼痛，或者沙哑持续好几周，请去看嗓音专科。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天剩下的時間讓嗓子歇一歇。如果會痛，或沙啞持續好幾週，請去看嗓音專科。"
          }
        }
      }
