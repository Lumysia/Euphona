    "settings_erase_all_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف كل التحاليل والتسجيلات وسجل التدرّب والإعدادات من هذا الجهاز ومن iCloud على جميع أجهزتك. لا يمكن التراجع عن ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les anàlisis, els enregistraments, l’historial de pràctica i la configuració s’eliminaran d’aquest dispositiu i de l’iCloud a tots els teus dispositius. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny analýzy, nahrávky, historie cvičení a nastavení budou smazány z tohoto zařízení i z iCloudu na všech vašich zařízeních. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle analyser, optagelser, øvehistorik og indstillinger slettes fra denne enhed og fra iCloud på alle dine enheder. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Analysen, Aufnahmen, der Übungsverlauf und die Einstellungen werden von diesem Gerät und aus iCloud auf allen deinen Geräten gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι αναλύσεις, οι ηχογραφήσεις, το ιστορικό εξάσκησης και οι ρυθμίσεις θα διαγραφούν από αυτή τη συσκευή και από το iCloud σε όλες τις συσκευές σας. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All analyses, recordings, practice history and settings will be deleted from this device and from iCloud on all your devices. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los análisis, grabaciones, el historial de práctica y los ajustes de este dispositivo y de iCloud en todos tus dispositivos. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki analyysit, äänitykset, harjoitushistoria ja asetukset poistetaan tältä laitteelta ja iCloudista kaikilta laitteiltasi. Tätä ei voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les analyses, tous les enregistrements, l’historique d’entraînement et les réglages seront supprimés de cet appareil et d’iCloud sur tous vos appareils. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הניתוחים, ההקלטות, היסטוריית התרגול וההגדרות יימחקו מהמכשיר הזה ומ-iCloud בכל המכשירים שלך. אי אפשר לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी विश्लेषण, रिकॉर्डिंग, अभ्यास इतिहास और सेटिंग इस डिवाइस से और आपके सभी डिवाइस के iCloud से हटा दिए जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve analize, snimke, povijest vježbanja i postavke bit će izbrisane s ovog uređaja i iz iClouda na svim vašim uređajima. Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden elemzés, felvétel, gyakorlási előzmény és beállítás törlődik erről az eszközről és az iCloudból az összes eszközödön. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua analisis, rekaman, riwayat latihan, dan pengaturan akan dihapus dari perangkat ini dan dari iCloud di semua perangkat Anda. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le analisi, le registrazioni, la cronologia degli esercizi e le impostazioni verranno eliminate da questo dispositivo e da iCloud su tutti i tuoi dispositivi. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての分析、録音、練習履歴、設定が、このデバイスとすべてのデバイスの iCloud から削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 분석, 녹음, 연습 기록과 설정이 이 기기와 모든 기기의 iCloud에서 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua analisis, rakaman, sejarah latihan dan tetapan akan dipadam daripada peranti ini dan daripada iCloud pada semua peranti anda. Ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle analyser, opptak, øvingshistorikk og innstillinger slettes fra denne enheten og fra iCloud på alle enhetene dine. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle analyses, opnamen, oefengeschiedenis en instellingen worden van dit apparaat en uit iCloud op al je apparaten verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie analizy, nagrania, historia ćwiczeń i ustawienia zostaną usunięte z tego urządzenia oraz z iCloud na wszystkich Twoich urządzeniach. Tej operacji nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as análises, gravações, o histórico de prática e os ajustes serão apagados deste dispositivo e do iCloud em todos os seus dispositivos. Não é possível desfazer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate analizele, înregistrările, istoricul de exersare și setările vor fi șterse de pe acest dispozitiv și din iCloud, de pe toate dispozitivele tale. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все анализы, записи, история практики и настройки будут удалены с этого устройства и из iCloud на всех ваших устройствах. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky analýzy, nahrávky, história cvičení a nastavenia sa vymažú z tohto zariadenia a z iCloudu vo všetkých vašich zariadeniach. Túto akciu nie je možné vrátiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse analize, posnetki, zgodovina vadbe in nastavitve bodo izbrisani iz te naprave in iz iClouda v vseh vaših napravah. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla analyser, inspelningar, övningshistorik och inställningar raderas från den här enheten och från iCloud på alla dina enheter. Det går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การวิเคราะห์ การบันทึกเสียง ประวัติการฝึก และการตั้งค่าทั้งหมดจะถูกลบจากอุปกรณ์นี้และจาก iCloud บนอุปกรณ์ทุกเครื่องของคุณ ไม่สามารถเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm analizler, kayıtlar, çalışma geçmişi ve ayarlar bu cihazdan ve tüm cihazlarınızdaki iCloud’dan silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі аналізи, записи, історію практики й налаштування буде видалено з цього пристрою та з iCloud на всіх ваших пристроях. Цю дію не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả phân tích, bản ghi âm, lịch sử luyện tập và cài đặt sẽ bị xóa khỏi thiết bị này và khỏi iCloud trên mọi thiết bị của bạn. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有分析、录音、练习记录和设置都将从本设备以及你所有设备的 iCloud 中删除，且无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有分析、錄音、練習記錄和設定都將從本裝置以及你所有裝置的 iCloud 中刪除，且無法復原。"
          }
        }
      }
    },
