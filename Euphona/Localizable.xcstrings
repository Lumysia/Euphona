    "today_first_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة مقطع قصير بصوت عالٍ. يقيس Euphona درجة الصوت وجرسه والانسيابية والارتياح على جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegeix un passatge curt en veu alta. Euphona mesura to, timbre, ritme i soltesa al teu dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přečtěte nahlas krátký úryvek. Euphona změří ve vašem zařízení výšku hlasu, barvu, plynulost a uvolněnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs en kort tekst højt. Euphona måler tonehøjde, klangfarve, flow og lethed på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies einen kurzen Text laut vor. Euphona misst Tonhöhe, Klangfarbe, Sprechfluss und Leichtigkeit auf deinem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάστε φωναχτά ένα σύντομο κείμενο. Το Euphona μετρά το τονικό ύψος, τη χροιά, τη ροή και την άνεση στη συσκευή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read a short passage aloud. Euphona measures pitch, timbre, flow and ease on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee un pasaje corto en voz alta. Euphona mide tono, timbre, ritmo y soltura en tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue lyhyt teksti ääneen. Euphona mittaa äänenkorkeuden, äänenvärin, rytmin ja vaivattomuuden laitteellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez un court texte à voix haute. Euphona mesure la hauteur, le timbre, la fluidité et l’aisance sur votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוראים בקול קטע קצר. Euphona מודדת גובה קול, גוון, שטף ונינוחות במכשיר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई छोटा अनुच्छेद ज़ोर से पढ़ें। Euphona आपके डिवाइस पर पिच, स्वर-रंग, प्रवाह और सहजता मापता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naglas pročitajte kratak tekst. Euphona na vašem uređaju mjeri visinu glasa, boju glasa, tijek govora i opuštenost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvass fel egy rövid szöveget. Az Euphona az eszközödön méri a hangmagasságot, a hangszínt, a beszédfolyamot és a könnyedséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bacakan satu bagian pendek dengan lantang. Euphona mengukur nada, timbre, kelancaran, dan kemudahan di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi ad alta voce un breve brano. Euphona misura tono, timbro, ritmo e scioltezza sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い文章を音読してください。Euphona が、ピッチ、音色、流れ、楽さをデバイス上で測定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 글을 소리 내어 읽어 보세요. Euphona가 기기에서 음높이, 음색, 흐름, 편안함을 측정해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca satu petikan pendek dengan kuat. Euphona mengukur nada, timbre, kelancaran dan kemudahan pada peranti anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en kort tekst høyt. Euphona måler tonehøyde, klangfarge, flyt og letthet på enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees een korte tekst hardop voor. Euphona meet toonhoogte, klankkleur, vloeiendheid en gemak op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeczytaj na głos krótki fragment. Euphona zmierzy na Twoim urządzeniu wysokość głosu, barwę, płynność i swobodę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia um trecho curto em voz alta. O Euphona mede tom, timbre, ritmo e leveza no seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citește cu voce tare un scurt text. Euphona măsoară înălțimea, timbrul, fluiditatea și ușurința pe dispozitivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте вслух короткий отрывок. Euphona измерит на вашем устройстве высоту тона, тембр, плавность и лёгкость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prečítajte nahlas krátky text. Euphona vo vašom zariadení zmeria výšku hlasu, farbu hlasu, tok reči a uvoľnenosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na glas preberite kratko besedilo. Euphona v vaši napravi izmeri višino glasu, barvo glasu, tok govora in sproščenost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs en kort text högt. Euphona mäter tonhöjd, klangfärg, flyt och lätthet på din enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านข้อความสั้นๆ ออกเสียง Euphona จะวัดระดับเสียง สีเสียง ความลื่นไหล และความผ่อนคลายบนอุปกรณ์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa bir metni yüksek sesle okuyun. Euphona perdeyi, tınıyı, akışı ve rahatlığı cihazınızda ölçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте вголос короткий уривок. Euphona виміряє на вашому пристрої висоту тону, тембр, плавність і легкість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đọc to một đoạn ngắn. Euphona đo cao độ, âm sắc, độ trôi chảy và độ thoải mái ngay trên thiết bị của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朗读一小段文字，Euphona 会在设备上分析你的音高、音色、流畅度和轻松度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朗讀一小段文字，Euphona 會在裝置上分析你的音高、音色、流暢度和輕鬆度。"
          }
        }
      }
    },
