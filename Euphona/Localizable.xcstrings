        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemne a ľahko, o to dnes ide."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiho in lahkotno, to je danes bistvo."
          }
        },
        "sv" : {
          "stringUnit" : {
