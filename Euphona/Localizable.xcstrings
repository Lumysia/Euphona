    "coach_model_cloud_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نموذج أكبر على خوادم Apple يكتب المراجعات. ولا تحتفظ Apple بما تراه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un model més gran als servidors d’Apple escriu les valoracions. Apple no desa el que veu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnocení píše větší model na serverech Apple. Apple neukládá to, co vidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En større model på Apples servere skriver vurderingerne. Apple gemmer ikke det, den ser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein größeres Modell auf den Servern von Apple schreibt die Rückmeldungen. Apple speichert nicht, was es sieht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μεγαλύτερο μοντέλο στους διακομιστές της Apple γράφει τις αξιολογήσεις. Η Apple δεν αποθηκεύει όσα βλέπει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A larger model on Apple’s servers writes the reviews. Apple doesn’t store what it sees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modelo más grande en los servidores de Apple escribe las valoraciones. Apple no guarda lo que ve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi malli Applen palvelimilla kirjoittaa arviot. Apple ei tallenna sitä, mitä malli näkee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle plus grand sur les serveurs d’Apple rédige les bilans. Apple ne conserve pas ce qu’il voit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודל גדול יותר בשרתים של Apple כותב את הסקירות. Apple אינה שומרת את מה שהיא רואה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के सर्वर पर एक बड़ा मॉडल समीक्षाएँ लिखता है। Apple जो देखता है, उसे सहेजता नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocjene piše veći model na Appleovim poslužiteljima. Apple ne pohranjuje ono što vidi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értékeléseket egy nagyobb modell írja az Apple szerverein. Az Apple nem tárolja, amit lát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model yang lebih besar di server Apple menulis ulasan. Apple tidak menyimpan apa yang dilihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modello più grande sui server di Apple scrive le valutazioni. Apple non conserva ciò che vede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple のサーバ上のより大きなモデルがレビューを書きます。Apple は、そこで扱われた内容を保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 서버의 더 큰 모델이 리뷰를 작성해요. Apple은 모델이 본 내용을 저장하지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model yang lebih besar pada pelayan Apple menulis ulasan. Apple tidak menyimpan apa yang dilihatnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En større modell på Apples servere skriver vurderingene. Apple lagrer ikke det den ser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groter model op de servers van Apple schrijft de beoordelingen. Apple bewaart niet wat het ziet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oceny pisze większy model na serwerach Apple. Apple nie przechowuje tego, co widzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um modelo maior nos servidores da Apple escreve as avaliações. A Apple não guarda o que vê."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un model mai mare, pe serverele Apple, scrie evaluările. Apple nu stochează ce vede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рецензии пишет более крупная модель на серверах Apple. Apple не сохраняет то, что она видит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
