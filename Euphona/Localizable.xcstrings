    "voice_quality_disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير لكيفية سماع المستمعين للصوت، من نموذج دُرّب على تقييمات المستمعين. وهو ليس تشخيصًا طبيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estimació de com sona una veu a qui l’escolta, feta per un model entrenat amb valoracions d’oients. No és un diagnòstic mèdic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhad toho, jak hlas zní posluchačům, vytvořený modelem natrénovaným na hodnoceních posluchačů. Není to lékařská diagnóza."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et estimat af, hvordan en stemme lyder for lyttere, fra en model trænet på lytterbedømmelser. Det er ikke en medicinsk diagnose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schätzung, wie eine Stimme auf Zuhörende wirkt, von einem Modell, das mit Bewertungen von Zuhörenden trainiert wurde. Sie ist keine medizinische Diagnose."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια εκτίμηση του πώς ακούγεται μια φωνή στους ακροατές, από ένα μοντέλο εκπαιδευμένο σε αξιολογήσεις ακροατών. Δεν αποτελεί ιατρική διάγνωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimate of how a voice sounds to listeners, from a model trained on listener ratings. It is not a medical diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estimación de cómo suena una voz a quien la escucha, hecha por un modelo entrenado con valoraciones de oyentes. No es un diagnóstico médico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvio siitä, miltä ääni kuulostaa kuulijoille, kuulijoiden arvioilla opetetusta mallista. Se ei ole lääketieteellinen diagnoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une estimation de la façon dont une voix est perçue par les auditeurs, issue d’un modèle entraîné sur des évaluations d’auditeurs. Ce n’est pas un diagnostic médical."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערכה של איך קול נשמע למאזינים, ממודל שאומן על דירוגי מאזינים. זו אינה אבחנה רפואית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "श्रोताओं को आवाज़ कैसी सुनाई देती है, इसका अनुमान, श्रोताओं की रेटिंग पर प्रशिक्षित मॉडल से। यह कोई चिकित्सीय निदान नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procjena kako glas zvuči slušateljima, iz modela treniranog na ocjenama slušatelja. To nije medicinska dijagnoza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
