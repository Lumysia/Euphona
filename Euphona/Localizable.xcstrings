    "feedback_diagnostics_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصدارا التطبيق والنظام، وطراز الجهاز، واللغة، وآخر نتائجك، تُضاف إلى منشورك. لا تسجيلات أبدًا، ولا هدفك أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versions de l’app i del sistema, model del dispositiu, idioma i les teves últimes puntuacions, afegits a la publicació. Mai enregistraments, mai el teu objectiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze aplikace a systému, model zařízení, jazyk a vaše poslední skóre, přidané k příspěvku. Nikdy nahrávky, nikdy váš cíl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App- og systemversioner, enhedsmodel, sprog og dine seneste scorer, føjet til dit opslag. Aldrig optagelser, aldrig dit mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App- und Systemversion, Gerätemodell, Sprache und deine letzten Werte, an deinen Beitrag angehängt. Niemals Aufnahmen, niemals dein Ziel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκδόσεις εφαρμογής και συστήματος, μοντέλο συσκευής, γλώσσα και οι τελευταίες βαθμολογίες σας, στη δημοσίευσή σας. Ποτέ ηχογραφήσεις, ποτέ ο στόχος σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
