    "score_focus_pitch" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستحسن تقريب درجة صوتك في الكلام من الهدف شيئًا فشيئًا. تعرض أداة درجة الصوت نطاقًا مستهدفًا للبقاء فيه."
          }
        },
        "ca" : {
          "stringUnit" : {
